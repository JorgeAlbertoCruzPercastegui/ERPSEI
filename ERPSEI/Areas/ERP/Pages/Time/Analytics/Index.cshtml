@page
@model ERPSEI.Areas.ERP.Pages.Time.Analytics.IndexModel

@{
    ViewData["Title"] = "Analítica TIME";
    ViewData["BodyClass"] =
        "module-main-theme catalogo-page time-analytics-page";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/TimeAnalytics.css"
          asp-append-version="true" />
}

<div class="container-fluid time-analytics">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="time-analytics-header mb-4">

        <div>
            <span class="time-analytics-eyebrow">
                Recursos Humanos
            </span>

            <h2 class="time-analytics-title">
                <i class="bi bi-bar-chart-line-fill me-2"></i>
                Analítica TIME
            </h2>

            <p class="time-analytics-subtitle mb-0">
                Monitoreo ejecutivo de cumplimiento, horas,
                actividad y desempeño operativo.
            </p>
        </div>

        <div class="time-analytics-status">
            <span class="time-analytics-status-dot"></span>

            <div>
                <small>
                    Estado de datos
                </small>

                <strong>
                    Preparando información
                </strong>
            </div>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PESTAÑAS -->
    <!-- ========================================================= -->

    <div class="time-analytics-tabs mb-4">

        <button type="button"
                id="tabDashboardCumplimiento"
                class="time-analytics-tab active">
            Dashboard Cumplimiento
        </button>

        <button type="button"
                id="tabEvaluacionAreas"
                class="time-analytics-tab">
            Evaluación de Áreas
        </button>

        <button type="button"
                id="tabAnalisisPersonal"
                class="time-analytics-tab">
            Análisis de Personal
        </button>

        <button type="button"
                id="tabAlineacionBackOffice"
                class="time-analytics-tab">
            Alineación Back Office
        </button>

        <button type="button"
                id="tabAlineacionOperativas"
                class="time-analytics-tab">
            Alineación Operativas
        </button>

        <button type="button"
                id="tabHorasExtras"
                class="time-analytics-tab">
            Horas Extras
        </button>

    </div>


    <!-- ========================================================= -->
    <!-- FILTROS GENERALES -->
    <!-- ========================================================= -->

    <div class="card time-analytics-filter-card mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-xl-3 col-md-6">

                    <label class="form-label">
                        Fecha inicial
                    </label>

                    <input type="date"
                           id="analyticsFechaInicio"
                           class="form-control" />

                </div>


                <div class="col-xl-3 col-md-6">

                    <label class="form-label">
                        Fecha final
                    </label>

                    <input type="date"
                           id="analyticsFechaFin"
                           class="form-control" />

                </div>


                <div class="col-xl-3 col-md-6">

                    <label class="form-label">
                        Área
                    </label>

                    <select id="analyticsArea"
                            class="form-select">

                        <option value="">
                            Todas las áreas
                        </option>

                    </select>

                </div>


                <div class="col-xl-3 col-md-6">

                    <label class="form-label">
                        Colaborador
                    </label>

                    <select id="analyticsUsuario"
                            class="form-select">

                        <option value="">
                            Todos los colaboradores
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DASHBOARD CUMPLIMIENTO -->
    <!-- ========================================================= -->

    <div id="vistaDashboardCumplimiento">

        <!-- ===================================================== -->
        <!-- KPIs -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <div class="col-xl col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas registradas
                    </span>

                    <strong id="kpiHorasRegistradas">
                        —
                    </strong>

                    <small>
                        Periodo seleccionado
                    </small>

                </div>

            </div>


            <div class="col-xl col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas faltantes
                    </span>

                    <strong id="kpiHorasFaltantes">
                        —
                    </strong>

                    <small>
                        Diferencia estimada
                    </small>

                </div>

            </div>


            <div class="col-xl col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Cumplimiento
                    </span>

                    <strong id="kpiCumplimiento">
                        —
                    </strong>

                    <small>
                        Cumplimiento global
                    </small>

                </div>

            </div>


            <div class="col-xl col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Colaboradores
                    </span>

                    <strong id="kpiColaboradores">
                        —
                    </strong>

                    <small>
                        Usuarios evaluados
                    </small>

                </div>

            </div>


            <div class="col-xl col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Áreas
                    </span>

                    <strong id="kpiAreas">
                        —
                    </strong>

                    <small>
                        Áreas con actividad
                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- GRÁFICAS -->
        <!-- ===================================================== -->

        <div class="row g-4">

            <div class="col-xl-5">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Distribución de horas por Tipo
                    </div>

                    <div class="card-body">

                        <canvas id="chartDistribucionTipo">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-xl-7">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Cumplimiento por Área
                    </div>

                    <div class="card-body">

                        <canvas id="chartCumplimientoArea">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Tendencia de horas
                    </div>

                    <div class="card-body">

                        <canvas id="chartTendencia">
                        </canvas>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- DETALLE COLABORADORES -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Detalle de colaboradores
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table
                                table-hover
                                align-middle
                                mb-0">

                                <thead>
                                    <tr>

                                        <th>
                                            Colaborador
                                        </th>

                                        <th>
                                            Área
                                        </th>

                                        <th class="text-end">
                                            Horas
                                        </th>

                                        <th class="text-end">
                                            Cumplimiento
                                        </th>

                                        <th>
                                            Tendencia
                                        </th>

                                    </tr>
                                </thead>

                                <tbody id="analyticsTablaUsuarios">

                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">

                                            Preparando información...

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <!-- PAGINACIÓN DETALLE COLABORADORES -->

                        <div id="colaboradoresPaginacion"
                             class="mt-3">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- EVALUACIÓN DE ÁREAS -->
    <!-- ========================================================= -->

    <div id="vistaEvaluacionAreas"
         class="d-none">

        <!-- ===================================================== -->
        <!-- KPIs -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <div class="col-xl-6 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas
                    </span>

                    <strong id="evaluacionHoras">
                        —
                    </strong>

                    <small>
                        Horas registradas
                    </small>

                </div>

            </div>


            <div class="col-xl-6 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Personas
                    </span>

                    <strong id="evaluacionPersonas">
                        —
                    </strong>

                    <small>
                        Personas por área
                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FILTROS EVALUACIÓN -->
        <!-- ===================================================== -->

        <div class="card time-analytics-filter-card mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-xl-6 col-md-6">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select id="evaluacionTipo"
                                class="form-select">

                            <option value="">
                                Todos los tipos
                            </option>

                        </select>

                    </div>


                    <div class="col-xl-6 col-md-6">

                        <label class="form-label">
                            Puesto
                        </label>

                        <select id="evaluacionPuesto"
                                class="form-select">

                            <option value="">
                                Todos los puestos
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- GRÁFICAS EVALUACIÓN -->
        <!-- ===================================================== -->

        <div class="row g-4">

            <div class="col-xl-7">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Claves cargadas por Área
                    </div>

                    <div class="card-body">

                        <canvas id="chartEvaluacionClaves">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-xl-5">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        División por Puesto
                    </div>

                    <div class="card-body">

                        <canvas id="chartEvaluacionPuestos">
                        </canvas>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- EMPRESA / COLABORADOR -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Carga de Horas por Empresa y Colaborador
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table
                                table-hover
                                align-middle
                                mb-0">

                                <thead>
                                    <tr>

                                        <th>
                                            Grupo / Empresa
                                        </th>

                                        <th>
                                            Colaborador
                                        </th>

                                        <th class="text-end">
                                            Horas
                                        </th>

                                    </tr>
                                </thead>

                                <tbody id="tablaEvaluacionEmpresa">

                                    <tr>
                                        <td colspan="3"
                                            class="text-center text-muted py-4">

                                            Selecciona Evaluación de Áreas.

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <!-- PAGINACIÓN EMPRESA / COLABORADOR -->

                        <div id="empresaColaboradorPaginacion"
                             class="mt-3">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ANÁLISIS DE PERSONAL -->
    <!-- ========================================================= -->

    <div id="vistaAnalisisPersonal"
         class="d-none">

        <!-- ===================================================== -->
        <!-- KPIs -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <div class="col-xl-6 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas
                    </span>

                    <strong id="personalHoras">
                        —
                    </strong>

                    <small>
                        Horas registradas
                    </small>

                </div>

            </div>


            <div class="col-xl-6 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Personas
                    </span>

                    <strong id="personalPersonas">
                        —
                    </strong>

                    <small>
                        Personas evaluadas
                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FILTROS ANÁLISIS DE PERSONAL -->
        <!-- ===================================================== -->

        <div class="card time-analytics-filter-card mb-4">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-xl-6 col-md-6">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select id="personalTipo"
                                class="form-select">

                            <option value="">
                                Todos los tipos
                            </option>

                        </select>

                    </div>


                    <div class="col-xl-6 col-md-6">

                        <label class="form-label">
                            Puesto
                        </label>

                        <select id="personalPuesto"
                                class="form-select">

                            <option value="">
                                Todos los puestos
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- GRÁFICAS ANÁLISIS DE PERSONAL -->
        <!-- ===================================================== -->

        <div class="row g-4">

            <div class="col-xl-7">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Claves cargadas por colaborador
                    </div>

                    <div class="card-body">

                        <canvas id="chartPersonalClaves">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-xl-5">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        División por Puesto
                    </div>

                    <div class="card-body">

                        <canvas id="chartPersonalPuestos">
                        </canvas>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COLABORADOR / EMPRESA -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Carga de Horas por Colaborador y Empresa
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table
                                table-hover
                                align-middle
                                mb-0">

                                <thead>
                                    <tr>

                                        <th>
                                            Colaborador
                                        </th>

                                        <th>
                                            Grupo / Empresa
                                        </th>

                                        <th class="text-end">
                                            Horas
                                        </th>

                                    </tr>
                                </thead>

                                <tbody id="tablaPersonalColaboradores">

                                    <tr>
                                        <td colspan="3"
                                            class="text-center text-muted py-4">

                                            Selecciona Análisis de Personal.

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <div id="personalColaboradoresPaginacion"
                             class="mt-3">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ALINEACIÓN BACK OFFICE -->
    <!-- ========================================================= -->

    <div id="vistaAlineacionBackOffice"
         class="d-none">

        <!-- ===================================================== -->
        <!-- KPIs BACK OFFICE -->
        <!-- ===================================================== -->

        <div class="row g-3 mb-4">

            <div class="col-xl-4 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Evaluación Back Office
                    </span>

                    <strong id="backOfficeEvaluacion">
                        —
                    </strong>

                    <small>
                        Porcentaje de horas alineadas a Back Office
                    </small>

                </div>

            </div>


            <div class="col-xl-4 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas Back Office
                    </span>

                    <strong id="backOfficeHoras">
                        —
                    </strong>

                    <small>
                        Horas clasificadas como Back Office
                    </small>

                </div>

            </div>


            <div class="col-xl-4 col-md-6">

                <div class="time-kpi-card">

                    <span>
                        Horas totales
                    </span>

                    <strong id="backOfficeHorasTotales">
                        —
                    </strong>

                    <small>
                        Horas registradas en el periodo
                    </small>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- EVALUACIÓN Y DISTRIBUCIÓN -->
        <!-- ===================================================== -->

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Horas cargadas por Área
                    </div>

                    <div class="card-body">

                        <canvas id="chartBackOfficeAreas">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-xl-4">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Distribución de Actividades
                    </div>

                    <div class="card-body">

                        <canvas id="chartBackOfficeDistribucion">
                        </canvas>

                    </div>

                </div>

            </div>


            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header">
                        Tendencia de Horas
                    </div>

                    <div class="card-body">

                        <canvas id="chartBackOfficeColaboradores">
                        </canvas>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- RESUMEN DE HALLAZGOS -->
            <!-- ================================================= -->

            <div class="col-12">

                <div class="card time-analytics-panel">

                    <div class="card-header d-flex
                        justify-content-between
                        align-items-center
                        flex-wrap
                        gap-2">

                        <span>
                            Resumen de Hallazgos
                        </span>

                        <span class="text-muted small">
                            Sin horas · Muy bajo · Bajo · Medio · Alto
                        </span>

                    </div>

                    <div class="card-body">

                        <div class="time-backoffice-legend mb-3">

                            <span class="time-backoffice-level level-none">
                                Sin horas (0%)
                            </span>

                            <span class="time-backoffice-level level-very-low">
                                Muy bajo (&gt;0% – &lt;30%)
                            </span>

                            <span class="time-backoffice-level level-low">
                                Bajo (30% – &lt;50%)
                            </span>

                            <span class="time-backoffice-level level-medium">
                                Medio (50% – ≤80%)
                            </span>

                            <span class="time-backoffice-level level-high">
                                Alto (&gt;80%)
                            </span>

                        </div>


                        <div class="table-responsive">

                            <table class="table
                                table-hover
                                align-middle
                                mb-0">

                                <thead>
                                    <tr>

                                        <th>
                                            Área
                                        </th>

                                        <th class="text-end">
                                            Horas totales
                                        </th>

                                        <th class="text-end">
                                            Horas Back Office
                                        </th>

                                        <th class="text-end">
                                            Evaluación
                                        </th>

                                        <th>
                                            Hallazgo
                                        </th>

                                    </tr>
                                </thead>

                                <tbody id="tablaBackOfficeHallazgos">

                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">

                                            Selecciona Alineación Back Office.

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>


                        <div id="backOfficeHallazgosPaginacion"
                             class="mt-3">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ALINEACIÓN OPERATIVAS -->
    <!-- ========================================================= -->

    <div id="vistaAlineacionOperativas"
         class="d-none">

        <div class="row g-3 mb-4">

            <div class="col-xl-4 col-md-6">
                <div class="time-kpi-card">
                    <span>Evaluación Operativas + Clientes</span>
                    <strong id="operativasEvaluacion">—</strong>
                    <small>Porcentaje de horas operativas y clientes</small>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="time-kpi-card">
                    <span>Horas Operativas + Clientes</span>
                    <strong id="operativasHoras">—</strong>
                    <small>Horas alineadas a operación y clientes</small>
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="time-kpi-card">
                    <span>Horas totales</span>
                    <strong id="operativasHorasTotales">—</strong>
                    <small>Horas registradas en el periodo</small>
                </div>
            </div>

        </div>

        <div class="row g-4">

            <div class="col-xl-8">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Horas cargadas por Área
                    </div>
                    <div class="card-body">
                        <canvas id="chartOperativasAreas"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Distribución de Actividades
                    </div>
                    <div class="card-body">
                        <canvas id="chartOperativasDistribucion"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Tendencia de Horas por Colaborador
                    </div>
                    <div class="card-body">
                        <canvas id="chartOperativasColaboradores"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Resumen por Área y Tipo
                    </div>
                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Área</th>
                                        <th>Tipo</th>
                                        <th class="text-end">Horas</th>
                                        <th class="text-end">Participación</th>
                                    </tr>
                                </thead>

                                <tbody id="tablaOperativasResumen">
                                    <tr>
                                        <td colspan="4"
                                            class="text-center text-muted py-4">
                                            Selecciona Alineación Operativas.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div id="operativasResumenPaginacion"
                             class="mt-3">
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- HORAS EXTRAS -->
    <!-- ========================================================= -->

    <div id="vistaHorasExtras"
         class="d-none">

        <div class="row g-3 mb-4">

            <div class="col-xl col-md-6">
                <div class="time-kpi-card">
                    <span>Horas</span>
                    <strong id="extrasHoras">—</strong>
                    <small>Horas registradas</small>
                </div>
            </div>

            <div class="col-xl col-md-6">
                <div class="time-kpi-card">
                    <span>Horas Extras</span>
                    <strong id="extrasHorasExtras">—</strong>
                    <small>Horas por encima de la meta</small>
                </div>
            </div>

            <div class="col-xl col-md-6">
                <div class="time-kpi-card">
                    <span>Horas Totales</span>
                    <strong id="extrasHorasTotales">—</strong>
                    <small>Meta total del periodo</small>
                </div>
            </div>

            <div class="col-xl col-md-6">
                <div class="time-kpi-card">
                    <span>Horas Faltantes</span>
                    <strong id="extrasHorasFaltantes">—</strong>
                    <small>Horas pendientes contra meta</small>
                </div>
            </div>

            <div class="col-xl col-md-6">
                <div class="time-kpi-card">
                    <span>Promedio x Persona</span>
                    <strong id="extrasPromedioPersona">—</strong>
                    <small>Promedio de horas registradas</small>
                </div>
            </div>

        </div>

        <div class="row g-4">

            <div class="col-xl-8">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Top 20 colaboradores por horas registradas
                    </div>
                    <div class="card-body">
                        <div class="time-chart-vertical-scroll">

                            <canvas id="chartExtrasColaboradores">
                            </canvas>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Personas por Clasificación TIME
                    </div>
                    <div class="card-body">
                        <canvas id="chartExtrasClasificacion"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Horas Extras por Área y Tipo
                    </div>
                    <div class="card-body">
                        <canvas id="chartExtrasAreas"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card time-analytics-panel">
                    <div class="card-header">
                        Detalle de Horas Extras
                    </div>
                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Colaborador</th>
                                        <th>Área</th>
                                        <th class="text-end">Horas</th>
                                        <th class="text-end">Extras</th>
                                        <th class="text-end">Faltantes</th>
                                        <th>Clasificación</th>
                                    </tr>
                                </thead>

                                <tbody id="tablaExtrasDetalle">
                                    <tr>
                                        <td colspan="6"
                                            class="text-center text-muted py-4">
                                            Selecciona Horas Extras.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div id="extrasDetallePaginacion"
                             class="mt-3">
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>

    <script src="~/js/TimeAnalytics.js"
            asp-append-version="true">
    </script>

}