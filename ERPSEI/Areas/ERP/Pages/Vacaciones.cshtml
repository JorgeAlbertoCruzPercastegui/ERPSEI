                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <center><p>@Localizer["SolicitudAntesContinuar"]</p></center>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">@Localizer["CerrarBtn"]</button>
            </div>
        </div>
    </div>
</div>


