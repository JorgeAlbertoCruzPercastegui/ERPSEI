@page "{handler?}"
@using ERPSEI.Data.Managers;
@using Microsoft.AspNetCore.Localization;
@using ERPSEI.Requests;
@using Microsoft.AspNetCore.Mvc.Localization;
@using ERPSEI.Data.Managers.Empleados;
@using ERPSEI.Data.Entities.Empleados;
@using ERPSEI.Data.Entities.Usuarios;
@using ERPSEI.Data.Managers.Usuarios;
@using ERPSEI.Data.Entities.Vacaciones;
@model ERPSEI.Areas.ERP.Pages.VacacionesModel

@inject IEmpleadoManager EmpleadoManager;

@inject IViewLocalizer Localizer;
@inject AppRoleManager RolesManager;
@inject AppUserManager UsuariosManager;
@inject IConfiguration Configuration;
@{
    ViewData["Title"] = Localizer["Title"];

    // Retrieves the requested culture
    IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();

    // Culture contains the information of the requested culture
    System.Globalization.CultureInfo? culture = rqf != null ? rqf.RequestCulture.Culture : new System.Globalization.CultureInfo("es-MX");

    string cultureName = culture.Name;


    List<Empleado> empleados = await EmpleadoManager.GetAllAsync();

    bool puedeTodo = User.Claims.Where(c => c.Type.Equals("PuedeTodo", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeConsultar = User.Claims.Where(c => c.Type.Equals("PuedeConsultar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEditar = User.Claims.Where(c => c.Type.Equals("PuedeEditar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEliminar = User.Claims.Where(c => c.Type.Equals("PuedeEliminar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeAutorizar = User.Claims.Where(c => c.Type.Equals("PuedeAutorizar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
}

<h3 class="title mb-3">@ViewData["Title"]</h3>

<!-- --------------------------- -->
<!-- Sección de filtros -------- -->
<div class="accordion shadow mb-5" id="accordionFiltros">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button p-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <h6>@Localizer["FilterTitle"]</h6>
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFiltros">
            <div class="accordion-body">
                <form id="filtros" method="post">
                    <div class="row">
                        <!-- Empleado -->
                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroEmpleado" type="search" asp-for="InputFiltro.Empleado" class="form-control" placeholder="@Localizer["EmpleadoField"]" idselected='' area="ERP" module="Vacaciones" source="GetUsuariosSuggestion" />
                                <label for="inpFiltroEmpleado" asp-for="InputFiltro.Empleado" class="form-label"></label>
                            </div>
                        </div>

                        <!-- Autorizador -->
                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroAutorizador" type="search" asp-for="InputFiltro.Autorizador" class="form-control" placeholder="@Localizer["AutorizadorField"]" idselected='' area="ERP" module="Vacaciones" source="GetUsuariosSuggestion" />
                                <label for="inpFiltroAutorizador" asp-for="InputFiltro.Autorizador" class="form-label"></label>
                            </div>
                        </div>

                        <!-- Fecha Inicio Desde -->
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="form-floating mb-3">
                                <input type="date" class="form-control" asp-for="InputFiltro.FechaInicioDesde" id="inpFiltroFechaInicio" placeholder="Fecha Inicio" />
                                <label asp-for="InputFiltro.FechaInicioDesde" for="inpFiltroFechaInicio" class="form-label"></label>
                            </div>
                        </div>

                        <!-- Fecha Fin Hasta -->
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="form-floating mb-3">
                                <input type="date" class="form-control" asp-for="InputFiltro.FechaFinHasta" id="inpFiltroFechaFin" placeholder="Fecha Fin" />
                                <label asp-for="InputFiltro.FechaFinHasta" for="inpFiltroFechaFin" class="form-label"></label>
                            </div>
                        </div>

                        <!-- Estado -->
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="form-floating mb-3">
                                <select asp-for="InputFiltro.Estado" class="form-select" id="inpFiltroEstado">
                                    <option value="">Todos</option>
                                    @foreach (EstadoSolicitud estado in Enum.GetValues(typeof(EstadoSolicitud)))
                                    {
                                        <option value="@((int)estado)">@estado</option>
                                    }
                                </select>
                                <label asp-for="InputFiltro.Estado" for="inpFiltroEstado" class="form-label"></label>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row text-end">
                    <div class="col-12">
                        <button id="btnBuscar" name="refresh" class="btn btn-primary" onclick="onBuscarClick();">
                            <i class="bi bi-search"></i> @Localizer["SearchButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- --------------------------- -->
<!-- Sección tabla de resultados -->
<div id="toolbar" class="col-xl-12">
    <button id="btnAgregar" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dlgVacacion" onclick="onAgregarClick();">
        <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">@Localizer["AddButton"]</span>
    </button>
    <button id="remove" class="btn btn-danger" disabled>
        <i class="bi bi-trash"></i> <span class="d-none d-sm-inline">@Localizer["DeactivateButton"]</span>
    </button>
</div>

<table id="table" class="table-sm"
       data-unique-id="id"
       data-toolbar="#toolbar"
       data-search="true"
       data-show-toggle="true"
       data-show-fullscreen="true"
       data-show-columns="true"
       data-show-columns-toggle-all="true"
       data-show-export="true"
       data-click-to-select="true"
       data-minimum-count-columns="2"
       data-show-pagination-switch="true"
       data-pagination="true"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]"
       data-show-footer="false"
       data-side-pagination="client"
       data-response-handler="responseHandler"
       data-buttons-class="primary"
       data-buttons="additionalButtons"
       data-url="/ERP/Vacaciones/VacacionesList">
    <thead>
        <tr align="center" valign="middle" class="bg-primary bg-opacity-10">
        </tr>
    </thead>
</table>

<!-- --------------------------- -->
<!-- --------------------------- -->
<!-- --------------------------- -->
<!-- Sección Nuevo/Editar/Ver Registro --- -->

<form id="theForm" method="post">
    <div id="dlgVacaciones" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgSolicitudVacacionesTitle" class="modal-title">Solicitar Vacaciones</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- Resumen de saldo -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card border-primary">
                                    <div class="card-header bg-primary text-white fw-bold">
                                        <i class="bi bi-clipboard-check"></i> Detalle de Saldo de Vacaciones
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Concepto</th>
                                                        <th class="text-end">Legales</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>(+) Acumuladas</td>
                                                        <td class="text-end">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>(-) Tomadas</td>
                                                        <td class="text-end">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>(-) Vencidas</td>
                                                        <td class="text-end">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>(-) Tomadas en el Futuro</td>
                                                        <td class="text-end">0.0 días</td>
                                                    </tr>
                                                    <tr class="fw-bold">
                                                        <td>(=) Total Saldo</td>
                                                        <td class="text-end">0.0 días</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <small class="text-muted">Saldo al <strong>@DateTime.Now.ToString("dd-MM-yyyy")</strong></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />

                        <!-- Sección Vacaciones Tomadas -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <span><strong>Vacaciones Tomadas</strong></span>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dlgVacacionesSolicitud">
                                    <i class="bi bi-plus-circle"></i> Solicitar
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Inicio</th>
                                                <th>Término</th>
                                                <th>Número de Días</th>
                                                <th>Tipo</th>
                                                <th>Estado</th>
                                                <th>Opciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @* Aquí puedes iterar sobre solicitudes reales si las tienes *@
                                            <tr>
                                                <td colspan="6" class="text-center text-muted">No hay vacaciones tomadas.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Sección Vacaciones Acumuladas -->
                        <div class="card">
                            <div class="card-header bg-primary text-white fw-bold">
                                Vacaciones Acumuladas
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Número de Días</th>
                                                <th>Tipo</th>
                                                <th>Vencimiento</th>
                                                <th>Periodo</th>
                                                <th>Opciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>03/06/2025</td>
                                                <td>0.0 días</td>
                                                <td>Tipo</td>
                                                <td>03/06/2025</td>
                                                <td>2025-2026</td>
                                                <td>-</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="inpEmpleadoId" name="InputSolicitud.EmpleadoId" value="@Model.EmpleadoId" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="dlgSolicitudVacacionesBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!--Modal para solicitar vacaciones-->
<form id="theForm" method="post">
    <div id="dlgVacacionesSolicitud" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgSolicitudVacacionesTitle" class="modal-title">Solicitar Vacaciones</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- Saldo disponible -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <i class="bi bi-palm"></i> Tienes <strong>@Model.DiasDisponibles</strong> días disponibles.
                                </div>
                            </div>
                        </div>

                        <!-- Fechas -->
                        <div class="row">
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input id="inpFechaInicio" asp-for="InputSolicitud.FechaInicio" type="date" class="form-control" />
                                    <label asp-for="InputSolicitud.FechaInicio" class="form-label required"></label>
                                    <span asp-validation-for="InputSolicitud.FechaInicio" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input id="inpFechaFin" asp-for="InputSolicitud.FechaFin" type="date" class="form-control" />
                                    <label asp-for="InputSolicitud.FechaFin" class="form-label required"></label>
                                    <span asp-validation-for="InputSolicitud.FechaFin" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Días solicitados -->
                        <div class="row">
                            <div class="col-12">
                                <div class="alert alert-light border">
                                    Estás solicitando <strong id="diasSolicitadosTexto">0</strong> días laborales.
                                </div>
                            </div>
                        </div>

                        <!-- Comentario -->
                        <div class="row">
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <textarea id="inpComentarioEmpleado" asp-for="InputSolicitud.ComentarioEmpleado" class="form-control" style="height: 100px;"></textarea>
                                    <label asp-for="InputSolicitud.ComentarioEmpleado" class="form-label"></label>
                                    <span asp-validation-for="InputSolicitud.ComentarioEmpleado" class="text-danger"></span>
                                </div>
                            </div>
                        </div>



                        <input type="hidden" id="inpEmpleadoId" name="InputSolicitud.EmpleadoId" value="@Model.EmpleadoId" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="dlgSolicitudVacacionesBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                    <button id="dlgSolicitudVacacionesBtnGuardar" type="button" class="btn btn-primary" onclick="onGuardarClick();">
                        <i class="bi bi-floppy"></i> @Localizer["SaveButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>



