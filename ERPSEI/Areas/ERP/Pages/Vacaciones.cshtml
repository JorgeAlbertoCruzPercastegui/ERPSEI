<!-- Sección Nuevo/Editar/Ver Registro --- -->

<form id="theForm" method="post">
    <div id="dlgVacaciones" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgSolicitudVacacionesTitle" class="modal-title">@Localizer["SolicitarVacacionesField"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- Resumen de saldo -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card border-primary">
                                    <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <i class="bi bi-clipboard-check"></i> @Localizer["DetalleSaldoVacacionesField"]
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#modalVerPoliticas">
                                                <i class="bi bi-eye"></i> Ver Políticas
                                            </button>

                                            <button type="button" class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#modalAsignacionVacaciones">
                                                <i class="bi bi-ui-checks-grid"></i> Asignación
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>@Localizer["ConceptoField"]</th>
                                                        <th class="text-end">@Localizer["LegalesField"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>@Localizer["AcumuladasField"]</td>
                                                        <td class="text-end" id="tdAcumuladas">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>@Localizer["TomadasField"]</td>
                                                        <td class="text-end" id="tdTomadas">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>@Localizer["VencidasField"]</td>
                                                        <td class="text-end" id="tdVencidas">0.0 días</td>
                                                    </tr>
                                                    <tr>
                                                        <td>@Localizer["TomadasFuturoField"]</td>
                                                        <td class="text-end" id="tdFuturas">0.0 días</td>
                                                    </tr>
                                                    <tr class="fw-bold">
                                                        <td>@Localizer["TotalSaldoField"]</td>
                                                        <td class="text-end" id="tdSaldoTotal">0.0 días</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <small class="text-muted">@Localizer["SaldoAlField"] <strong id="lblFechaSaldo">@DateTime.Now.ToString("dd-MM-yyyy")</strong></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />

                        <!-- Sección Vacaciones Tomadas -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <span><strong>@Localizer["VacacionesTomadasField"]</strong></span>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#dlgVacacionesSolicitud">
                                    <i class="bi bi-plus-circle"></i> @Localizer["SolicitarField"]
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <div style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-striped" id="tableVacacionesTomadas">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Localizer["InicioField"]</th>
                                                <th>@Localizer["TerminoField"]</th>
                                                <th>@Localizer["NumeroDiasField"]</th>
                                                <th>@Localizer["TipoField"]</th>
                                                <th>@Localizer["EstadoField"]</th>
                                                <th>@Localizer["OpcionesField"]</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyVacacionesTomadas">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted">Cargando...</td>
                                            </tr>
                                        </tbody>

                                    </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sección Vacaciones Acumuladas -->
                        <div class="card">
                            <div class="card-header bg-primary text-white fw-bold">
                                @Localizer["VacacionesAcumuladasField"]
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Localizer["FechaField"]</th>
                                                <th>@Localizer["NumeroDiasField"]</th>
                                                <th>@Localizer["TipoField"]</th>
                                                <th>@Localizer["VencimientoField"]</th>
                                                <th>@Localizer["PeriodoField"]</th>
                                                <th>@Localizer["OpcionesField"]</th>
                                            </tr>
                                            <tr>
                                        <tbody id="tbodyVacAcumuladas">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted">Cargando...</td>
                                            </tr>
                                        </tbody>
                                             </tr>
                                        </thead>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="inpEmpleadoId" name="InputSolicitud.EmpleadoId" value="@Model.EmpleadoId" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="dlgSolicitudVacacionesBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="modal fade" id="modalDetalleVacacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Detalle de vacaciones</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6"><strong>Empleado:</strong> <span id="detVacEmpleado"></span></div>
                    <div class="col-md-6"><strong>Estado:</strong> <span id="detVacEstado"></span></div>
                    <div class="col-md-6"><strong>Fecha solicitud:</strong> <span id="detVacFechaSolicitud"></span></div>
                    <div class="col-md-6"><strong>Autorizador:</strong> <span id="detVacAutorizador"></span></div>
                    <div class="col-md-6"><strong>Fecha inicio:</strong> <span id="detVacFechaInicio"></span></div>
                    <div class="col-md-6"><strong>Fecha fin:</strong> <span id="detVacFechaFin"></span></div>
                    <div class="col-md-6"><strong>Días solicitados:</strong> <span id="detVacDias"></span></div>
                    <div class="col-12">
                        <strong>Comentario:</strong>
                        <div id="detVacComentario" class="border rounded p-3 bg-light mt-1"></div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <div id="detalleAccionesVacacion" class="d-flex gap-2 flex-wrap"></div>
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Ver Políticas -->
<div class="modal fade" id="modalVerPoliticas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Políticas de vacaciones del Colaborador</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Periodo</label>
                        <div class="input-group">
                            <input type="text" class="form-control" value="Marzo, 2026" readonly />
                            <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <label class="form-label">Ver Tipo de Vacaciones</label>
                        <select class="form-select" id="selTipoPolitica">
                            <option value="Legales" selected>Legales</option>
                            <option value="Anuales">Anuales</option>
                        </select>
                    </div>
                </div>

                <h5 class="mb-3 text-primary" id="lblNombrePolitica">Legal 2023</h5>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Años de antigüedad</th>
                                <th>Días de vacaciones</th>
                                <th>Prima Vacacional</th>
                                <th>Días de Aguinaldo</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyPoliticasVacaciones">
                            <tr>
                                <td colspan="4" class="text-center text-muted">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Asignación -->
<div class="modal fade" id="modalAsignacionVacaciones" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Asignación de vacaciones</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Modo global de visualización de vacaciones</label>
                    <select class="form-select" id="selTipoAsignacionVacaciones">
                        <option value="Legales">Legales</option>
                        <option value="LegalesProporcionales">Legales (Proporcionales)</option>
                    </select>
                    <small class="text-muted">
                        Esta configuración aplicará para todos los usuarios hasta que vuelva a cambiarse.
                    </small>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarAsignacionVacaciones()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!--Modal para solicitar vacaciones-->
<form id="theFormS" method="post">
    <div id="dlgVacacionesSolicitud" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgSolicitudVacacionesTitle" class="modal-title">@Localizer["SolicitarVacacionesField"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- Saldo disponible -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <i class="bi bi-palm"></i> @Localizer["TienesField"] <strong id="lblDiasDisponibles">@Model.DiasDisponibles</strong> @Localizer["diasDisponiblesField"]
                                </div>
                            </div>
                        </div>

                        <!-- Fechas -->
                        <div class="row">
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input id="inpFechaInicio" asp-for="InputSolicitud.FechaInicio" type="date" class="form-control" />
                                    <label asp-for="InputSolicitud.FechaInicio" class="form-label required"></label>
                                    <span asp-validation-for="InputSolicitud.FechaInicio" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-floating mb-3">
                                    <input id="inpFechaFin" asp-for="InputSolicitud.FechaFin" type="date" class="form-control" />
                                    <label asp-for="InputSolicitud.FechaFin" class="form-label required"></label>
                                    <span asp-validation-for="InputSolicitud.FechaFin" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Días solicitados -->
                        <div class="row">
                            <div class="col-12">
                                <div class="alert alert-light border">
                                    @Localizer["EstasSolicitandoField"] <strong id="diasSolicitadosTexto">0</strong> @Localizer["diasLaboralesField"]
                                </div>
                            </div>
                        </div>

                        <!-- Comentario -->
                        <div class="row">
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <textarea id="inpComentarioEmpleado" asp-for="InputSolicitud.ComentarioEmpleado" class="form-control" style="height: 100px;"></textarea>
                                    <label asp-for="InputSolicitud.ComentarioEmpleado" class="form-label"></label>
                                    <span asp-validation-for="InputSolicitud.ComentarioEmpleado" class="text-danger"></span>
                                </div>
                            </div>
                        </div>



                        <input type="hidden" id="inpEmpleadoId" name="InputSolicitud.EmpleadoId" value="@Model.EmpleadoId" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button id="dlgSolicitudVacacionesBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                    <button id="dlgSolicitudVacacionesBtnGuardar" type="button" class="btn btn-primary" onclick="onGuardarClick();">
                        <i class="bi bi-floppy"></i> @Localizer["SaveButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!--Modales para autorizar y rechazar solitiudes de vacaciones-->
<div class="modal fade" id="modalAutorizar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AutorizarSolicitud" id="formAutorizar">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@Localizer["AutorizarSolModal"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center">
                    <input type="hidden" name="idSolicitud" id="modalSolicitudId" />
                    <input type="hidden" name="estado" id="estadoSolicitud" />
                    <center><p id="modalPreguntaTexto">@Localizer["AutorizarPreguntaModal"]</p></center>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-danger w-45" onclick="enviarAccionSolicitud('Rechazado')">
                        <i class="bi bi-x-circle"></i> @Localizer["RechazarBtn"]
                    </button>
                    <button type="button" class="btn btn-success w-45" onclick="enviarAccionSolicitud('Aprobado')">
                        <i class="bi bi-check-circle"></i> @Localizer["AprobarBtn"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="modalAlerta" tabindex="-1" aria-hidden="true">
