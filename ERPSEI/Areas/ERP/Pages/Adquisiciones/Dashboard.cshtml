@page
@model ERPSEI.Areas.ERP.Pages.Adquisiciones.DashboardModel

@{
    ViewData["Title"] =
        "Centro de Control de Adquisiciones";
}


@section Styles
{
    <link rel="stylesheet"
          href="~/css/Adquisiciones.css"
          asp-append-version="true" />
}


<div class="adq-page">

    <!-- ====================================================== -->
    <!-- ENCABEZADO -->
    <!-- ====================================================== -->

    <section class="adq-header">

        <div class="adq-header-main">

            <div class="adq-header-icon">

                <i class="bi bi-grid-1x2-fill"></i>

            </div>


            <div>

                <span class="adq-panel-kicker">
                    Generalidades de la interfaz
                </span>

                <h1 class="adq-title">
                    Centro de Control de Adquisiciones
                </h1>

                <p class="adq-subtitle">
                    Seguimiento ejecutivo, operativo y documental
                    del proceso de adquisiciones.
                </p>

            </div>

        </div>


        <div class="adq-header-actions">

            <a asp-area="ERP"
                   asp-page="/Adquisiciones/Index"
                   class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Regresar a Adquisiciones

            </a>

        </div>

    </section>


    <!-- ====================================================== -->
    <!-- CENTRO DE CONTROL -->
    <!-- ====================================================== -->

    <section class="adq-command-center">

        <!-- ================================================== -->
        <!-- HEADER DEL DASHBOARD -->
        <!-- ================================================== -->

        <div class="adq-command-header">

            <div>

                <span class="adq-panel-kicker">
                    HU #5
                </span>

                <h2 class="mb-1">
                    Panorama general
                </h2>

                <p class="mb-0">
                    Panorama general de órdenes,
                    avances y flujo operativo.
                </p>

            </div>


            <div class="adq-command-progress">

                <div class="adq-command-progress-value">
                    @Model.DashboardPorcentajeFinalizadas.ToString("0.##")%
                </div>

                <div class="adq-command-progress-label">
                    Órdenes finalizadas
                </div>

            </div>

        </div>


        <!-- ================================================== -->
        <!-- KPIs GLOBALES -->
        <!-- ================================================== -->

        <div class="adq-command-kpi-grid">

            <!-- TOTAL -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        Total de órdenes
                    </span>

                    <strong>
                        @Model.DashboardTotalOrdenes
                    </strong>

                    <small>
                        Registradas en el módulo
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-folder2-open"></i>

                </div>

            </article>


            <!-- PENDIENTES -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        Pendientes
                    </span>

                    <strong>
                        @Model.DashboardPendientes
                    </strong>

                    <small>
                        Por revisión o aprobación
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-hourglass-split"></i>

                </div>

            </article>


            <!-- EN CURSO -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        En curso
                    </span>

                    <strong>
                        @Model.DashboardEnCurso
                    </strong>

                    <small>
                        Procesos activos
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-arrow-repeat"></i>

                </div>

            </article>


            <!-- COTIZACIÓN -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        En cotización
                    </span>

                    <strong>
                        @Model.DashboardEnCotizacion
                    </strong>

                    <small>
                        Gestión de proveedores
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-receipt"></i>

                </div>

            </article>


            <!-- PRESUPUESTO -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        Presupuesto
                    </span>

                    <strong>
                        @Model.DashboardEnAprobacionPresupuestal
                    </strong>

                    <small>
                        En flujo presupuestal
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-shield-check"></i>

                </div>

            </article>


            <!-- SOLICITUDES DE PAGO -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        Solicitudes de pago
                    </span>

                    <strong>
                        @Model.DashboardSolicitudesPago
                    </strong>

                    <small>
                        Documentos oficiales
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-file-earmark-pdf"></i>

                </div>

            </article>


            <!-- FINALIZADAS -->

            <article class="adq-command-kpi">

                <div>

                    <span>
                        Finalizadas
                    </span>

                    <strong>
                        @Model.DashboardFinalizadas
                    </strong>

                    <small>
                        Procesos concluidos
                    </small>

                </div>


                <div class="adq-command-kpi-icon">

                    <i class="bi bi-check2-circle"></i>

                </div>

            </article>

        </div>

        <!-- ================================================== -->
        <!-- CARPETAS OPERATIVAS HU #5 -->
        <!-- ================================================== -->

        <section class="adq-dashboard-folders">

            <div class="adq-dashboard-section-header">

                <div>

                    <span class="adq-panel-kicker">
                        Organización documental
                    </span>

                    <h3>
                        Carpetas operativas
                    </h3>

                    <p>
                        Consulta las órdenes clasificadas de acuerdo
                        con su estado dentro del proceso de adquisición.
                    </p>

                </div>


                <div class="adq-dashboard-section-icon">

                    <i class="bi bi-folder2-open"></i>

                </div>

            </div>


            <div class="adq-folder-grid">

                <!-- ============================================== -->
                <!-- TODAS LAS SOLICITUDES -->
                <!-- ============================================== -->

                <button type="button"
                        class="adq-folder-card"
                        data-folder="solicitudes">

                    <div class="adq-folder-icon">

                        <i class="bi bi-folder-fill"></i>

                    </div>


                    <div class="adq-folder-content">

                        <span class="adq-folder-label">
                            Solicitudes realizadas
                        </span>

                        <strong>
                            @Model.DashboardTotalOrdenes
                        </strong>

                        <small>
                            Órdenes registradas
                        </small>

                    </div>


                    <div class="adq-folder-arrow">

                        <i class="bi bi-chevron-right"></i>

                    </div>

                </button>


                <!-- ============================================== -->
                <!-- EN PROCESO -->
                <!-- ============================================== -->

                <button type="button"
                        class="adq-folder-card"
                        data-folder="proceso">

                    <div class="adq-folder-icon">

                        <i class="bi bi-arrow-repeat"></i>

                    </div>


                    <div class="adq-folder-content">

                        <span class="adq-folder-label">
                            Aceptadas / En proceso
                        </span>

                        <strong>
                            @Model.DashboardEnCurso
                        </strong>

                        <small>
                            Procesos activos
                        </small>

                    </div>


                    <div class="adq-folder-arrow">

                        <i class="bi bi-chevron-right"></i>

                    </div>

                </button>


                <!-- ============================================== -->
                <!-- RECHAZADAS -->
                <!-- ============================================== -->

                <button type="button"
                        class="adq-folder-card"
                        data-folder="rechazadas">

                    <div class="adq-folder-icon">

                        <i class="bi bi-x-circle"></i>

                    </div>


                    <div class="adq-folder-content">

                        <span class="adq-folder-label">
                            Rechazadas
                        </span>

                        <strong>
                            @Model.DashboardRechazadas
                        </strong>

                        <small>
                            Solicitudes no autorizadas
                        </small>

                    </div>


                    <div class="adq-folder-arrow">

                        <i class="bi bi-chevron-right"></i>

                    </div>

                </button>


                <!-- ============================================== -->
                <!-- CANCELADAS -->
                <!-- ============================================== -->

                <button type="button"
                        class="adq-folder-card"
                        data-folder="canceladas">

                    <div class="adq-folder-icon">

                        <i class="bi bi-slash-circle"></i>

                    </div>


                    <div class="adq-folder-content">

                        <span class="adq-folder-label">
                            Canceladas
                        </span>

                        <strong>
                            @Model.DashboardCanceladas
                        </strong>

                        <small>
                            Procesos cancelados
                        </small>

                    </div>


                    <div class="adq-folder-arrow">

                        <i class="bi bi-chevron-right"></i>

                    </div>

                </button>


                <!-- ============================================== -->
                <!-- SOLICITUDES DE PAGO -->
                <!-- ============================================== -->

                <button type="button"
                        class="adq-folder-card"
                        data-folder="pagos">

                    <div class="adq-folder-icon">

                        <i class="bi bi-file-earmark-pdf"></i>

                    </div>


                    <div class="adq-folder-content">

                        <span class="adq-folder-label">
                            Solicitudes de pago
                        </span>

                        <strong>
                            @Model.DashboardSolicitudesPago
                        </strong>

                        <small>
                            Documentos oficiales
                        </small>

                    </div>


                    <div class="adq-folder-arrow">

                        <i class="bi bi-chevron-right"></i>

                    </div>

                </button>

            </div>

        </section>

        <!-- ====================================================== -->
        <!-- EXPLORADOR DE ÓRDENES -->
        <!-- ====================================================== -->

        <section class="adq-dashboard-orders"
                 id="seccionOrdenesDashboardAdq">

            <div class="adq-dashboard-section-header">

                <div>

                    <span class="adq-panel-kicker">
                        Expedientes
                    </span>

                    <h3 id="tituloCarpetaDashboardAdq">
                        Solicitudes realizadas
                    </h3>

                    <p id="descripcionCarpetaDashboardAdq">
                        Consulta todas las órdenes registradas
                        dentro del módulo de Adquisiciones.
                    </p>

                </div>


                <div class="adq-dashboard-section-icon">

                    <i class="bi bi-table"></i>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- FILTROS -->
            <!-- ================================================== -->

            <div class="adq-dashboard-orders-toolbar">

                <div class="input-group">

                    <span class="input-group-text">

                        <i class="bi bi-search"></i>

                    </span>


                    <input type="text"
                           id="buscarOrdenDashboardAdq"
                           class="form-control"
                           placeholder="Buscar por folio, solicitud, área o estatus..."
                           autocomplete="off" />


                    <button type="button"
                            id="limpiarBusquedaDashboardAdq"
                            class="btn btn-outline-secondary">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <div class="adq-dashboard-orders-counter">

                    <span id="totalOrdenesDashboardAdq">
                        @Model.DashboardOrdenes.Count
                    </span>

                    <span>
                        órdenes
                    </span>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- TABLA -->
            <!-- ================================================== -->

            <div class="table-responsive">

                <table class="table align-middle adq-table mb-0"
                       id="tablaOrdenesDashboardAdq">

                    <thead>

                        <tr>

                            <th>
                                Folio
                            </th>

                            <th>
                                Solicitud
                            </th>

                            <th>
                                Área
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Estatus
                            </th>

                            <th class="text-center">
                                Solicitud de pago
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var orden
                            in Model.DashboardOrdenes
                        )
                        {
                            bool enProceso =
                                orden.EstatusId >= 5
                                &&
                                orden.EstatusId <= 16
                                &&
                                orden.EstatusId != 6
                                &&
                                orden.EstatusId != 7;


                            <tr class="adq-dashboard-order-row"
                                data-id="@orden.Id"
                                data-folio="@orden.Folio.ToLowerInvariant()"
                                data-titulo="@orden.Titulo.ToLowerInvariant()"
                                data-area="@orden.Area.ToLowerInvariant()"
                                data-estatus="@orden.Estatus.ToLowerInvariant()"
                                data-estatus-id="@orden.EstatusId"
                                data-proceso="@(enProceso ? "true" : "false")"
                                data-pago="@(orden.TieneSolicitudPago ? "true" : "false")">

                                <td>

                                    <strong class="adq-folio">
                                        @orden.Folio
                                    </strong>

                                </td>


                                <td>

                                    <div class="fw-semibold">
                                        @orden.Titulo
                                    </div>

                                </td>


                                <td>
                                    @orden.Area
                                </td>


                                <td>

                                    @orden.FechaSolicitud.ToString(
                                        "dd/MM/yyyy"
                                    )

                                </td>


                                <td>

                                    <span class="adq-status-badge">

                                        @orden.Estatus

                                    </span>

                                </td>


                                <td class="text-center">

                                    @if (
                                        orden.TieneSolicitudPago
                                    )
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Generada

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">

                                            <i class="bi bi-dash-circle me-1"></i>

                                            No generada

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ================================================== -->
            <!-- VACÍO -->
            <!-- ================================================== -->

            <div id="sinOrdenesDashboardAdq"
                 class="adq-command-empty d-none">

                <i class="bi bi-folder-x"></i>

                <strong>
                    No se encontraron órdenes
                </strong>

                <span>
                    No existen registros que coincidan
                    con la carpeta o búsqueda seleccionada.
                </span>

            </div>

        </section>


        <!-- ================================================== -->
        <!-- ANALÍTICA -->
        <!-- ================================================== -->

        <div class="row g-4 mt-1">

            <!-- ============================================== -->
            <!-- DISTRIBUCIÓN POR ESTATUS -->
            <!-- ============================================== -->

            <div class="col-12 col-xl-8">

                <div class="adq-command-panel">

                    <div class="adq-command-panel-header">

                        <div>

                            <h5>
                                Distribución por estatus
                            </h5>

                            <p>
                                Participación de cada etapa
                                dentro del total de órdenes.
                            </p>

                        </div>


                        <i class="bi bi-bar-chart-line"></i>

                    </div>


                    <div class="adq-status-distribution">

                        @if (
                            Model
                                .DashboardDistribucionEstatus
                                .Count ==
                            0
                        )
                        {
                            <div class="adq-command-empty">

                                <i class="bi bi-bar-chart"></i>

                                <span>
                                    Todavía no existe información suficiente.
                                </span>

                            </div>
                        }
                        else
                        {
                            @foreach (
                                var estatus
                                in Model.DashboardDistribucionEstatus
                            )
                            {
                                <div class="adq-status-row">

                                    <div class="adq-status-row-header">

                                        <div>

                                            <strong>
                                                @estatus.Estatus
                                            </strong>

                                            <span>

                                                @estatus.Total

                                                @(estatus.Total == 1
                                                    ? "orden"
                                                    : "órdenes")

                                            </span>

                                        </div>


                                        <strong class="adq-status-percentage">
                                            @estatus.Porcentaje.ToString("0.##")%
                                        </strong>

                                    </div>


                                    <div class="adq-status-progress-bar"
                                         style="width: @(estatus.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;">
                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>


            <!-- ============================================== -->
            <!-- RESUMEN OPERATIVO -->
            <!-- ============================================== -->

            <div class="col-12 col-xl-4">

                <div class="adq-command-panel h-100">

                    <div class="adq-command-panel-header">

                        <div>

                            <h5>
                                Resumen operativo
                            </h5>

                            <p>
                                Clasificación general de órdenes.
                            </p>

                        </div>


                        <i class="bi bi-activity"></i>

                    </div>


                    <div class="adq-operational-summary">

                        <!-- FINALIZADAS -->

                        <div class="adq-operational-item">

                            <div class="adq-operational-icon">

                                <i class="bi bi-check-circle"></i>

                            </div>


                            <div>

                                <span>
                                    Finalizadas
                                </span>

                                <strong>
                                    @Model.DashboardFinalizadas
                                </strong>

                            </div>

                        </div>


                        <!-- RECHAZADAS -->

                        <div class="adq-operational-item">

                            <div class="adq-operational-icon">

                                <i class="bi bi-x-circle"></i>

                            </div>


                            <div>

                                <span>
                                    Rechazadas
                                </span>

                                <strong>
                                    @Model.DashboardRechazadas
                                </strong>

                            </div>

                        </div>


                        <!-- CANCELADAS -->

                        <div class="adq-operational-item">

                            <div class="adq-operational-icon">

                                <i class="bi bi-slash-circle"></i>

                            </div>


                            <div>

                                <span>
                                    Canceladas
                                </span>

                                <strong>
                                    @Model.DashboardCanceladas
                                </strong>

                            </div>

                        </div>


                        <!-- SOLICITUDES DE PAGO -->

                        <div class="adq-operational-item">

                            <div class="adq-operational-icon">

                                <i class="bi bi-wallet2"></i>

                            </div>


                            <div>

                                <span>
                                    Solicitudes de pago
                                </span>

                                <strong>
                                    @Model.DashboardSolicitudesPago
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>

@section Scripts
{
    <script src="~/js/DashboardAdquisiciones.js"
            asp-append-version="true">
    </script>
}