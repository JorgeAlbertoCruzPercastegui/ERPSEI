                        <!-- ====================================================== -->
                        <!-- RESUMEN -->
                        <!-- ====================================================== -->

                        <div class="adq-detail-summary">

                            <div class="adq-detail-field adq-detail-field-wide">

                                <span class="adq-detail-label">
                                    Solicitud
                                </span>

                                <div class="adq-detail-value"
                                     id="verSolicitudTitulo">
                                </div>

                            </div>


                            <div class="adq-detail-field">

                                <span class="adq-detail-label">
                                    Solicitante
                                </span>

                                <div class="adq-detail-value"
                                     id="verSolicitudSolicitante">
                                </div>

                            </div>


                            <div class="adq-detail-field">

                                <span class="adq-detail-label">
                                    Fecha
                                </span>

                                <div class="adq-detail-value"
                                     id="verSolicitudFecha">
                                </div>

                            </div>


                            <div class="adq-detail-field">

                                <span class="adq-detail-label">
                                    Área
                                </span>

                                <div class="adq-detail-value"
                                     id="verSolicitudArea">
                                </div>

                            </div>


                            <div class="adq-detail-field">

                                <span class="adq-detail-label">
                                    Estatus
                                </span>

                                <div class="adq-detail-value"
                                     id="verSolicitudEstatus">
                                </div>

                            </div>

                        </div>


                        <!-- ====================================================== -->
                        <!-- DESCRIPCIÓN -->
                        <!-- ====================================================== -->

                        <div class="adq-detail-section">

                            <div class="adq-detail-section-title">

                                <i class="bi bi-card-text"></i>

                                Descripción

                            </div>

                            <div class="adq-detail-text"
                                 id="verSolicitudDescripcion">
                            </div>

                        </div>


                        <!-- ====================================================== -->
                        <!-- JUSTIFICACIÓN -->
                        <!-- ====================================================== -->

                        <div class="adq-detail-section">

                            <div class="adq-detail-section-title">

                                <i class="bi bi-chat-left-text"></i>

                                Justificación

                            </div>

                            <div class="adq-detail-text"
                                 id="verSolicitudJustificacion">
                            </div>

                        </div>


                        <!-- ====================================================== -->
                        <!-- PRODUCTOS -->
                        <!-- ====================================================== -->

                        <div class="adq-detail-section">

                            <div class="adq-detail-section-title">

                                <i class="bi bi-box-seam"></i>

                                Productos / Servicios

                            </div>


                            <div id="verSolicitudProductos"
                                 class="adq-products-list">
                            </div>

                        </div>


                        <!-- ====================================================== -->
                        <!-- DOCUMENTACIÓN -->
                        <!-- ====================================================== -->

                        <div class="adq-detail-section">

                            <div class="adq-detail-section-title">

                                <i class="bi bi-paperclip"></i>

                                Documentación

                            </div>


                            <div id="verSolicitudDocumentos"
                                 class="adq-files-list">
                            </div>

                        </div>

                    </div>


                    <!-- ================================================== -->
                    <!-- CHAT DE SEGUIMIENTO -->
                    <!-- ================================================== -->

                    <div class="tab-pane fade"
                         id="contenidoSeguimientoAdq"
                         role="tabpanel">

                        <div class="adq-followup-wrapper">

                            <!-- ENCABEZADO DEL CHAT -->

                            <div class="adq-followup-header">

                                <div>

                                    <span class="adq-detail-label">
                                        Comunicación de la solicitud
                                    </span>

                                    <strong>
                                        Chat de seguimiento
                                    </strong>

                                    <small class="text-muted d-block">
                                        Comunicación entre el solicitante,
                                        el responsable de aprobación
                                        y el área de Adquisiciones.
                                    </small>

                                </div>


                                <div class="text-end">

                                    <span class="adq-detail-label">
                                        Estatus actual
                                    </span>

                                    <div>

                                        <span id="seguimientoEstatusAdq"
                                              class="badge bg-primary">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- MENSAJES -->

                            <div id="listaComentariosAdq"
                                 class="adq-chat-list">

                                <div class="adq-chat-empty">

                                    <i class="bi bi-chat-square-dots"></i>

                                    <strong>
                                        Aún no hay mensajes
                                    </strong>

                                    <span>
                                        Inicia la conversación relacionada
                                        con esta solicitud.
                                    </span>

                                </div>

                            </div>


                            <!-- NUEVO MENSAJE -->

                            <div id="formComentarioAdq"
                                 class="adq-chat-compose">

                                <input type="hidden"
                                       id="SolicitudComentarioId" />


                                <label for="NuevoComentarioAdq"
                                       class="form-label fw-semibold">

                                    Nuevo mensaje

                                </label>


                                <textarea id="NuevoComentarioAdq"
                                          class="form-control"
                                          rows="3"
                                          maxlength="5000"
                                          placeholder="Escribe un mensaje relacionado con esta solicitud..."></textarea>


                                <!-- ARCHIVOS SELECCIONADOS PARA EL MENSAJE -->

                                <div id="listaAdjuntosComentarioAdq"
                                     class="mt-2">
                                </div>


                                <div class="d-flex justify-content-between align-items-center gap-2 mt-3">

                                    <div>

                                        <button type="button"
                                                id="btnSeleccionarAdjuntoComentarioAdq"
                                                class="btn btn-outline-secondary">

                                            <i class="bi bi-paperclip me-1"></i>

                                            Adjuntar archivo

                                        </button>


                                        <input type="file"
                                               id="archivoComentarioAdq"
                                               class="d-none"
                                               multiple
                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />

                                    </div>


                                    <button type="button"
                                            id="btnEnviarComentarioAdq"
                                            class="btn btn-primary">

                                        <i class="bi bi-send me-1"></i>

                                        Enviar mensaje

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================== -->
                    <!-- HISTORIAL -->
                    <!-- ================================================== -->

                    <div class="tab-pane fade"
                         id="contenidoHistorialAdq"
                         role="tabpanel">

                        <div class="adq-history-wrapper">

                            <div class="adq-form-section-title">

                                <i class="bi bi-clock-history"></i>

                                Historial de la solicitud

                            </div>


                            <div class="text-muted small mb-3">

                                Consulta los movimientos y cambios
                                realizados durante el proceso de compra.

                            </div>


                            <div id="listaHistorialAdq"
                                 class="adq-history-list">

                                <div class="text-muted small">
                                    Cargando historial...
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>


                <button type="button"
                        id="btnEditarDesdeDetalleAdq"
                        class="btn btn-outline-primary d-none">

                    <i class="bi bi-pencil me-1"></i>

                    Editar

                </button>


                <button type="button"
                        id="btnCancelarDesdeDetalleAdq"
                        class="btn btn-outline-danger d-none">

                    <i class="bi bi-x-circle me-1"></i>

                    Cancelar solicitud

                </button>


                <button type="button"
                        id="btnEnviarDesdeDetalleAdq"
                        class="btn btn-primary d-none">

                    <i class="bi bi-send me-1"></i>

                    Enviar solicitud

                </button>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================== -->
<!-- MODAL DECISIÓN GERENTE -->
<!-- ========================================================== -->

<div class="modal fade"
     id="modalDecisionGerenteAdq"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  id="formDecisionGerenteAdq">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="SolicitudDecisionId"
                       name="SolicitudDecisionId" />


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title"
                            id="tituloDecisionGerenteAdq">

                            Decidir solicitud

                        </h5>


                        <div class="small text-muted"
                             id="folioDecisionGerenteAdq">
                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="mensajeDecisionGerenteAdq"
                         class="alert mb-3">
                    </div>


                    <div>

                        <label for="ComentarioDecision"
                               class="form-label"
                               id="labelComentarioDecisionAdq">

                            Comentario

                        </label>


                        <textarea id="ComentarioDecision"
                                  name="ComentarioDecision"
                                  class="form-control"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Escribe un comentario..."></textarea>


                        <div class="form-text"
                             id="ayudaComentarioDecisionAdq">
                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            id="btnConfirmarAprobacionAdq"
                            formaction="?handler=AprobarGerente"
                            class="btn btn-success d-none">

                        <i class="bi bi-check-lg me-1"></i>

                        Confirmar aprobación

                    </button>


                    <button type="submit"
                            id="btnConfirmarRechazoAdq"
                            formaction="?handler=RechazarGerente"
                            class="btn btn-danger d-none">

                        <i class="bi bi-x-lg me-1"></i>

                        Confirmar rechazo

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================== -->
<!-- MODAL ACCIÓN ADQUISICIONES -->
<!-- ========================================================== -->

<div class="modal fade"
     id="modalAccionAdquisiciones"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  id="formAccionAdquisiciones">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="SolicitudAdquisicionesId"
                       name="SolicitudAdquisicionesId" />


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title"
                            id="tituloAccionAdquisiciones">

                            Gestión de solicitud

                        </h5>


                        <small class="text-muted"
                               id="folioAccionAdquisiciones">
                        </small>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <div class="modal-body">

                    <div id="mensajeAccionAdquisiciones"
                         class="alert mb-3">
                    </div>


                    <div>

                        <label for="ComentarioAdquisiciones"
                               class="form-label fw-bold"
                               id="labelComentarioAdquisiciones">

                            Comentario

                        </label>


                        <textarea id="ComentarioAdquisiciones"
                                  name="ComentarioAdquisiciones"
                                  class="form-control"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Escribe un comentario..."></textarea>


                        <div class="form-text"
                             id="ayudaComentarioAdquisiciones">
                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cerrar

                    </button>


                    <button type="submit"
                            id="btnAprobarAdquisiciones"
                            formaction="?handler=AprobarAdquisiciones"
                            class="btn btn-success d-none">

                        <i class="bi bi-check-lg me-1"></i>

                        Aprobar solicitud

                    </button>


                    <button type="submit"
                            id="btnCancelarAdquisiciones"
                            formaction="?handler=CancelarAdquisiciones"
                            class="btn btn-danger d-none">

                        <i class="bi bi-x-lg me-1"></i>

                        Confirmar cancelación

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================== -->
<!-- MODAL ASIGNAR AGENTE -->
<!-- ========================================================== -->

<div class="modal fade"
     id="modalAsignarAdquisiciones"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="AsignarAgente">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="SolicitudAsignarAdqId"
                       name="SolicitudAdquisicionesId" />


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title">

                            <i class="bi bi-person-plus me-2"></i>

                            Asignar agente de compras

                        </h5>


                        <small id="folioAsignarAdq"
                               class="text-muted">
                        </small>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Agente de compras

                        </label>


                        <select name="UsuarioAsignadoAdqId"
                                class="form-select"
                                required>

                            <option value="">
                                Selecciona...
                            </option>


                            @foreach (
                                var agente
                                in Model.AgentesCompras)
                            {
                                <option value="@agente.Value">

                                    @agente.Text

                                </option>
                            }

                        </select>

                    </div>


                    <div>

                        <label class="form-label fw-bold">

                            Observaciones

                        </label>


                        <textarea name="ComentarioAdquisiciones"
                                  class="form-control"
                                  rows="3"
                                  maxlength="2000"
                                  placeholder="Observaciones opcionales..."></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-person-check me-1"></i>

                        Asignar agente

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================== -->
<!-- MODAL CANCELAR SOLICITUD DEL USUARIO -->
<!-- ========================================================== -->

<div class="modal fade"
     id="modalCancelarSolicitudUsuarioAdq"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="CancelarSolicitudUsuario">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="SolicitudCancelarUsuarioId"
                       name="SolicitudCancelarUsuarioId" />


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title">

                            <i class="bi bi-x-circle me-2"></i>

                            Cancelar solicitud

                        </h5>

                        <small class="text-muted"
                               id="folioCancelarSolicitudUsuarioAdq">
                        </small>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle me-1"></i>

                        La solicitud dejará de continuar en el proceso de compra.

                    </div>


                    <div>

                        <label for="MotivoCancelacionUsuario"
                               class="form-label fw-bold">

                            Motivo de cancelación

                        </label>


                        <textarea id="MotivoCancelacionUsuario"
                                  name="MotivoCancelacionUsuario"
                                  class="form-control"
                                  rows="4"
                                  maxlength="2000"
                                  required
                                  placeholder="Indica por qué ya no requieres esta compra..."></textarea>

                        <div class="form-text">
                            El motivo quedará registrado en el historial.
                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Regresar

                    </button>


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-x-lg me-1"></i>

                        Confirmar cancelación

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Index.js"
            asp-append-version="true">
    </script>

    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const modalElement =
                        document.getElementById(
                            "modalNuevaSolicitud"
                        );

                    if (!modalElement) {
                        return;
                    }

                    bootstrap.Modal
                        .getOrCreateInstance(
                            modalElement
                        )
                        .show();
                }
            );
        </script>
    }
}