<!-- Sección Nuevo/Editar/Ver Registro --- -->

<form id="theForm" method="post">
    <div id="dlgActivoFijo" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgActivoFijoTitle" class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- ID (solo) -->
                        <div class="row">
                            <div class="col-3">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoId" asp-for="InputActivosFijos.Id" type="text" class="form-control" />
                                    <label asp-for="InputActivosFijos.Id" class="form-label"></label>
                                    <span asp-validation-for="InputActivosFijos.Id" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 1 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoFolio" asp-for="InputActivosFijos.Folio" type="text" class="form-control" />
                                    <label asp-for="InputActivosFijos.Folio" class="form-label"></label>
                                    <span asp-validation-for="InputActivosFijos.Folio" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoMarca" asp-for="InputActivosFijos.Marca" type="text" class="form-control" placeholder="@Localizer["MarcaPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.Marca" class="form-label"></label>
                                    <span asp-validation-for="InputActivosFijos.Marca" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoNumeroSerie" asp-for="InputActivosFijos.NumeroSerie" type="text" class="form-control" placeholder="@Localizer["NumeroSeriePlaceholder"]"/>
                                    <label asp-for="InputActivosFijos.NumeroSerie" class="form-label"></label>
                                    <span asp-validation-for="InputActivosFijos.NumeroSerie" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 2 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoDescripcion" asp-for="InputActivosFijos.Descripcion" type="text" class="form-control" placeholder="@Localizer["DescripcionPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.Descripcion" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.Descripcion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoUbicacion" asp-for="InputActivosFijos.Ubicacion" type="text" class="form-control" placeholder="@Localizer["UbicacionPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.Ubicacion" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.Ubicacion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpActivoFijoResponsable" class="form-select" disabled>
                                        <option value="">Seleccione un responsable</option>
                                        @foreach (var empleado in empleados)
                                        {
                                            <option value="@empleado.Id">@empleado.NombreCompleto</option>
                                        }
                                    </select>
                                    <label for="inpActivoFijoResponsable">Responsable</label>
                                </div>
                            </div>
                            <input type="hidden" id="inpEmpleadoId" name="InputActivosFijos.EmpleadoId" />


                        </div>

                        <!-- Grupo 3 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpActivoFijoCategoria" asp-for="InputActivosFijos.Categoria" class="form-select">
                                        <option value="">Seleccione...</option>
                                        @foreach (var categoria in categorias)
                                        {
                                            <option value="@categoria.Id">@categoria.Descripcion</option>
                                        }
                                    </select>
                                    <label for="inpActivoFijoCategoria">Categoría</label>
                                </div>
                                <span asp-validation-for="InputActivosFijos.Categoria" class="text-danger"></span>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpActivoFijoTipo" asp-for="InputActivosFijos.Tipo" class="form-select">
                                        <option value="">Seleccione...</option>
                                        @foreach (var tipo in tipos)
                                        {
                                            <option value="@tipo.Id">@tipo.Descripcion</option>
                                        }
                                    </select>
                                    <label for="inpActivoFijoTipo">Tipo</label>
                                </div>
                                <span asp-validation-for="InputActivosFijos.Tipo" class="text-danger"></span>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoFechaCompra" asp-for="InputActivosFijos.FechaCompra" type="date" class="form-control" placeholder="@Localizer["FechaCompraPlaceholder"]"/>
                                    <label asp-for="InputActivosFijos.FechaCompra" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.FechaCompra" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 4 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoPrecio" asp-for="InputActivosFijos.Precio" type="text" class="form-control" placeholder="@Localizer["PrecioPlaceholder"]"/>
                                    <label asp-for="InputActivosFijos.Precio" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.Precio" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoLinkFacturaCompra" asp-for="InputActivosFijos.LinkFacturaCompra" type="text" class="form-control" placeholder="@Localizer["LinkFacturaCompraPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.LinkFacturaCompra" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.LinkFacturaCompra" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoComentarios" asp-for="InputActivosFijos.Comentarios" type="text" class="form-control" placeholder="@Localizer["ComentariosPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.Comentarios" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.Comentarios" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 5 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpActivoFijoFechaRenovacion" asp-for="InputActivosFijos.FechaRenovacion" type="date" class="form-control" placeholder="@Localizer["FechaRenovacionPlaceholder"]" />
                                    <label asp-for="InputActivosFijos.FechaRenovacion" class="form-label required"></label>
                                    <span asp-validation-for="InputActivosFijos.FechaRenovacion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button id="dlgActivoFijoBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                    <button id="dlgActivoFijoBtnGuardar" type="button" class="btn btn-primary" onclick="onGuardarClick();">
                        <i class="bi bi-floppy"></i> @Localizer["SaveButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- --------------------------- -->
<!-- Sección Importar Excel ---- -->
<div id="dlgImportarExcel" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="dlgExcelTitle" class="modal-title">@Localizer["ImportExcelDialogTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body align-items-center">
                <div class="alert d-flex align-items-center" role="alert">
                    <i class="bi bi-1-circle-fill me-2" style="font-size: x-large"></i>
                    <div>@Localizer["ImportExcelSuggestionA"]</div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-12 text-center mb-3">
                            <a id="dlgExcelBtnPlantilla" href="@Url.Page("ActivosFijos", "DownloadPlantilla")" class="btn btn-primary">
                                <i class="bi bi-file-earmark-ruled"></i> @Localizer["PlantillaButtonTitle"]
                            </a>
                        </div>
                    </div>
                </div>
                <div class="alert d-flex align-items-center" role="alert">
                    <i class="bi bi-2-circle-fill me-2" style="font-size: x-large"></i>
                    <div>@Localizer["ImportExcelSuggestionB"]</div>
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <form id="importForm" method="post">
                                <input asp-for="InputImportar.Plantilla" id="excelFile" onchange="onExcelSelectorChanged(this);" class="form-control" type="file" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                                <span asp-validation-for="InputImportar.Plantilla" class="text-danger"></span>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dlgExcelBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarImportarClick();" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> @Localizer["CancelButtonTitle"]
                </button>
                <button id="dlgExcelBtnImportar" type="button" class="btn btn-primary" onclick="onImportarClick();">
                    <i class="bi bi-upload"></i> @Localizer["ImportButtonText"]
                </button>
            </div>
        </div>
    </div>
</div>



