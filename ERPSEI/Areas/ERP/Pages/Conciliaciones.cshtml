                        </div> 
                        <br />
                        <hr />
                        <div class="container mt-4">
                            <!-- Botón para abrir el modal -->
                            <button type="button" id="dlgConciliacionAsistidaBtn" class="btn btn-primary w-20 mb-4" onclick="conciliarAutomatico()" data-bs-toggle="modal" data-bs-target="#ConciliacionModal">
                                @Localizer["TitleModalConciliacionAsistida"]
                            </button>
                            <br />

                            <!--<div class="d-flex justify-content-end mb-3">
                                <button onclick="mostrarMovimientosConciliacion()" class="btn btn-primary btn-sm">Conciliación Masiva</button>
                            </div>
                            -->
                            <div class="row">
                                <br />
                                <div class="">
                                    <table id="tableResult"
                                           data-toggle="table"
                                           data-search="true"
                                           data-height="460"
                                           data-show-search-button="true"
                                           data-detail-view="true"
                                           data-detail-formatter="detailFormatter"
                                           data-card-view="false"
                                           data-pagination="false"
                                           data-buttons-class="primary"
                                           data-unique-id="id"
                                           data-row-style="rowStyle">
                                        <thead>
                                            <tr>
                                                <th data-field="Id">Id</th>
                                                <th data-field="Serie">Serie</th>
