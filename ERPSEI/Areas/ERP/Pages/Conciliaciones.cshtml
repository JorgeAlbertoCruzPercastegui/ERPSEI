</div>
</form>

<!-- Modal para mostrar la lista de movimientos conciliados y no conciliados -->
<div class="modal fade" id="modalConciliacionMasiva" tabindex="-1" aria-labelledby="modalConciliacionMasivaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalConciliacionMasivaLabel">Lista de Movimientos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <ul id="listaMovimientos" class="list-group">
                    <!-- Aquí se cargarán los datos de movimientos dinámicamente -->
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar coincidencias de comprobantes -->
<div class="modal fade" id="modalSimilitud" tabindex="-1" aria-labelledby="modalSimilitudLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSimilitudLabel">Coincidencias de Comprobantes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalSimilitudHeader"></div> <!-- Datos del movimiento seleccionado -->
                <!-- Contenedor con scroll para la tabla -->
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Serie</th>
                                <th>Folio</th>
                                <th>Fecha</th>
                                <th data-formatter="currencyFormatter">Total</th>
                                <th>Porcentaje de Similitud</th>
                                <th>Seleccionar</th>
                            </tr>
                        </thead>
                        <tbody id="modalSimilitudBody">
                            <!-- Aquí se mostrarán los comprobantes con coincidencias -->
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Nuevo footer para el botón de conciliar -->
            <div class="modal-footer" id="modalSimilitudFooter">
                <!-- Aquí se añadirá dinámicamente el botón de conciliar -->
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar mensajes -->
