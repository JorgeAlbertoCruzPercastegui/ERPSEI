                                                <th data-field="Fecha">Fecha</th>
                                                <th data-field="Banco">Banco</th>
                                                <th data-field="UUID">UUID</th>
                                                <th data-field="Receptor">Receptor</th>
                                                <th data-field="Total" data-formatter="currencyFormatter">Total</th>
