                                <div id="saveValidationSummaryM" class="alert alert-danger" style="display: none;"></div>

                                <div class="col-sm-6 col-md-6 col-lg-6">
                                    <h4 class="text-center">@Localizer["TitleModalDerMovimientos"]</h4>
                                    <!-- Agregar combobox a la izquierda del buscador -->
                                    <!--<div class="toolbar">
                                        <div class="form-group">
                                            <div class="custom-select">
                                                <select id="filterOptionsM" class="form-control">
                                                    <option value="opcion1">Mostrar Todo</option>
                                                    <option value="opcion2">Mostrar Conciliados</option>
                                                    <option value="opcion3">Mostrar Pendientes</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>-->
                                    <!-- Card del lado derecho -->
                                    <table id="tableCardMovimientos"
                                           data-toggle="table"
                                           data-toolbar=".toolbar"
                                           data-search="true"
