                    </div>

                    <!-- ========================================== -->
                    <!-- SLA -->
                    <!-- ========================================== -->

                    <div class="sd-detail-section">

                        <div class="sd-detail-section-title">

                            <i class="bi bi-stopwatch"></i>

                            Acuerdos de nivel de servicio

                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="sd-sla-box">

                                    <div>

                                        <span>
                                            Límite de primera respuesta
                                        </span>

