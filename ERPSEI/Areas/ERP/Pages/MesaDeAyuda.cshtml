@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/MesaDeAyuda.js"
            asp-append-version="true">
    </script>

    <script>
        // Abrir el detalle al llegar desde la campanita (?ticketId=123).
        // Reutiliza el botón de detalle existente y por tanto su autorización del backend.
        document.addEventListener("DOMContentLoaded", function () {
            const parametros = new URLSearchParams(window.location.search);
            const ticketId = parametros.get("ticketId");
            if (!ticketId || !/^\d+$/.test(ticketId) || Number(ticketId) <= 0) return;

            const tabla = document.getElementById("tablaMesaDeAyuda");
            if (!tabla) return;

            const botonDetalle = Array.from(tabla.querySelectorAll("button[data-ticket-id]"))
                .find(boton => boton.dataset.ticketId === ticketId);

            if (!botonDetalle) {
                // El ticket no está en la bandeja autorizada de este usuario.
                // No se revelan datos ni se intenta omitir los permisos del servidor.
                return;
            }

            // Puede encontrarse en una bandeja distinta de "Sin asignar".
            const botonTodos = document.querySelector('#mesaBandejasAdmin button[data-bandeja="todos"]');
            if (botonTodos) botonTodos.click();

            // Activa el mismo manejador que usa el botón "Ver ticket" de la tabla.
            botonDetalle.click();

            // Retira el parámetro tras abrirlo, para que una recarga manual no vuelva a abrirlo.
            parametros.delete("ticketId");
            const resto = parametros.toString();
            const urlLimpia = window.location.pathname + (resto ? "?" + resto : "") + window.location.hash;
            window.history.replaceState(window.history.state, "", urlLimpia);
        });

        // Bandejas del administrador. Filtra filas ya autorizadas por el servidor.
        // No sustituye las validaciones de seguridad del PageModel.
        document.addEventListener("DOMContentLoaded", function () {
            const nav = document.getElementById("mesaBandejasAdmin");
            const tabla = document.getElementById("tablaMesaDeAyuda");
            if (!nav || !tabla) return; // Técnicos y solicitantes conservan su vista.

            const botones = Array.from(nav.querySelectorAll("[data-bandeja]"));
            const filas = Array.from(tabla.querySelectorAll("tbody tr[data-asignado]"));
            const mensajeVacio = document.getElementById("mesaBandejaVacia");
            const badge = document.querySelector(".sd-table-shell-badge");

            function mostrarBandeja(bandeja) {
                let cantidad = 0;
                filas.forEach(function (fila) {
                    const asignado = fila.dataset.asignado === "si";
                    const estado = Number(fila.dataset.statusId);
                    const mostrar = bandeja === "todos" ||
                        (bandeja === "asignados" && asignado) ||
                        (bandeja === "sin-asignar" && !asignado) ||
                        (bandeja === "en-proceso" && estado === 3) ||
                        (bandeja === "cerrados" && estado === 6) ||
                        (bandeja === "sla-proximos" && fila.dataset.sla === "proximo") ||
                        (bandeja === "sla-vencidos" && fila.dataset.sla === "vencido");
                    fila.classList.toggle("sd-tab-hidden", !mostrar);
                    if (mostrar) cantidad++;
                });

                botones.forEach(function (boton) {
                    boton.setAttribute("aria-pressed", String(boton.dataset.bandeja === bandeja));
                });
                if (mensajeVacio) mensajeVacio.classList.toggle("d-none", cantidad !== 0);
                if (badge) badge.textContent = cantidad + " registro(s) en bandeja";
            }

            nav.addEventListener("click", function (event) {
                const boton = event.target.closest("button[data-bandeja]");
                if (boton && nav.contains(boton)) mostrarBandeja(boton.dataset.bandeja);
            });

            mostrarBandeja("sin-asignar");
        });
    </script>
}