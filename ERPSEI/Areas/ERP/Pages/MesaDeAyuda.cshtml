@page
@model ERPSEI.Areas.ERP.Pages.MesaDeAyudaModel

@{
    ViewData["Title"] = "Mesa de Ayuda";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/MesaDeAyuda.css"
          asp-append-version="true" />

    <style>
        /* Bandeja administrativa: pestañas de asignación, sin afectar a técnicos ni solicitantes. */
        .sd-admin-toolbar { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px 24px; margin:24px 24px 22px; }
        .sd-asignacion-tabs { display:flex; flex:0 1 auto; flex-wrap:wrap; align-items:center; gap:12px; margin:0; }
        .sd-asignacion-tab { display:inline-flex; align-items:center; gap:9px; min-height:42px; border:1px solid #d8d4ed; border-radius:12px; padding:9px 14px; background:#fff; color:#21166f; font-weight:700; cursor:pointer; transition:background .15s ease, color .15s ease; }
        .sd-asignacion-tab:hover, .sd-asignacion-tab:focus-visible { border-color:#21166f; outline-offset:2px; }
        .sd-asignacion-tab[aria-pressed="true"] { background:#21166f; border-color:#21166f; color:#fff; }
        .sd-asignacion-numero { display:inline-grid; min-width:24px; height:24px; place-items:center; border-radius:999px; background:#ece9fa; color:#21166f; font-size:12px; padding:0 6px; }
        .sd-asignacion-tab[aria-pressed="true"] .sd-asignacion-numero { background:#fff; }
        #tablaMesaDeAyuda tbody tr.sd-tab-hidden { display:none !important; }
        .sd-asignacion-vacia { padding:24px; text-align:center; color:#625f79; }
        /* Semáforo SLA: solo lectura, fechas calculadas al abrir/actualizar la página. */
        .sd-sla-resumen { display:flex; flex-wrap:wrap; gap:12px; margin:0 0 22px; }
        .sd-sla-resumen-item { display:flex; align-items:center; gap:10px; padding:13px 18px; min-height:54px; border:1px solid #e8e7ef; border-radius:12px; background:#fff; font-size:13px; font-weight:700; color:#252334; }
        .sd-sla-resumen-item strong { font-size:21px; color:#21166f; }
        .sd-sla-resumen-item.sd-sla-riesgo { border-color:#f2d59a; background:#fffaf0; }
        .sd-sla-resumen-item.sd-sla-critico { border-color:#efb8bd; background:#fff6f7; }
        .sd-sla-indicador { display:inline-flex; align-items:center; padding:6px 9px; border-radius:99px; font-size:11px; font-weight:750; white-space:nowrap; }
        .sd-sla-indicador.vigente { background:#e9f7ef; color:#176b45; }
        .sd-sla-indicador.proximo { background:#fff2d4; color:#915c00; }
        .sd-sla-indicador.vencido { background:#ffe6e8; color:#ad2535; }
        .sd-sla-indicador.pausado { background:#eef1f6; color:#545c72; }
        .sd-sla-indicador.finalizado { background:#f1eff4; color:#606074; }
        .sd-sla-indicador.sin-sla { background:#f1eff4; color:#606074; }
        @@media(max-width:575.98px) { .sd-sla-resumen-item { flex:1 1 140px; justify-content:center; } }
        .sd-exportaciones { display:flex; flex:0 0 auto; flex-wrap:wrap; gap:10px; align-items:center; justify-content:flex-end; margin:0 0 0 auto; }
        .sd-exportar-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:42px; padding:10px 16px; background:#fff; border:1px solid #d8d4ed; border-radius:12px; font-size:13px; font-weight:700; color:#21166f; text-decoration:none; transition:background .15s ease,border-color .15s ease; }
        .sd-exportar-btn:hover,.sd-exportar-btn:focus-visible { color:#21166f; background:#f1effb; border-color:#21166f; }
        .sd-exportar-btn.pdf { color:#9c2536; border-color:#ebcad0; }
        .sd-exportar-btn.pdf:hover { background:#fff4f5; color:#9c2536; }
        @@media(max-width:575.98px) { .sd-admin-toolbar { margin:18px 16px 16px; gap:14px; } .sd-asignacion-tabs { width:100%; } .sd-exportaciones { width:100%; justify-content:flex-end; margin-left:0; gap:8px; } .sd-exportar-btn { flex:1 1 auto; } }
        @@media(max-width:575.98px) { .sd-asignacion-tabs { gap:8px; } .sd-asignacion-tab { flex:1 1 auto; justify-content:center; padding:10px; font-size:13px; } }
    </style>
}


<div class="sd-page">

    <!-- ====================================================== -->
    <!-- MENSAJES -->
    <!-- ====================================================== -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-4">
        </div>
    }


    <!-- ====================================================== -->
    <!-- ENCABEZADO MESA DE AYUDA -->
    <!-- ====================================================== -->

    <section class="sd-header">

        <div class="sd-header-content">

            <div class="sd-header-main">

                <div class="sd-header-icon">

                    <i class="bi bi-headset"></i>

                </div>


                <div>

                    <h1 class="sd-title">
                        Mesa de Ayuda
                    </h1>


                    @if (Model.EsAdmin)
                    {
                        <p class="sd-subtitle">

                            Administración, asignación y seguimiento
                            de solicitudes de soporte.

                        </p>
                    }
                    else
                    {
                        <p class="sd-subtitle">

                            Reporta una incidencia o solicita soporte
                            al área de TI.

                        </p>
                    }

                </div>

            </div>


            <div class="d-flex align-items-center gap-2">

                @if (Model.EsAdmin)
                {
                    <span class="sd-admin-label">

                        <i class="bi bi-shield-check me-1"></i>

                        Administrador

                    </span>
                }


                <button type="button"
                        class="sd-btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#modalCrearTicket">

                    <i class="bi bi-plus-lg me-1"></i>

                    Crear Ticket

                </button>

            </div>

        </div>

    </section>


    <!-- ====================================================== -->
    <!-- KPIs -->
    <!-- ====================================================== -->

    <section class="sd-kpi-grid">


        <!-- ABIERTOS -->

        <div class="sd-kpi-card">

            <div class="sd-kpi-content">

                <div>

                    <div class="sd-kpi-title">

                        Tickets abiertos

                    </div>


                    <div class="sd-kpi-value">

                        @Model.TotalAbiertos

                    </div>

                </div>


                <div class="sd-kpi-icon sd-kpi-purple">

                    <i class="bi bi-inbox"></i>

                </div>

            </div>

        </div>


        <!-- NUEVOS -->

        <div class="sd-kpi-card">

            <div class="sd-kpi-content">

                <div>

                    <div class="sd-kpi-title">

                        Nuevos

                    </div>


                    <div class="sd-kpi-value">

                        @Model.TotalNuevos

                    </div>

                </div>


                <div class="sd-kpi-icon sd-kpi-blue">

                    <i class="bi bi-stars"></i>

                </div>

            </div>

        </div>


        <!-- EN PROCESO -->

        <div class="sd-kpi-card">

            <div class="sd-kpi-content">

                <div>

                    <div class="sd-kpi-title">

                        En proceso

                    </div>


                    <div class="sd-kpi-value">

                        @Model.TotalEnProceso

                    </div>

                </div>


                <div class="sd-kpi-icon sd-kpi-orange">

                    <i class="bi bi-gear"></i>

                </div>

            </div>

        </div>


        <!-- SIN ASIGNAR / RESUELTOS -->

        <div class="sd-kpi-card">

            <div class="sd-kpi-content">

                <div>

                    <div class="sd-kpi-title">

                        @if (Model.EsAdmin)
                        {
                            <span>
                                Sin asignar
                            </span>
                        }
                        else
                        {
                            <span>
                                Resueltos
                            </span>
                        }

                    </div>


                    <div class="sd-kpi-value">

                        @if (Model.EsAdmin)
                        {
                            @Model.TotalSinAsignar
                        }
                        else
                        {
                            @Model.TotalResueltos
                        }

                    </div>

                </div>


                @if (Model.EsAdmin)
                {
                    <div class="sd-kpi-icon sd-kpi-red">

                        <i class="bi bi-person-x"></i>

                    </div>
                }
                else
                {
                    <div class="sd-kpi-icon sd-kpi-green">

                        <i class="bi bi-check-circle"></i>

                    </div>
                }

            </div>

        </div>

    </section>

    @if (Model.PuedeGestionarTickets)
    {
        // Estos conteos aplican únicamente a tickets visibles para el usuario actual.
        DateTime instanteSla = DateTime.Now;
        int proximosSla = Model.Tickets.Count(t => Model.ObtenerEstadoSla(t, instanteSla) == "proximo");
        int vencidosSla = Model.Tickets.Count(t => Model.ObtenerEstadoSla(t, instanteSla) == "vencido");
        int pausadosSla = Model.Tickets.Count(t => Model.ObtenerEstadoSla(t, instanteSla) == "pausado");
        <section class="sd-sla-resumen" aria-label="Resumen de acuerdos de nivel de servicio">
            <div class="sd-sla-resumen-item sd-sla-riesgo"><i class="bi bi-hourglass-split"></i> Próximos a vencer (60 min) <strong>@proximosSla</strong></div>
            <div class="sd-sla-resumen-item sd-sla-critico"><i class="bi bi-exclamation-triangle"></i> SLA vencidos <strong>@vencidosSla</strong></div>
            <div class="sd-sla-resumen-item"><i class="bi bi-pause-circle"></i> Pendientes del usuario <strong>@pausadosSla</strong></div>
        </section>
    }

    <!-- ====================================================== -->
    <!-- PANEL TICKETS -->
    <!-- ====================================================== -->

    <section class="sd-panel sd-panel-pro">

        <!-- ====================================================== -->
        <!-- HERO DEL PANEL -->
        <!-- ====================================================== -->

        <div class="sd-panel-hero">

            <div class="sd-panel-hero-left">

                <div class="sd-panel-kicker">
                    Service Desk
                </div>

                <h2 class="sd-panel-hero-title">

                    @if (Model.EsAdmin)
                    {
                        <span>Todos los Tickets</span>
                    }
                    else if (Model.EsTecnicoMesaAyuda)
                    {
                        <span>Mis Tickets Asignados</span>
                    }
                    else
                    {
                        <span>Mis Tickets</span>
                    }

                </h2>

                <p class="sd-panel-hero-text">

                    @if (Model.EsAdmin)
                    {
                        <span>
                            Administra, filtra y da seguimiento
                            a los tickets registrados en la Mesa de Ayuda.
                        </span>
                    }
                    else if (Model.EsTecnicoMesaAyuda)
                    {
                        <span>
                            Consulta y da seguimiento
                            a los tickets que tienes asignados.
                        </span>
                    }
                    else
                    {
                        <span>
                            Consulta el estado y seguimiento
                            de tus solicitudes en tiempo real.
                        </span>
                    }

                </p>

            </div>

            <div class="sd-panel-hero-right">

                <button type="button"
                        class="sd-btn-outline sd-btn-refresh"
                        onclick="location.reload();">

                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Actualizar

                </button>

            </div>

        </div>


        @if (Model.EsAdmin)
        {
            // Se usan los mismos tickets autorizados que carga el PageModel.
            int ticketsSinAsignar = Model.Tickets.Count(t => string.IsNullOrWhiteSpace(t.UsuarioAsignadoId));
            int ticketsAsignados = Model.Tickets.Count - ticketsSinAsignar;
            int ticketsEnProceso = Model.Tickets.Count(t => t.StatusId == 3);
            int ticketsCerrados = Model.Tickets.Count(t => t.StatusId == 6);
            DateTime fechaIndicadores = DateTime.Now;
            int ticketsSlaProximos = Model.Tickets.Count(t => Model.ObtenerEstadoSla(t, fechaIndicadores) == "proximo");
            int ticketsSlaVencidos = Model.Tickets.Count(t => Model.ObtenerEstadoSla(t, fechaIndicadores) == "vencido");

            <div class="sd-admin-toolbar">
            <nav class="sd-asignacion-tabs" aria-label="Bandejas de tickets" id="mesaBandejasAdmin">
                <button type="button" class="sd-asignacion-tab" data-bandeja="sin-asignar" aria-pressed="true" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-person-x" aria-hidden="true"></i> Sin asignar <span class="sd-asignacion-numero">@ticketsSinAsignar</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="asignados" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-person-check" aria-hidden="true"></i> Asignados <span class="sd-asignacion-numero">@ticketsAsignados</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="en-proceso" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-gear" aria-hidden="true"></i> En proceso <span class="sd-asignacion-numero">@ticketsEnProceso</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="cerrados" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-lock" aria-hidden="true"></i> Cerrados <span class="sd-asignacion-numero">@ticketsCerrados</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="sla-proximos" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-clock-history" aria-hidden="true"></i> Próximos SLA <span class="sd-asignacion-numero">@ticketsSlaProximos</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="sla-vencidos" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i> SLA vencido <span class="sd-asignacion-numero">@ticketsSlaVencidos</span>
                </button>
                <button type="button" class="sd-asignacion-tab" data-bandeja="todos" aria-pressed="false" aria-controls="tablaMesaDeAyuda">
                    <i class="bi bi-inboxes" aria-hidden="true"></i> Todos <span class="sd-asignacion-numero">@Model.Tickets.Count</span>
                </button>
            </nav>
            <div class="sd-exportaciones">
                <a class="sd-exportar-btn" asp-area="ERP" asp-page="/MesaDeAyuda" asp-page-handler="ExportarExcel">
                    <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Exportar Excel
                </a>
                <a class="sd-exportar-btn pdf" asp-area="ERP" asp-page="/MesaDeAyuda" asp-page-handler="ExportarPdf">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Exportar PDF
                </a>
            </div>
            </div>
        }

        <!-- ====================================================== -->
        <!-- FILTROS PRO -->
        <!-- ====================================================== -->

        <div class="sd-filters-pro">

            <div class="sd-filters-pro-bar">

                <div class="sd-filters-pro-title-wrap">

                    <div class="sd-filters-pro-icon">
                        <i class="bi bi-funnel"></i>
                    </div>

                    <div>
                        <div class="sd-filters-pro-title">
                            Filtros de búsqueda
                        </div>
                        <div class="sd-filters-pro-subtitle">
                            Encuentra tickets por folio, estado o categoría.
                        </div>
                    </div>

                </div>

                <button type="button"
                        id="btnLimpiarFiltros"
                        class="sd-btn-filter-clear">

                    <i class="bi bi-eraser me-1"></i>
                    Limpiar filtros

                </button>

            </div>


            <div class="sd-filters-grid">

                <!-- BUSCAR -->

                <div class="sd-filter-card sd-filter-card-lg">

                    <label class="sd-filter-label">
                        Buscar ticket
                    </label>

                    <div class="sd-filter-input-wrap">

                        <div class="sd-filter-input-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <input type="text"
                               id="filtroBusqueda"
                               class="sd-filter-input"
                               autocomplete="off"
                               placeholder="Busca por folio o asunto..." />

                    </div>

                </div>


                <!-- ESTADO -->

                <div class="sd-filter-card">

                    <label class="sd-filter-label">
                        Estado
                    </label>

                    <select id="filtroEstado"
                            class="sd-filter-select">

                        <option value="">Todos</option>
                        <option value="Nuevo">Nuevo</option>
                        <option value="Asignado">Asignado</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Pendiente del usuario">Pendiente del usuario</option>
                        <option value="Resuelto">Resuelto</option>
                        <option value="Cerrado">Cerrado</option>
                        <option value="Reabierto">Reabierto</option>
                        <option value="Cancelado">Cancelado</option>

                    </select>

                </div>


                <!-- CATEGORÍA -->

                <div class="sd-filter-card">

                    <label class="sd-filter-label">
                        Categoría
                    </label>

                    <select id="filtroCategoria"
                            class="sd-filter-select">

                        <option value="">Todas</option>

                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Text">
                                @categoria.Text
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>


        <!-- ====================================================== -->
        <!-- TABLA PRO -->
        <!-- ====================================================== -->

        <div class="sd-table-shell">

            <div class="sd-table-shell-head">

                <div class="sd-table-shell-title">
                    Bandeja de tickets
                </div>

                <div class="sd-table-shell-badge">
                    @Model.Tickets.Count registro(s)
                </div>

            </div>

            @if (Model.EsAdmin)
            {
                <div id="mesaBandejaVacia" class="sd-asignacion-vacia d-none" role="status" aria-live="polite">
                    No hay tickets en esta bandeja.
                </div>
            }

            <div class="table-responsive sd-table-wrap">

                <table class="table sd-table sd-table-pro"
                       id="tablaMesaDeAyuda">

                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Asunto</th>
                            <th>Tipo</th>
                            <th>Categoría</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Fecha</th>

                            @if (Model.PuedeGestionarTickets)
                            {
                                <th>SLA</th>
                            }

                            @if (Model.PuedeGestionarTickets)
                            {
                                <th>Técnico asignado</th>
                            }

                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Tickets.Any())
                        {
                            <tr>
                                <td colspan="@(Model.PuedeGestionarTickets ? 10 : 8)">

                                    <div class="sd-empty-pro">

                                        <div class="sd-empty-pro-illustration">
                                            <i class="bi bi-inbox"></i>
                                        </div>

                                        <div class="sd-empty-pro-title">
                                            No existen tickets registrados
                                        </div>

                                        <div class="sd-empty-pro-text">
                                            Crea un ticket para comenzar a utilizar la Mesa de Ayuda.
                                        </div>

                                        <button type="button"
                                                class="sd-btn-primary mt-3"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCrearTicket">

                                            <i class="bi bi-plus-lg me-1"></i>
                                            Crear Ticket

                                        </button>

                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var ticket in Model.Tickets)
                            {
                                string estado = ticket.Status?.Nombre ?? "";
                                string prioridad = ticket.Priority?.Codigo ?? "";
                                string estadoSla = Model.ObtenerEstadoSla(ticket, DateTime.Now);
                                string textoSla = estadoSla switch
                                {
                                    "vencido" => "Vencido",
                                    "proximo" => "Próximo a vencer",
                                    "vigente" => "Vigente",
                                    "pausado" => "Pausado",
                                    "finalizado" => "Finalizado",
                                    _ => "Sin SLA"
                                };

                                <tr data-folio="@ticket.Folio"
                                    data-titulo="@ticket.Titulo"
                                    data-estado="@estado"
                                    data-categoria="@ticket.Category?.Nombre"
                                    data-asignado="@(!string.IsNullOrWhiteSpace(ticket.UsuarioAsignadoId) ? "si" : "no")"
                                     data-status-id="@ticket.StatusId"
                                     data-sla="@estadoSla">

                                    <!-- FOLIO -->
                                    <td>
                                        <div class="sd-folio-wrap">
                                            <span class="sd-folio">@ticket.Folio</span>
                                        </div>
                                    </td>

                                    <!-- ASUNTO -->
                                    <td>
                                        <div class="sd-ticket-title">
                                            @ticket.Titulo
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(ticket.Subcategory?.Nombre))
                                        {
                                            <div class="sd-ticket-description">
                                                @ticket.Subcategory.Nombre
                                            </div>
                                        }
                                    </td>

                                    <!-- TIPO -->
                                    <td>
                                        <span class="sd-chip-light">
                                            @ticket.TicketType?.Nombre
                                        </span>
                                    </td>

                                    <!-- CATEGORÍA -->
                                    <td>
                                        @ticket.Category?.Nombre
                                    </td>

                                    <!-- PRIORIDAD -->
                                    <td>
                                        @if (prioridad == "CRITICA")
                                        {
                                            <span class="sd-priority sd-priority-critical">Crítica</span>
                                        }
                                        else if (prioridad == "ALTA")
                                        {
                                            <span class="sd-priority sd-priority-high">Alta</span>
                                        }
                                        else if (prioridad == "MEDIA")
                                        {
                                            <span class="sd-priority sd-priority-medium">Media</span>
                                        }
                                        else if (prioridad == "BAJA")
                                        {
                                            <span class="sd-priority sd-priority-low">Baja</span>
                                        }
                                        else
                                        {
                                            <span>@ticket.Priority?.Nombre</span>
                                        }
                                    </td>

                                    <!-- ESTADO -->
                                    <td>
                                        @if (ticket.StatusId == 1)
                                        {
                                            <span class="sd-badge sd-status-new">
                                                <i class="bi bi-circle-fill"></i> Nuevo
                                            </span>
                                        }
                                        else if (ticket.StatusId == 2)
                                        {
                                            <span class="sd-badge sd-status-assigned">
                                                <i class="bi bi-person-check"></i> Asignado
                                            </span>
                                        }
                                        else if (ticket.StatusId == 3)
                                        {
                                            <span class="sd-badge sd-status-progress">
                                                <i class="bi bi-gear"></i> En proceso
                                            </span>
                                        }
                                        else if (ticket.StatusId == 4)
                                        {
                                            <span class="sd-badge sd-status-waiting">
                                                <i class="bi bi-hourglass-split"></i> Pendiente usuario
                                            </span>
                                        }
                                        else if (ticket.StatusId == 5)
                                        {
                                            <span class="sd-badge sd-status-resolved">
                                                <i class="bi bi-check-circle"></i> Resuelto
                                            </span>
                                        }
                                        else if (ticket.StatusId == 6)
                                        {
                                            <span class="sd-badge sd-status-closed">
                                                <i class="bi bi-lock"></i> Cerrado
                                            </span>
                                        }
                                        else if (ticket.StatusId == 7)
                                        {
                                            <span class="sd-badge sd-status-reopened">
                                                <i class="bi bi-arrow-counterclockwise"></i> Reabierto
                                            </span>
                                        }
                                        else if (ticket.StatusId == 8)
                                        {
                                            <span class="sd-badge sd-status-cancelled">
                                                <i class="bi bi-x-circle"></i> Cancelado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sd-badge sd-status-new">
                                                @ticket.Status?.Nombre
                                            </span>
                                        }
                                    </td>

                                    <!-- FECHA -->
                                    <td>
                                        <div>@ticket.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                        <div class="sd-ticket-description">
                                            @ticket.FechaCreacion.ToString("HH:mm")
                                        </div>
                                    </td>

                                    @if (Model.PuedeGestionarTickets)
                                    {
                                        <td><span class="sd-sla-indicador @estadoSla" title="Estado de SLA al cargar la página">@textoSla</span></td>
                                    }

                                    <!-- TÉCNICO ASIGNADO -->
                                    @if (Model.PuedeGestionarTickets)
                                    {
                                        <td>

                                            @if (
                                                string.IsNullOrWhiteSpace(
                                                    ticket.UsuarioAsignadoId
                                                )
                                            )
                                            {
                                                <span class="sd-unassigned">

                                                    <i class="bi bi-person-x me-1"></i>

                                                    Sin asignar

                                                </span>
                                            }
                                            else
                                            {
                                                string nombreTecnico =
                                                    Model.NombresTecnicosAsignados
                                                        .TryGetValue(
                                                            ticket.UsuarioAsignadoId,
                                                            out string? nombre
                                                        )
                                                            ? nombre
                                                            : "Usuario asignado";


                                                <span class="sd-assigned">

                                                    <i class="bi bi-person-check me-1"></i>

                                                    @nombreTecnico

                                                </span>
                                            }

                                        </td>
                                    }

                                    <!-- ACCIONES -->
                                    <td class="text-center">
                                        <button type="button"
                                                class="sd-action"
                                                title="Ver ticket"
                                                data-ticket-id="@ticket.Id">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </section>

</div>


