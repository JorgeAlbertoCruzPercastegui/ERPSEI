                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="editFechaInicio" class="form-control" />
                                <label>Fecha Inicio</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="editFechaFin" class="form-control" />
                                <label>Fecha Término</label>
                            </div>
                        </div>

                        <div class="col-md-6 edit-horas">
                            <div class="form-floating mb-3">
                                <input type="time" id="editHoraInicio" class="form-control" />
                                <label>Hora Inicio</label>
                            </div>
                        </div>

                        <div class="col-md-6 edit-horas">
                            <div class="form-floating mb-3">
                                <input type="time" id="editHoraTermino" class="form-control" />
                                <label>Hora Término</label>
                            </div>
                        </div>

                        <div class="col-md-6 edit-dias">
                            <div class="form-floating mb-3">
                                <input type="number" step="0.1" id="editDias" class="form-control" />
                                <label>Días</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="editFechaAplicacion" class="form-control" />
                                <label>Fecha Aplicación</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" id="editNumeroFolio" class="form-control" />
                                <label>Número de Folio</label>
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center mb-3">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" id="editSuplencia">
                                <label class="form-check-label" for="editSuplencia">Activar Suplencia</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <textarea id="editComentario" class="form-control" style="height:120px;"></textarea>
                                <label>Comentario</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Cancelar</button>
                <button class="btn btn-primary" type="button" onclick="guardarEdicionAusencia()">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal resultado -->
