<!-- Modal detalle -->
<div class="modal fade" id="modalDetalleAusencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Detalle de ausencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6"><strong>Empleado:</strong> <span id="detEmpleado"></span></div>
                    <div class="col-md-6"><strong>Categoría:</strong> <span id="detCategoria"></span></div>
                    <div class="col-md-6"><strong>Tipo:</strong> <span id="detTipo"></span></div>
                    <div class="col-md-6"><strong>Estado:</strong> <span id="detEstado"></span></div>
                    <div class="col-md-6"><strong>Fecha inicio:</strong> <span id="detFechaInicio"></span></div>
                    <div class="col-md-6"><strong>Fecha fin:</strong> <span id="detFechaFin"></span></div>
                    <div class="col-md-6"><strong>Hora inicio:</strong> <span id="detHoraInicio"></span></div>
                    <div class="col-md-6"><strong>Hora término:</strong> <span id="detHoraTermino"></span></div>
                    <div class="col-md-6"><strong>Días:</strong> <span id="detDias"></span></div>
                    <div class="col-md-6"><strong>Horas:</strong> <span id="detHoras"></span></div>
                    <div class="col-md-6"><strong>Fecha aplicación:</strong> <span id="detFechaAplicacion"></span></div>
                    <div class="col-md-6"><strong>Suplencia:</strong> <span id="detSuplencia"></span></div>
                    <div class="col-md-6"><strong>Folio:</strong> <span id="detFolio"></span></div>
                    <div class="col-md-6"><strong>Creado por:</strong> <span id="detUsuarioCreador"></span></div>
                    <div class="col-12"><strong>Comentario:</strong> <div id="detComentario" class="border rounded p-3 bg-light mt-1"></div></div>
                    <div class="col-12">
                        <strong>Documentos adjuntos:</strong>
                        <div id="detDocumentos" class="border rounded p-3 bg-light mt-1">
                            Sin documentos adjuntos.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div id="detalleAccionesAprobacion" class="d-flex gap-2 flex-wrap"></div>
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal editar -->
<div class="modal fade" id="modalEditarAusencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Editar ausencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarAusencia" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
