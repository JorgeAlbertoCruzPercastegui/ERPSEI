@page "{handler?}"
@model ERPSEI.Areas.ERP.Pages.AusenciasModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Ausencias";
    ViewData["BodyClass"] = "vacaciones-page";

    IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();
    System.Globalization.CultureInfo? culture = rqf != null
        ? rqf.RequestCulture.Culture
        : new System.Globalization.CultureInfo("es-MX");

    string cultureName = culture.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Vacaciones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CatalogosBase.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Ausencias.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.min.css" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
}

<div class="ausencias-module">
    <h3 class="title mb-4">Ausencias</h3>

    <div class="d-flex justify-content-end gap-2 mb-3 flex-wrap">
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Registrar Ausencia
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" onclick="abrirModalInasistencia()">Inasistencia</a></li>
                <li><a class="dropdown-item" href="#" onclick="abrirModalIncapacidad()">Incapacidades</a></li>
                <li><a class="dropdown-item" href="#" onclick="abrirModalPermiso()">Permisos</a></li>
            </ul>
        </div>

        <button class="btn btn-primary" type="button" onclick="abrirModalSolicitarPermiso()">
            Solicitar Permiso
        </button>

        @if (Model.PuedeExportarDetalleAusencias)
        {
            <button class="btn btn-success" type="button" onclick="exportarDetalleAusencias()">
                <i class="bi bi-file-earmark-excel"></i> Exportar detalle
            </button>
        }
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Días</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="card-body">
            <table id="tableAusenciasDias"
                   class="table-sm"
                   data-unique-id="id"
                   data-search="false"
                   data-pagination="true"
                   data-page-list="[10,25,50,100,'all']"
                   data-side-pagination="client"
                   data-url="/ERP/Ausencias?handler=AusenciasDias">
                <thead><tr></tr></thead>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Horas</span>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="card-body">
            <table id="tableAusenciasHoras"
                   class="table-sm"
                   data-unique-id="id"
                   data-search="true"
                   data-pagination="true"
                   data-page-list="[10,25,50,100,all]"
                   data-side-pagination="client"
                   data-url="/ERP/Ausencias?handler=AusenciasHoras">
                <thead><tr></tr></thead>
            </table>
        </div>
    </div>

    @if (Model.PuedeAprobarJefeDirecto || Model.PuedeAprobarTH)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Solicitudes por autorizar</span>
                <i class="bi bi-chevron-down"></i>
            </div>
            <div class="card-body">
                <table id="tableAusenciasAutorizar"
                       class="table-sm"
                       data-unique-id="id"
                       data-search="true"
                       data-pagination="true"
                       data-page-list="[10,25,50,100,'all']"
                       data-side-pagination="client"
                       data-url="/ERP/Ausencias?handler=AusenciasPendientesJefe">
                    <thead><tr></tr></thead>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Inasistencia -->
<div class="modal fade" id="modalInasistencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Registrar Inasistencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formInasistencia" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="inpInasistenciaFechaInicio" class="form-control" />
                                <label>Fecha Inicio</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="inpInasistenciaFechaFin" class="form-control" />
                                <label>Fecha Término</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="number" step="0.1" id="inpInasistenciaDias" class="form-control" />
                                <label>Días Aporte</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="date" id="inpInasistenciaFechaAplicacion" class="form-control" />
                                <label>Inicio Fecha Aplicación</label>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkSuplenciaInasistencia">
                                <label class="form-check-label" for="chkSuplenciaInasistencia">Activar Suplencia</label>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                Estás registrando <span id="lblDiasInasistencia">0</span> días de inasistencia
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <textarea id="txtComentarioInasistencia" class="form-control" style="height:120px;"></textarea>
                                <label>Comentario</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Justificantes (PDF)</label>
                            <input type="file"
                                   id="inpDocumentosInasistencia"
                                   class="form-control"
                                   accept=".pdf,application/pdf"
                                   multiple />
                            <small class="text-muted">Puedes adjuntar uno o varios archivos PDF.</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Cancelar</button>
                <button class="btn btn-primary" type="button" onclick="guardarInasistencia()">Agregar</button>
            </div>
        </div>
    </div>
</div>

