@page "{handler?}"
@model ERPSEI.Areas.Catalogos.Pages.GestorEventos.IndexModel
@{
    ViewData["Title"] = "Gestor Eventos";
    ViewData["BodyClass"] = "gestoreventos-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/GestorEventos.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<div class="gestoreventos-theme-page">
    <div class="module-shell">

        <div class="module-header mb-4">
            <h2 class="module-title mb-1">Gestor Eventos</h2>
            <p class="module-subtitle mb-0">Administra los eventos que se mostrarán en la intranet.</p>
        </div>

        <div class="module-card mb-4">
            <div class="card-body">
                <form id="formEvento" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Input_Id" name="Input.Id" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Título</label>
                            <input type="text" class="form-control" id="Input_Titulo" name="Input.Titulo" maxlength="250" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Tipo de evento</label>
                            <select class="form-select" id="Input_TipoEvento" name="Input.TipoEvento">
                                <option value="">Selecciona</option>
                                <option value="Corporativo">Corporativo</option>
                                <option value="Fiesta">Fiesta</option>
                                <option value="Integración">Integración</option>
                                <option value="Capacitación">Capacitación</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="Input_Descripcion" name="Input.Descripcion" rows="4"></textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha del evento</label>
                            <input type="date" class="form-control" id="Input_FechaEvento" name="Input.FechaEvento" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Hora del evento</label>
                            <input type="time" class="form-control" id="Input_HoraEvento" name="Input.HoraEvento" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Publicación programada</label>
                            <input type="datetime-local" class="form-control" id="Input_FechaPublicacionProgramada" name="Input.FechaPublicacionProgramada" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">URL formulario / inscripción</label>
                            <input type="text" class="form-control" id="Input_UrlFormulario" name="Input.UrlFormulario" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Portada</label>
                            <input type="file" class="form-control" id="Input_Portada" name="Input.Portada" accept=".jpg,.jpeg,.png,.webp" onchange="previewPortadaEvento(this)" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Región</label>
                            <input type="text" class="form-control" id="Input_Region" name="Input.Region" />
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch pt-2">
                                <input class="form-check-input" type="checkbox" id="Input_RequiereGeolocalizacion" name="Input.RequiereGeolocalizacion" value="true">
                                <label class="form-check-label" for="Input_RequiereGeolocalizacion">Requiere geolocalización</label>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Vista previa</label>
                            <div class="preview-box">
                                <img id="previewPortadaEvento" alt="Vista previa evento" />
                                <span id="previewPortadaEventoTexto">Selecciona una portada</span>
                            </div>
                        </div>

                        <div class="col-md-12 d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary" onclick="limpiarFormularioEvento()">Limpiar</button>
                            <button type="button" class="btn btn-outline-primary" onclick="guardarEvento(false)">Guardar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="module-card">
            <div class="card-body pb-0">
                <h5 class="module-card-title mb-3">Registros cargados</h5>
            </div>

            <div class="table-responsive">
                <table id="tableEventos"
                       class="table table-hover align-middle"
                       data-toggle="table"
                       data-search="true"
                       data-pagination="true"
                       data-page-size="10"
                       data-page-list="[10,25,50,100]"
                       data-url="/Catalogos/GestorEventos/EventosList">
                    <thead>
                        <tr>
                            <th data-field="id" data-visible="false">Id</th>
                            <th data-field="titulo">Título</th>
                            <th data-field="tipoEvento">Tipo</th>
                            <th data-field="fechaEvento">Fecha</th>
                            <th data-field="horaEvento">Hora</th>
                            <th data-field="estatus" data-formatter="estatusEventoFormatter">Estatus</th>
                            <th data-field="estadoPublicacion" data-formatter="publicacionEventoFormatter">Publicación</th>
                            <th data-field="rutaPortada" data-formatter="vistaEventoFormatter">Vista</th>
                            <th data-field="id" data-formatter="accionesEventoFormatter">Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="resultadoEventoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content custom-modal-content">
            <div class="modal-header modal-header-gold">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div id="resultadoEventoMensaje" class="fw-semibold"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/bootstrap-table.min.js"></script>
    <script src="https://unpkg.com/bootstrap-table@1.22.6/dist/locale/bootstrap-table-es-MX.min.js"></script>
    <script src="~/js/GestorEventos.js" asp-append-version="true"></script>
}