@page "{handler?}"
@using ERPSEI.Data.Managers;
@using Microsoft.AspNetCore.Localization;
@using Microsoft.AspNetCore.Mvc.Localization;
@using ERPSEI.Areas.Catalogos.Pages;
@using ERPSEI.Data.Entities.Empresas;
@using ERPSEI.Data.Entities.SAT;
@using ERPSEI.Data.Entities.SAT.Catalogos;
@using ERPSEI.Data.Managers.Usuarios;
@using ERPSEI.Data.Entities.Usuarios;
@using ERPSEI.Data.Managers.Empresas;
@model EmpresasModel
@inject IViewLocalizer Localizer;
@inject IPerfilManager PerfilesManager;
@inject IRWCatalogoManager<Origen> OrigenesManager;
@inject IRWCatalogoManager<Nivel> NivelesManager;
@inject IRWCatalogoManager<ActividadEconomica> ActividadesEconomicasManager;
@inject AppRoleManager RolesManager;
@inject AppUserManager UsuariosManager;
@inject IAccesoModuloManager AccesosModulosManager;
@{
	ViewData["Title"] = Localizer["Title"];
	ViewData["BodyClass"] = "empresas-page";

	// Retrieves the requested culture
	IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();

	// Culture contains the information of the requested culture
	System.Globalization.CultureInfo? culture = rqf != null ? rqf.RequestCulture.Culture : new System.Globalization.CultureInfo("es-MX");

	string cultureName = culture.Name;

	List<Perfil> perfiles = await PerfilesManager.GetAllAsync();
	List<Origen> origenes = await OrigenesManager.GetAllAsync();
	List<Nivel> niveles = await NivelesManager.GetAllAsync();
	List<ActividadEconomica> actividadesEconomicas = await ActividadesEconomicasManager.GetAllAsync();

	bool puedeTodo = User.Claims.Where(c => c.Type.Equals("PuedeTodo", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeConsultar = User.Claims.Where(c => c.Type.Equals("PuedeConsultar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeEditar = User.Claims.Where(c => c.Type.Equals("PuedeEditar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeEliminar = User.Claims.Where(c => c.Type.Equals("PuedeEliminar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeAutorizar = User.Claims.Where(c => c.Type.Equals("PuedeAutorizar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";

	bool puedeTodoBancos = User.Claims.Where(c => c.Type.Equals("PuedeTodoBancos", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeConsultarBancos = User.Claims.Where(c => c.Type.Equals("PuedeConsultarBancos", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeEditarBancos = User.Claims.Where(c => c.Type.Equals("PuedeEditarBancos", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeEliminarBancos = User.Claims.Where(c => c.Type.Equals("PuedeEliminarBancos", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
	bool puedeAutorizarBancos = User.Claims.Where(c => c.Type.Equals("PuedeAutorizarBancos", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";

	bool tieneAccesoEmpresas = puedeTodo || puedeConsultar || puedeEditar;
	bool tieneAccesoBancos = puedeTodoBancos || puedeConsultarBancos || puedeEditarBancos;
}

@section Styles {
	<link rel="stylesheet" href="~/css/Empresas.css" asp-append-version="true" />
	<style>
		/* HU2: acciones de la tabla alineadas con separación uniforme */
		#toolbar {
			display: inline-flex;
			align-items: center;
			flex-wrap: wrap;
			gap: .5rem;
		}

		#toolbar > button {
			margin: 0 !important;
		}

		/* HU2: encabezado corporativo de duplicados */
		#dlgDuplicadosHU2 .modal-header {
			background-color: #1557a5 !important;
			color: #fff !important;
			border-bottom: 0;
			padding: 1rem 1.25rem;
		}

		#dlgDuplicadosHU2 .modal-header .modal-title,
		#dlgDuplicadosHU2 .modal-header small {
			color: #fff !important;
		}

		#dlgDuplicadosHU2 .modal-header small {
			opacity: .9;
		}

        /* HU2: botones alineados, incluida la regla general */
        #toolbar .hu2-toolbar-text { white-space: nowrap; }
        #toolbar { column-gap: .5rem !important; row-gap: .5rem !important; }

        /* HU2: identificación visual de documentos obligatorios */
        #bodyArchivos .hu2-documento-obligatorio > .hu2-tipo-titulo,
        #bodyArchivosSAT .hu2-documento-obligatorio > .hu2-tipo-titulo {
            color: #21166f; display: flex; align-items: center; gap: .4rem;
            flex-wrap: wrap;
        }
        .hu2-etiqueta-requerido {
            display: inline-flex; align-items: center; padding: .15rem .5rem;
            border-radius: 999px; background: #21166f; color: white;
            font-size: .7rem; font-weight: 600; letter-spacing: .01em;
        }
        #bodyArchivos .hu2-documento-obligatorio > .hu2-document-card,
        #bodyArchivosSAT .hu2-documento-obligatorio > .hu2-document-card {
            border: 1.5px solid #5a4bb7 !important;
            border-left: 5px solid #21166f !important;
            background: #f3f1ff !important;
            box-shadow: 0 2px 9px rgba(33,22,111,.07);
        }
        #bodyArchivos .hu2-documento-obligatorio.hu2-documento-pendiente > .hu2-document-card,
        #bodyArchivosSAT .hu2-documento-obligatorio.hu2-documento-pendiente > .hu2-document-card {
            border-style: dashed !important;
            border-left-style: solid !important;
        }

        /* HU2: modal de obligatoriedad por empresa (sin cerrar modal principal) */
        #hu2ModalObligatorios {
            position: fixed; inset: 0; z-index: 2000; display: flex;
            align-items: center; justify-content: center; padding: 1rem;
            background: rgba(15, 23, 42, .65);
        }
        #hu2ModalObligatorios.d-none { display: none !important; }
        #hu2ModalObligatorios .hu2-modal-panel {
            width: min(100%, 940px); max-height: min(90vh, 800px);
            display: flex; flex-direction: column; overflow: hidden;
            background: #fff; border-radius: 1rem; box-shadow: 0 24px 70px rgba(0,0,0,.3);
        }
        #hu2ModalObligatorios .hu2-modal-head {
            background: #21166f; color: #fff; padding: 1.1rem 1.4rem;
        }
        #hu2ModalObligatorios .hu2-modal-head .btn-close { filter: invert(1) grayscale(1) brightness(2); opacity: 1; }
        #hu2ModalObligatorios .hu2-modal-body { padding: 1.25rem; overflow-y: auto; }
        #hu2ModalObligatorios .hu2-document-grid {
            display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .65rem;
        }
        #hu2ModalObligatorios .hu2-document-item {
            display: flex; gap: .65rem; align-items: flex-start; padding: .75rem;
            border: 1px solid #dde2ed; border-radius: .65rem; cursor: pointer;
        }
        #hu2ModalObligatorios .hu2-document-item:has(input:checked) {
            border-color: #21166f; background: #f1efff;
        }
        #hu2ModalObligatorios .hu2-document-item input { margin-top: .2rem; flex-shrink: 0; }
        #hu2ModalObligatorios .hu2-modal-foot {
            padding: 1rem 1.25rem; border-top: 1px solid #e9ecef;
            display: flex; gap: .5rem; justify-content: flex-end; flex-wrap: wrap;
        }
        @@media (max-width: 650px) {
            #hu2ModalObligatorios .hu2-document-grid { grid-template-columns: 1fr; }
            #hu2ModalObligatorios .hu2-modal-body { padding: .9rem; }
        }
	</style>
}

<h3 class="title mb-3">@ViewData["Title"]</h3>

<!-- --------------------------- -->
<!-- Sección de filtros -------- -->
<div class="accordion shadow mb-5" id="accordionFiltros">
	<div class="accordion-item">
		<h2 class="accordion-header" id="headingOne">
			<button class="accordion-button p-2 bg-gradient bg-primary bg-opacity-10 text-black" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
				<h6>@Localizer["FilterTitle"]</h6>
			</button>
		</h2>
		<div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFiltros">
			<div class="accordion-body">
				<form id="filtros" method="post">
					<div class="row">
						<div class="col-sm-6 col-md-6 col-lg-4">
							<div class="form-floating mb-3">
								<select id="selFiltroOrigen" asp-for="InputFiltro.OrigenId" class="form-select" placeholder="@Localizer["OrigenPlaceholder"]">
									<option value="0">Seleccione...</option>
									@{
										foreach (Origen origen in origenes)
										{
											<option value='@origen.Id'>@origen.Nombre</option>
										}
									}
								</select>
								<label for="selFiltroOrigen" asp-for="InputFiltro.OrigenId" class="form-label"></label>
							</div>
						</div>
						<div class="col-sm-6 col-md-6 col-lg-4">
							<div class="form-floating mb-3">
								<select id="selFiltroNivel" asp-for="InputFiltro.NivelId" class="form-select" placeholder="@Localizer["NivelPlaceholder"]">
									<option value="0">Seleccione...</option>
									@{
										foreach (Nivel nivel in niveles)
										{
											<option value='@nivel.Id'>@nivel.Nombre</option>
										}
									}
								</select>
								<label for="selFiltroNivel" asp-for="InputFiltro.NivelId" class="form-label"></label>
							</div>
						</div>
						<div class="col-sm-6 col-md-6 col-lg-4">
							<div class="form-floating mb-3">
								<input id="inpFiltroActividadEconomica" type="search" asp-for="InputFiltro.ActividadEconomicaId" class="form-control" placeholder="@Localizer["ActividadEconomicaPlaceholder"]" idselected='' area="Catalogos" module="Empresas" source="GetActividadesEconomicasSuggestion" />
								<label for="inpFiltroActividadEconomica" asp-for="InputFiltro.ActividadEconomicaId" class="form-label"></label>
							</div>
						</div>
						<div class="col-sm-6 col-md-6 col-lg-4">
							<div class="form-floating mb-3">
								<input id="inpFiltroRFC" type="search" asp-for="InputFiltro.RFC" class="form-control" placeholder="@Localizer["RFCPlaceholder"]" />
								<label for="inpFiltroRFC" asp-for="InputFiltro.RFC" class="form-label"></label>
							</div>
						</div>

						<div class="col-sm-6 col-md-6 col-lg-4">
							<div class="form-floating mb-3">
								<select id="selFiltroEstatus" asp-for="InputFiltro.Deshabilitado" class="form-select">
									<option value="">Todas</option>
									<option value="0">Activas</option>
									<option value="1">Inactivas</option>
								</select>
								<label for="selFiltroEstatus">Estatus</label>
							</div>
						</div>
					</div>
				</form>
				@if (puedeTodo || puedeConsultar || puedeEditar || puedeEliminar || puedeTodoBancos || puedeConsultarBancos || puedeEditarBancos || puedeEliminarBancos)
				{
					<div class="row text-end">
						<div class="col-12">
							<button id="btnBuscar" class="btn btn-primary" onclick="onBuscarClick();">
								<i class="bi bi-search"></i> @Localizer["SearchButton"]
							</button>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
