@page
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model LoginModel

@{
    ViewData["Title"] = Localizer["Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
}

<div class="login-page">

    <section class="login-brand">

        <div class="brand-wrap">
            <h1 class="brand-title">INTRANET</h1>

            <img class="login-logo"
                 src="~/img/Logo.png"
                 asp-append-version="true" />
        </div>
        <a class="privacy-link" asp-area="" asp-page="/Privacy">
            <i class="bi bi-shield-fill-check"></i>
            Aviso de privacidad
        </a>
    </section>

    <section class="login-panel">
        <div class="login-top-link">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Iniciar Sesión</span>
        </div>

        <form id="account" method="post" class="login-form">
            <h1>@ViewData["Title"]</h1>
            <div class="login-line"></div>

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-4">
                <input id="userEmail"
                       asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="@Localizer["EmailPlaceholder"]" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3 position-relative">
                <input id="userPassword"
                       asp-for="Input.Password"
                       type="password"
                       class="form-control pe-5"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="@Localizer["PasswordPlaceholder"]" />

                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <button type="button"
                        id="btnTogglePwd"
                        class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-3 p-0"
                        aria-label="Mostrar u ocultar contraseña"
                        tabindex="-1">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe"></label>
            </div>

            <button id="login-submit" type="submit" class="btn login-btn w-100">
                @Localizer["LoginButton"]
            </button>

            <div class="login-links mt-4">
                <p>
                    <a id="forgot-password" asp-page="./ForgotPassword">@Localizer["ForgotLink"]</a>
                </p>
                <p>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Localizer["ResendLink"]</a>
                </p>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("btnTogglePwd");
            const input = document.getElementById("userPassword");
            const icon = btn?.querySelector("i");

            if (!btn || !input || !icon) return;

            btn.addEventListener("click", function () {
                const isPassword = input.type === "password";

                input.type = isPassword ? "text" : "password";

                icon.classList.toggle("bi-eye", !isPassword);
                icon.classList.toggle("bi-eye-slash", isPassword);
            });
        });
    </script>
}