@page
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model ResetPasswordModel
@{
    ViewData["Title"] = Localizer["Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/password-rules.css" />
}

<h1>@ViewData["Title"]</h1>
<h2>@Localizer["SecondaryTitle"].</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="@Localizer["EmailPlaceholder"]" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <!--<div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["PasswordPlaceholder"]." />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>-->
            <div class="form-floating mb-3 position-relative">
                <input id="userPassword"
                       asp-for="Input.Password"
                       type="password"
                       class="form-control pe-5"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Contraseña" />

                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <button type="button"
                        id="btnTogglePwd"
                        class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-2 p-0"
                        aria-label="Mostrar u ocultar contraseña"
                        tabindex="-1">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["PasswordConfirmationPlaceholder"]." />
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div id="pwdRules" class="pwd-rules mt-3 d-none">
                <div class="pwd-rules-title">Contraseña</div>

                <ul class="pwd-rules-list mb-0">
                    <li id="rule-digit" class="rule">
                        <i class="bi bi-check-circle-fill"></i>
                        un número de 0 a 9.
                    </li>
                    <li id="rule-special" class="rule">
                        <i class="bi bi-check-circle-fill"></i>
                        un carácter especial <span class="muted">!#$%^&*</span>.
                    </li>
                    <li id="rule-upper" class="rule">
                        <i class="bi bi-check-circle-fill"></i>
                        una letra en mayúscula.
                    </li>
                    <li id="rule-length" class="rule">
                        <i class="bi bi-check-circle-fill"></i>
                        mínimo 8 caracteres.
                    </li>
                </ul>
            </div>
            <br/>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["ResetButton"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-rules.js"></script>

}
