@page
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model LogoutModel

@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["BodyClass"] = "logout-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Logout.css" asp-append-version="true" />
}

<div class="logout-page-shell">
    <div class="logout-card">
        <div class="logout-card-inner">

            <div class="logout-brand-panel">
                <img class="logout-brand-logo"
                     src="@this.HttpContext.Request.Scheme://@this.HttpContext.Request.Host/img/Logo.png"
                     alt="Intranet SEI" />
            </div>

            <div class="logout-form-panel">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                          method="post"
                          class="logout-form">

                        <h2 class="logout-title">@ViewData["Title"]</h2>
                        <div class="logout-title-line"></div>

                        <div class="logout-message-box">
                            <div class="logout-main-text">
                                @Localizer["LogoutInstructionA"]
                            </div>

                            <div class="logout-sub-text">
                                @Localizer["LogoutInstructionB"]
                            </div>
                        </div>

                        <div class="logout-actions">
                            <button type="submit" class="w-100 btn btn-lg btn-primary logout-submit-btn">
                                @Localizer["LogoutButton"]
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="logout-form">
                        <h2 class="logout-title">@ViewData["Title"]</h2>
                        <div class="logout-title-line"></div>

                        <div class="logout-message-box">
                            <div class="logout-main-text">
                                @Localizer["LogoutMessage"].
                            </div>
                        </div>

                        <div class="logout-actions">
                            <a asp-page="/Account/Login" class="w-100 btn btn-lg btn-primary logout-submit-btn">
                                Iniciar sesión
                            </a>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>