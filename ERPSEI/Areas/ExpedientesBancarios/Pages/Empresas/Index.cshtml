@page
@model ERPSEI.Areas.ExpedientesBancarios.Pages.Empresas.IndexModel

@{
    ViewData["Title"] = "Empresas - Expedientes Bancarios";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/expedientes-bancarios.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-table/bootstrap-table.min.css"
          asp-append-version="true" />
}

<div class="eb-container">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->
    <div class="eb-page-header">
        <div>
            <h1 class="eb-page-title">
                Empresas
            </h1>

            <p class="eb-page-subtitle">
                Administración de empresas y expedientes bancarios.
            </p>
        </div>
    </div>

    <!-- =====================================================
         FILTROS
         ===================================================== -->
    <div class="eb-card mb-4">

        <div class="eb-card-header">
            <h2>
                <i class="fa-solid fa-filter me-2"></i>
                Filtros de búsqueda
            </h2>
        </div>

        <div class="eb-card-body">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-7">
                    <label for="filtroBusqueda"
                           class="form-label">
                        Buscar empresa
                    </label>

                    <input type="text"
                           id="filtroBusqueda"
                           class="form-control"
                           placeholder="Razón social, nombre corto, RFC o nivel"
                           autocomplete="off" />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="filtroEstatus"
                           class="form-label">
                        Estatus
                    </label>

                    <select id="filtroEstatus"
                            class="form-select">

                        <option value="Activas" selected>
                            Activas
                        </option>

                        <option value="Inactivas">
                            Inactivas
                        </option>

                        <option value="Todas">
                            Todas
                        </option>

                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2 d-grid">
                    <button type="button"
                            id="btnBuscarEmpresas"
                            class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass me-1"></i>
                        Buscar
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- =====================================================
         TOOLBAR DEL DATATABLE
         ===================================================== -->
    <div id="toolbarEmpresas"
         class="eb-toolbar">

        <button type="button"
                id="btnNuevaEmpresa"
                class="btn eb-toolbar-action"
                title="Nueva empresa"
                aria-label="Nueva empresa">

            <span class="eb-toolbar-plus"
                  aria-hidden="true"></span>
        </button>

        <button type="button"
                id="btnEliminarSeleccionadas"
                class="btn eb-toolbar-action"
                title="Eliminar empresas seleccionadas"
                aria-label="Eliminar empresas seleccionadas"
                disabled>

            <span class="eb-toolbar-trash"
                  aria-hidden="true"></span>
        </button>

    </div>

    <!-- =====================================================
         TABLA
         ===================================================== -->
    <div class="eb-card">

        <div class="eb-card-body p-0">

            <table id="tablaEmpresas"
                   class="table">

                <thead>
                    <tr>
                        <th data-field="state"
                            data-checkbox="true">
                        </th>

                        <th data-field="id"
                            data-sortable="true">
                            Id
                        </th>

                        <th data-field="razonSocial"
                            data-sortable="true">
                            Razón social
                        </th>

                        <th data-field="nombreCorto"
                            data-sortable="true">
                            Nombre corto
                        </th>

                        <th data-field="rfc"
                            data-sortable="true">
                            RFC
                        </th>

                        <th data-field="nivel"
                            data-sortable="true">
                            Nivel
                        </th>

                        <th data-field="deshabilitado"
                            data-align="center"
                            data-formatter="estatusEmpresaFormatter">
                            Estatus
                        </th>

                        <th data-field="acciones"
                            data-align="center"
                            data-formatter="accionesEmpresaFormatter">
                            Acciones
                        </th>
                    </tr>
                </thead>

            </table>

        </div>
    </div>

</div>

<!-- =========================================================
     MODAL CREAR / EDITAR / CONSULTAR EMPRESA
     ========================================================= -->
<div class="modal fade"
     id="modalEmpresa"
     tabindex="-1"
     aria-labelledby="modalEmpresaTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalEmpresaTitulo">
                        Empresa
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Información corporativa para el expediente bancario.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <form id="formEmpresa"
                      autocomplete="off">

                    <input type="hidden"
                           id="ebId"
                           value="0" />

                    <div class="row g-4">

                        <!-- Razón social -->
                        <div class="col-12 col-lg-8">

                            <label for="ebRazonSocial"
                                   class="form-label eb-required">
                                Razón social
                            </label>

                            <input type="text"
                                   id="ebRazonSocial"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Ej. Empresa Comercializadora, S.A. de C.V."
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="RazonSocial"></span>

                        </div>

                        <!-- Nombre corto -->
                        <div class="col-12 col-lg-4">

                            <label for="ebNombreCorto"
                                   class="form-label eb-required">
                                Nombre corto
                            </label>

                            <input type="text"
                                   id="ebNombreCorto"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Ej. Comercializadora"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="NombreCorto"></span>

                        </div>

                        <!-- RFC -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebRfc"
                                   class="form-label eb-required">
                                RFC
                            </label>

                            <input type="text"
                                   id="ebRfc"
                                   class="form-control text-uppercase"
                                   maxlength="13"
                                   placeholder="Ej. ABC010203XYZ"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="Rfc"></span>

                        </div>

                        <!-- Nivel -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebNivel"
                                   class="form-label">
                                Nivel
                            </label>

                            <input type="text"
                                   id="ebNivel"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Ej. Nivel 1"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="Nivel"></span>

                        </div>

                        <!-- Fecha constitución -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebFechaConstitucion"
                                   class="form-label">
                                Fecha de constitución
                            </label>

                            <input type="date"
                                   id="ebFechaConstitucion"
                                   class="form-control" />

                            <span class="text-danger"
                                  data-error-for="FechaConstitucion"></span>

                        </div>

                        <!-- Actividad comercial -->
                        <div class="col-12">

                            <label for="ebActividadComercial"
                                   class="form-label">
                                Actividad comercial
                            </label>

                            <textarea id="ebActividadComercial"
                                      class="form-control"
                                      maxlength="500"
                                      rows="3"
                                      placeholder="Describe la actividad comercial principal de la empresa"></textarea>

                            <span class="text-danger"
                                  data-error-for="ActividadComercial"></span>

                        </div>

                        <!-- Teléfono -->
                        <div class="col-12 col-md-6">

                            <label for="ebTelefonoBancos"
                                   class="form-label">
                                Teléfono de bancos
                            </label>

                            <input type="text"
                                   id="ebTelefonoBancos"
                                   class="form-control"
                                   maxlength="30"
                                   placeholder="Ej. 55 1234 5678"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="TelefonoBancos"></span>

                        </div>

                        <!-- Correo -->
                        <div class="col-12 col-md-6">

                            <label for="ebCorreoBancos"
                                   class="form-label">
                                Correo de bancos
                            </label>

                            <input type="email"
                                   id="ebCorreoBancos"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Ej. bancos@empresa.com"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="CorreoBancos"></span>

                        </div>

                        <!-- Escritura -->
                        <div class="col-12">

                            <label for="ebNumeroEscritura"
                                   class="form-label">
                                Número de escritura
                            </label>

                            <input type="text"
                                   id="ebNumeroEscritura"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Número de escritura o instrumentos relacionados"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="NumeroEscritura"></span>

                        </div>

                        <!-- Domicilio fiscal -->
                        <div class="col-12">

                            <label for="ebDomicilioFiscal"
                                   class="form-label">
                                Domicilio fiscal
                            </label>

                            <textarea id="ebDomicilioFiscal"
                                      class="form-control"
                                      maxlength="500"
                                      rows="3"
                                      placeholder="Calle, número, colonia, municipio, estado y código postal"></textarea>

                            <span class="text-danger"
                                  data-error-for="DomicilioFiscal"></span>

                        </div>

                        <!-- Observaciones -->
                        <div class="col-12">

                            <label for="ebObservaciones"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="ebObservaciones"
                                      class="form-control"
                                      maxlength="1000"
                                      rows="3"
                                      placeholder="Información complementaria de la empresa"></textarea>

                            <span class="text-danger"
                                  data-error-for="Observaciones"></span>

                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        id="btnGuardarEmpresa"
                        class="btn btn-primary">

                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Guardar empresa
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL DE ACCIONISTAS
     ========================================================= -->
<div class="modal fade"
     id="modalAccionistas"
     tabindex="-1"
     aria-labelledby="modalAccionistasTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalAccionistasTitulo">
                        Accionistas
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Empresa:
                        <strong id="nombreEmpresaAccionistas"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <!-- Resumen -->
                <div class="eb-shareholder-summary">

                    <div class="eb-shareholder-kpi">
                        <span>Total de accionistas</span>
                        <strong id="totalAccionistas">
                            0
                        </strong>
                    </div>

                    <div class="eb-shareholder-kpi">
                        <span>Participación registrada</span>
                        <strong id="porcentajeRegistrado">
                            0.0000 %
                        </strong>
                    </div>

                    <div class="eb-shareholder-kpi">
                        <span>Participación disponible</span>
                        <strong id="porcentajeDisponible">
                            100.0000 %
                        </strong>
                    </div>

                </div>

                <!-- Barra de acciones -->
                <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-2 mb-3">

                    <div>
                        <h6 class="mb-1 eb-section-title">
                            Accionistas registrados
                        </h6>

                        <p class="text-muted small mb-0">
                            La participación activa no puede superar el 100 %.
                        </p>
                    </div>

                    <button type="button"
                            id="btnNuevoAccionista"
                            class="btn btn-primary">

                        <i class="fa-solid fa-plus me-1"></i>
                        Nuevo accionista
                    </button>

                </div>

                <!-- Cargando -->
                <div id="accionistasCargando"
                     class="eb-loading-state">

                    <div class="spinner-border"
                         role="status"
                         aria-hidden="true">
                    </div>

                    <span>
                        Consultando accionistas...
                    </span>
                </div>

                <!-- Error -->
                <div id="accionistasError"
                     class="alert alert-danger d-none"
                     role="alert">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    <span id="accionistasErrorMensaje">
                        No fue posible consultar los accionistas.
                    </span>
                </div>

                <!-- Estado vacío -->
                <div id="accionistasEstadoVacio"
                     class="eb-empty-state d-none">

                    <div class="eb-empty-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h3>
                        No hay accionistas registrados
                    </h3>

                    <p>
                        Registra el primer accionista de esta empresa.
                    </p>

                </div>

                <!-- Tabla -->
                <div id="contenedorTablaAccionistas"
                     class="table-responsive eb-shareholder-table-wrap d-none">

                    <table class="table eb-shareholder-table">

                        <thead>
                            <tr>
                                <th>Nombre completo</th>
                                <th>RFC</th>
                                <th class="text-end">Participación</th>
                                <th>Nacionalidad</th>
                                <th class="text-center">
                                    Representante legal
                                </th>
                                <th class="text-center">Estatus</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody id="tablaAccionistasBody">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL EXPEDIENTE DOCUMENTAL
     ========================================================= -->
<div class="modal fade"
     id="modalDocumentos"
     tabindex="-1"
     aria-labelledby="modalDocumentosTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content eb-documents-modal eb-documents-modal-redesign">

            <div class="modal-header eb-documents-header">

                <div>
                    <h5 class="modal-title"
                        id="modalDocumentosTitulo">
                        Expediente documental
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Empresa:
                        <strong id="nombreEmpresaDocumentos"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body eb-documents-body">

                <!-- =============================================
                     INFORMACIÓN CORPORATIVA
                     ============================================= -->
                <section class="eb-document-section eb-corporate-section">

                    <div class="eb-document-section-heading">
                        <div>
                            <h6>
                                Información corporativa
                            </h6>

                            <p>
                                Datos generales registrados para la empresa.
                            </p>
                        </div>

                        <span class="eb-section-icon">
                            <i class="fa-regular fa-building"></i>
                        </span>
                    </div>

                    <div class="eb-corporate-information-grid">

                        <div class="eb-corporate-information-item">
                            <span>Nombre completo</span>
                            <strong id="documentoEmpresaNombre">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>RFC</span>
                            <strong id="documentoEmpresaRfc">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Nivel</span>
                            <strong id="documentoEmpresaNivel">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Actividad comercial</span>
                            <strong id="documentoEmpresaActividad">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Teléfono de bancos</span>
                            <strong id="documentoEmpresaTelefono">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Correo de bancos</span>
                            <strong id="documentoEmpresaCorreo">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Fecha de constitución</span>
                            <strong id="documentoEmpresaFechaConstitucion">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Número de escritura</span>
                            <strong id="documentoEmpresaEscritura">-</strong>
                        </div>

                        <div class="eb-corporate-information-item">
                            <span>Accionistas y participación</span>
                            <strong id="documentoEmpresaAccionistas">-</strong>
                        </div>

                    </div>

                </section>

                <!-- =============================================
                     INDICADORES
                     ============================================= -->
                <section class="eb-document-section">

                    <div class="eb-document-summary-grid">

                        <div class="eb-document-summary-card eb-summary-required">

                            <div class="eb-summary-icon">
                                <i class="fa-regular fa-folder-open"></i>
                            </div>

                            <div>
                                <span>Requeridos</span>

                                <strong id="totalDocumentosRequeridos">
                                    0
                                </strong>
                            </div>

                        </div>

                        <div class="eb-document-summary-card eb-summary-loaded">

                            <div class="eb-summary-icon">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <div>
                                <span>Cargados</span>

                                <strong id="totalDocumentosCargados">
                                    0
                                </strong>
                            </div>

                        </div>

                        <div class="eb-document-summary-card eb-summary-pending">

                            <div class="eb-summary-icon">
                                <i class="fa-regular fa-clock"></i>
                            </div>

                            <div>
                                <span>Pendientes</span>

                                <strong id="totalDocumentosPendientes">
                                    0
                                </strong>
                            </div>

                        </div>

                        <div class="eb-document-summary-card eb-summary-expired">

                            <div class="eb-summary-icon">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>

                            <div>
                                <span>Vencidos</span>

                                <strong id="totalDocumentosVencidos">
                                    0
                                </strong>
                            </div>

                        </div>

                    </div>

                </section>

                <!-- =============================================
                     DOCUMENTACIÓN
                     ============================================= -->
                <section class="eb-document-section">

                    <div class="eb-document-section-heading">

                        <div>
                            <h6>
                                Documentos
                            </h6>

                            <p>
                                Carga, consulta y administra los archivos del expediente.
                            </p>
                        </div>

                        <span class="eb-section-icon">
                            <i class="fa-regular fa-file-lines"></i>
                        </span>

                    </div>

                    <div class="eb-document-information-alert">

                        

                        <div>
                            <strong>
                                Consideraciones para la carga
                            </strong>

                            <p>
                                Se permiten archivos PDF, Word, Excel,
                                JPG, JPEG, PNG, WEBP y ZIP con un tamaño
                                máximo de 25 MB. Algunos documentos requieren
                                fecha de vencimiento.
                            </p>
                        </div>

                    </div>

                    <div id="documentosCargando"
                         class="eb-documents-state d-none">

                        <div class="spinner-border"
                             role="status">

                            <span class="visually-hidden">
                                Cargando...
                            </span>

                        </div>

                        <span>
                            Consultando documentación...
                        </span>

                    </div>

                    <div id="documentosError"
                         class="alert alert-danger d-none"
                         role="alert">

                        <i class="fa-solid fa-circle-exclamation me-2"></i>

                        <span id="documentosErrorMensaje">
                            No fue posible consultar la documentación.
                        </span>

                    </div>

                    <div id="matrizDocumentos"
                         class="eb-document-matrix">
                    </div>

                </section>

                <!-- =============================================
                     ARCHIVOS DEL DOCUMENTO SELECCIONADO
                     ============================================= -->
                

            </div>

            <div class="modal-footer eb-documents-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    <i class="fa-solid fa-xmark me-1"></i>
                    Cerrar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL CARGAR DOCUMENTO
     ========================================================= -->
<div class="modal fade"
     id="modalCargarDocumento"
     tabindex="-1"
     aria-labelledby="modalCargarDocumentoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalCargarDocumentoTitulo">
                        Cargar documento
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Documento:
                        <strong id="nombreTipoDocumentoCarga"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <form id="formCargarDocumento"
                      enctype="multipart/form-data"
                      autocomplete="off">

                    <input type="hidden"
                           id="documentoCargaEmpresaId"
                           value="0" />

                    <input type="hidden"
                           id="documentoCargaTipoId"
                           value="0" />

                    <div class="row g-4">

                        <div class="col-12">

                            <label for="documentoCargaArchivo"
                                   class="form-label eb-required">
                                Archivo
                            </label>

                            <input type="file"
                                   id="documentoCargaArchivo"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp,.zip" />

                            <span class="text-danger"
                                  data-documento-error-for="Archivo">
                            </span>

                            <small class="form-text text-muted">
                                Tamaño máximo: 25 MB. Se permiten PDF,
                                Word, Excel, imágenes y ZIP.
                            </small>

                        </div>

                        <div class="col-12 col-md-6"
                             id="contenedorFechaVencimientoDocumento">

                            <label for="documentoCargaFechaVencimiento"
                                   class="form-label">
                                Fecha de vencimiento
                            </label>

                            <input type="date"
                                   id="documentoCargaFechaVencimiento"
                                   class="form-control" />

                            <span class="text-danger"
                                  data-documento-error-for="FechaVencimiento">
                            </span>

                        </div>

                        <div class="col-12">

                            <label for="documentoCargaObservaciones"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="documentoCargaObservaciones"
                                      class="form-control"
                                      rows="3"
                                      maxlength="1000"
                                      placeholder="Información adicional del documento"></textarea>

                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="btnGuardarDocumento"
                        class="btn btn-primary">

                    <i class="fa-solid fa-cloud-arrow-up me-1"></i>
                    Cargar documento
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL CREAR / EDITAR / CONSULTAR ACCIONISTA
     ========================================================= -->
<div class="modal fade"
     id="modalAccionista"
     tabindex="-1"
     aria-labelledby="modalAccionistaTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalAccionistaTitulo">
                        Accionista
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Empresa:
                        <strong id="nombreEmpresaFormularioAccionista"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <form id="formAccionista"
                      autocomplete="off">

                    <input type="hidden"
                           id="eaId"
                           value="0" />

                    <input type="hidden"
                           id="eaEmpresaId"
                           value="0" />

                    <div class="row g-4">

                        <div class="col-12">

                            <label for="eaNombreCompleto"
                                   class="form-label eb-required">
                                Nombre completo
                            </label>

                            <input type="text"
                                   id="eaNombreCompleto"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Nombre completo del accionista"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-accionista-error-for="NombreCompleto"></span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="eaRfc"
                                   class="form-label">
                                RFC
                            </label>

                            <input type="text"
                                   id="eaRfc"
                                   class="form-control text-uppercase"
                                   maxlength="13"
                                   placeholder="Ej. ABC010203XYZ"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-accionista-error-for="Rfc"></span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="eaNacionalidad"
                                   class="form-label">
                                Nacionalidad
                            </label>

                            <input type="text"
                                   id="eaNacionalidad"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Ej. Mexicana"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-accionista-error-for="Nacionalidad"></span>

                        </div>

                        <div class="col-12 col-md-6">

                            <label for="eaPorcentajeParticipacion"
                                   class="form-label eb-required">
                                Porcentaje de participación
                            </label>

                            <div class="input-group">
                                <input type="number"
                                       id="eaPorcentajeParticipacion"
                                       class="form-control"
                                       min="0.0001"
                                       max="100"
                                       step="0.0001"
                                       placeholder="0.0000" />

                                <span class="input-group-text">
                                    %
                                </span>
                            </div>

                            <span class="text-danger"
                                  data-accionista-error-for="PorcentajeParticipacion"></span>

                        </div>

                        <div class="col-12 col-md-6 d-flex align-items-end">

                            <div class="form-check form-switch mb-2">

                                <input type="checkbox"
                                       id="eaEsRepresentanteLegal"
                                       class="form-check-input"
                                       role="switch" />

                                <label for="eaEsRepresentanteLegal"
                                       class="form-check-label">
                                    Es representante legal
                                </label>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        id="btnGuardarAccionista"
                        class="btn btn-primary">

                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Guardar accionista
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL CONFIRMAR ELIMINACIÓN DE ACCIONISTA
     ========================================================= -->
<div class="modal fade"
     id="modalEliminarAccionista"
     tabindex="-1"
     aria-labelledby="modalEliminarAccionistaTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalEliminarAccionistaTitulo">
                    Confirmar eliminación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <div class="eb-confirmation-content">

                    <div class="eb-confirmation-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h5>
                        ¿Deseas eliminar al accionista?
                    </h5>

                    <p>
                        El accionista
                        <strong id="nombreAccionistaEliminar"></strong>
                        dejará de mostrarse en la empresa.
                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    No, cancelar
                </button>

                <button type="button"
                        id="btnConfirmarEliminarAccionista"
                        class="btn btn-danger">

                    <i class="fa-regular fa-trash-can me-1"></i>
                    Sí, eliminar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL CONFIRMAR ELIMINACIÓN
     ========================================================= -->
<div class="modal fade"
     id="modalEliminarEmpresa"
     tabindex="-1"
     aria-labelledby="modalEliminarEmpresaTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalEliminarEmpresaTitulo">
                    Confirmar eliminación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <div class="eb-confirmation-content">

                    <div class="eb-confirmation-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h5>
                        ¿Estás seguro de que deseas eliminar?
                    </h5>

                    <p id="mensajeConfirmacionEliminar">
                        La empresa
                        <strong id="nombreEmpresaEliminar"></strong>
                        dejará de mostrarse en el módulo.
                    </p>

                    <div class="alert alert-warning mb-0">
                        No se realizará ningún cambio hasta que confirmes
                        la operación. Las empresas con documentos o accionistas
                        relacionados no podrán eliminarse.
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        id="btnCancelarEliminarEmpresa"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    No, cancelar
                </button>

                <button type="button"
                        id="btnConfirmarEliminarEmpresa"
                        class="btn btn-danger">

                    <i class="fa-regular fa-trash-can me-1"></i>
                    Sí, eliminar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL ELIMINAR DOCUMENTO
     ========================================================= -->
<div class="modal fade"
     id="modalEliminarDocumento"
     tabindex="-1"
     aria-labelledby="modalEliminarDocumentoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-md modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalEliminarDocumentoTitulo">
                    Eliminar archivo
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <div class="eb-confirmation-content">

                    <div class="eb-confirmation-icon eb-confirmation-icon-danger">
                        <i class="fa-regular fa-trash-can"></i>
                    </div>

                    <h5>
                        ¿Eliminar este archivo?
                    </h5>

                    <p>
                        Se eliminará lógicamente el archivo
                        <strong id="nombreDocumentoEliminar"></strong>.
                    </p>

                    <p class="small text-muted mb-0">
                        El archivo físico se conservará para fines de
                        auditoría y recuperación.
                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="btnConfirmarEliminarDocumento"
                        class="btn btn-danger">

                    <i class="fa-regular fa-trash-can me-1"></i>
                    Eliminar archivo
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL DE RESULTADO
     ========================================================= -->
<div class="modal fade"
     id="modalResultado"
     tabindex="-1"
     aria-labelledby="resultadoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body text-center py-5">

                <div id="resultadoIcono"
                     class="eb-result-icon eb-result-success">

                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <h5 id="resultadoTitulo"
                    class="eb-result-title">
                    Operación exitosa
                </h5>

                <p id="resultadoMensaje"
                       class="eb-result-message">
                    La operación se completó correctamente.
                </p>

                <button type="button"
                        class="btn btn-primary mt-2"
                        data-bs-dismiss="modal">
                    Aceptar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     TOKEN ANTIFALSIFICACIÓN
     ========================================================= -->
<form method="post"
      id="formToken"
      class="d-none">
    @Html.AntiForgeryToken()
</form>

