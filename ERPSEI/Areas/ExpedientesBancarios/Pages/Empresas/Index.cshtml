@page
@model ERPSEI.Areas.ExpedientesBancarios.Pages.Empresas.IndexModel

@{
    ViewData["Title"] = "Empresas - Expedientes Bancarios";

    bool puedeAdministrarPermisosCompliance =
        User.IsInRole(
            ServicesConfiguration.RolMaster
        ) ||
        User.IsInRole(
            ServicesConfiguration.RolAdministrador
        ) ||
        User.IsInRole(
            ServicesConfiguration.RolAdministradorBancos
        );
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/expedientes-bancarios.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-table/bootstrap-table.min.css"
          asp-append-version="true" />
}

<div class="eb-container">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->
    <div class="eb-page-header">
        <div>
            <h1 class="eb-page-title">
                Empresas
            </h1>

            <p class="eb-page-subtitle">
                Administración de empresas y expedientes bancarios.
            </p>
        </div>
    </div>

    <!-- =====================================================
         FILTROS
         ===================================================== -->
    <div class="eb-card mb-4">

        <div class="eb-card-header">
            <h2>
                <i class="fa-solid fa-filter me-2"></i>
                Filtros de búsqueda
            </h2>
        </div>

        <div class="eb-card-body">

            <div class="row g-3 align-items-end">

                <!-- Búsqueda general -->
                <div class="col-12 col-lg-4">

                    <label for="filtroBusqueda"
                           class="form-label">
                        Buscar empresa
                    </label>

                    <input type="text"
                           id="filtroBusqueda"
                           class="form-control"
                           placeholder="Razón social, nombre corto o actividad"
                           autocomplete="off" />

                </div>

                <!-- RFC -->
                <div class="col-12 col-md-6 col-lg-2">

                    <label for="filtroRfc"
                           class="form-label">
                        RFC
                    </label>

                    <input type="text"
                           id="filtroRfc"
                           class="form-control text-uppercase"
                           maxlength="13"
                           placeholder="ABC010203XYZ"
                           autocomplete="off" />

                </div>

                <!-- Nivel -->
                <div class="col-12 col-md-6 col-lg-2">

                    <label for="filtroNivel"
                           class="form-label">
                        Nivel
                    </label>

                    <input type="text"
                           id="filtroNivel"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ej. Nivel 1"
                           autocomplete="off" />

                </div>

                <!-- Estatus -->
                <div class="col-12 col-md-6 col-lg-2">

                    <label for="filtroEstatus"
                           class="form-label">
                        Estatus
                    </label>

                    <select id="filtroEstatus"
                            class="form-select">

                        <option value="Activas" selected>
                            Activas
                        </option>

                        <option value="Inactivas">
                            Inactivas
                        </option>

                        <option value="Todas">
                            Todas
                        </option>

                    </select>

                </div>

                <!-- Buscar -->
                <div class="col-12 col-md-6 col-lg-2 d-grid">

                    <button type="button"
                            id="btnBuscarEmpresas"
                            class="btn btn-primary">

                        <i class="fa-solid fa-magnifying-glass me-1"></i>
                        Buscar
                    </button>

                </div>

            </div>

        </div>
    </div>

    <!-- =====================================================
         TOOLBAR DEL DATATABLE
         ===================================================== -->
    <div id="toolbarEmpresas"
         class="eb-toolbar">

        <!-- Nueva empresa -->
        @if (Model.PermisosCompliance.PuedeCrearCargar)
        {
            <button type="button"
                    id="btnNuevaEmpresa"
                    class="btn eb-toolbar-action"
                    title="Nueva empresa"
                    aria-label="Nueva empresa">

                <span class="eb-toolbar-plus"
                      aria-hidden="true">
                </span>

            </button>
        }

        <!-- Eliminar empresas -->
        @if (Model.PermisosCompliance.PuedeEliminar)
        {
            <button type="button"
                    id="btnEliminarSeleccionadas"
                    class="btn eb-toolbar-action"
                    title="Eliminar empresas seleccionadas"
                    aria-label="Eliminar empresas seleccionadas"
                    disabled>

                <span class="eb-toolbar-trash"
                      aria-hidden="true">
                </span>

            </button>
        }

        <!-- Dashboard -->
        @if (Model.PermisosCompliance.EsAdministrador)
        {
            <a asp-area="ExpedientesBancarios"
                   asp-page="/Dashboard/Index"
                   class="btn eb-dashboard-access"
                   title="Dashboard de Compliance"
                   aria-label="Dashboard de Compliance">

                <i class="fa-solid fa-chart-column"></i>

                <span>
                    Dashboard
                </span>

            </a>
        }

        @if (Model.PermisosCompliance.PuedeAdministrarPermisos)
        {
            <button type="button"
                    id="btnPermisosCompliance"
                    class="btn eb-dashboard-access"
                    title="Administrar permisos de Compliance"
                    aria-label="Administrar permisos de Compliance">

                <i class="fa-solid fa-user-shield"></i>

                <span>
                    Permisos
                </span>

            </button>
        }

    </div>

    <!-- =====================================================
         TABLA
         ===================================================== -->
    <div class="eb-card">

        <div class="eb-card-body p-0">

            <table id="tablaEmpresas"
                   class="table">

                <thead>
                    <tr>
                        <th data-field="state"
                            data-checkbox="true">
                        </th>

                        <th data-field="id"
                            data-sortable="true">
                            Id
                        </th>

                        <th data-field="razonSocial"
                            data-sortable="true">
                            Razón social
                        </th>

                        <th data-field="nombreCorto"
                            data-sortable="true">
                            Nombre corto
                        </th>

                        <th data-field="rfc"
                            data-sortable="true">
                            RFC
                        </th>

                        <th data-field="nivel"
                            data-sortable="true">
                            Nivel
                        </th>

                        <th data-field="deshabilitado"
                            data-align="center"
                            data-formatter="estatusEmpresaFormatter">
                            Estatus
                        </th>

                        <th data-field="acciones"
                            data-align="center"
                            data-formatter="accionesEmpresaFormatter">
                            Acciones
                        </th>
                    </tr>
                </thead>

            </table>

        </div>
    </div>

</div>

@if (puedeAdministrarPermisosCompliance)
{
    <!-- =========================================================
         MODAL PERMISOS COMPLIANCE
         ========================================================= -->
    <div class="modal fade"
         id="modalPermisosCompliance"
         tabindex="-1"
         aria-labelledby="modalPermisosComplianceTitulo"
         aria-hidden="true">

        <div class="modal-dialog
            modal-xl
            modal-dialog-centered
            modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">

                    <div>
                        <h5 class="modal-title"
                            id="modalPermisosComplianceTitulo">

                            <i class="fa-solid fa-user-shield me-2"></i>
                            Permisos Compliance

                        </h5>

                        <p class="eb-modal-subtitle mb-0">
                            Asigna permisos individuales a los usuarios
                            autorizados para utilizar el módulo.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <!-- Buscador de usuarios -->
                    <section class="eb-permissions-search">

                        <div class="eb-permissions-search-heading">

                            <div class="eb-permissions-search-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <div>
                                <h6>
                                    Buscar usuario
                                </h6>

                                <p>
                                    Filtra por nombre, correo electrónico o rol.
                                </p>
                            </div>

                        </div>

                        <div class="eb-permissions-search-controls">

                            <div class="eb-permissions-search-input">

                                <i class="fa-solid fa-magnifying-glass"></i>

                                <input type="text"
                                       id="buscarUsuarioCompliance"
                                       class="form-control"
                                       placeholder="Escribe un nombre, correo o rol..."
                                       autocomplete="off" />

                                <button type="button"
                                        id="btnBorrarTextoPermisos"
                                        class="eb-permissions-search-clear"
                                        title="Borrar búsqueda"
                                        aria-label="Borrar búsqueda">

                                    <i class="fa-solid fa-xmark"></i>

                                </button>

                            </div>

                            <button type="button"
                                    id="btnLimpiarBusquedaPermisos"
                                    class="btn eb-permissions-clear-button">

                                <i class="fa-solid fa-rotate-left"></i>

                                <span>
                                    Restablecer
                                </span>

                            </button>

                        </div>

                    </section>

                    <!-- Información -->
                    <div class="alert alert-info"
                         role="alert">

                        <div class="d-flex gap-2">

                            <i class="fa-solid fa-circle-info mt-1"></i>

                            <div>
                                <strong>
                                    Accesos administrativos
                                </strong>

                                <div class="small mt-1">
                                    Master, Administrador y Administrador
                                    Bancos cuentan siempre con acceso total.
                                    Sus permisos no pueden desactivarse.
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- Cargando -->
                    <div id="permisosComplianceCargando"
                         class="eb-loading-state">

                        <div class="spinner-border"
                             role="status"
                             aria-hidden="true">
                        </div>

                        <span>
                            Consultando usuarios y permisos...
                        </span>

                    </div>

                    <!-- Error -->
                    <div id="permisosComplianceError"
                         class="alert alert-danger d-none"
                         role="alert">

                        <i class="fa-solid fa-circle-exclamation me-2"></i>

                        <span id="permisosComplianceErrorMensaje">
                            No fue posible consultar los permisos.
                        </span>

                    </div>

                    <!-- Estado vacío -->
                    <div id="permisosComplianceVacio"
                         class="eb-empty-state d-none">

                        <div class="eb-empty-icon">
                            <i class="fa-solid fa-users-slash"></i>
                        </div>

                        <h3>
                            No hay usuarios disponibles
                        </h3>

                        <p>
                            No se encontraron usuarios disponibles.
                        </p>

                    </div>

                    <!-- Tabla -->
                    <div id="contenedorTablaPermisosCompliance"
                         class="table-responsive d-none">

                        <table class="table
                            table-hover
                            align-middle
                            eb-permissions-table">

                            <thead>
                                <tr>
                                    <th>
                                        Usuario
                                    </th>

                                    <th>
                                        Rol
                                    </th>

                                    <th class="text-center">
                                        Visualizar
                                    </th>

                                    <th class="text-center">
                                        Crear / Cargar
                                    </th>

                                    <th class="text-center">
                                        Modificar
                                    </th>

                                    <th class="text-center">
                                        Eliminar
                                    </th>

                                    <th class="text-center">
                                        Descargar
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="tablaPermisosComplianceBody">
                            </tbody>

                        </table>

                    </div>

                </div>

                <div class="modal-footer">

                    <div class="me-auto">

                        <span id="totalUsuariosPermisosCompliance"
                              class="text-muted small">
                            0 usuarios
                        </span>

                    </div>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark me-1"></i>
                        Cerrar

                    </button>

                    <button type="button"
                            id="btnGuardarPermisosCompliance"
                            class="btn btn-primary"
                            disabled>

                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Guardar permisos

                    </button>

                </div>

            </div>

        </div>

    </div>
}

<!-- =========================================================
     MODAL CREAR / EDITAR / CONSULTAR EMPRESA
     ========================================================= -->
<div class="modal fade"
     id="modalEmpresa"
     tabindex="-1"
     aria-labelledby="modalEmpresaTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalEmpresaTitulo">
                        Empresa
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Información corporativa para el expediente bancario.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <form id="formEmpresa"
                      autocomplete="off">

                    <input type="hidden"
                           id="ebId"
                           value="0" />

                    <div class="row g-4">

                        <!-- Razón social -->
                        <div class="col-12 col-lg-8">

                            <label for="ebRazonSocial"
                                   class="form-label eb-required">
                                Razón social
                            </label>

                            <input type="text"
                                   id="ebRazonSocial"
                                   class="form-control"
                                   maxlength="250"
                                   placeholder="Ej. Empresa Comercializadora, S.A. de C.V."
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="RazonSocial"></span>

                        </div>

                        <!-- Nombre corto -->
                        <div class="col-12 col-lg-4">

                            <label for="ebNombreCorto"
                                   class="form-label eb-required">
                                Nombre corto
                            </label>

                            <input type="text"
                                   id="ebNombreCorto"
                                   class="form-control"
                                   maxlength="150"
                                   placeholder="Ej. Comercializadora"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="NombreCorto"></span>

                        </div>

                        <!-- RFC -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebRfc"
                                   class="form-label eb-required">
                                RFC
                            </label>

                            <input type="text"
                                   id="ebRfc"
                                   class="form-control text-uppercase"
                                   maxlength="13"
                                   placeholder="Ej. ABC010203XYZ"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="Rfc"></span>

                        </div>

                        <!-- Nivel -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebNivel"
                                   class="form-label">
                                Nivel
                            </label>

                            <input type="text"
                                   id="ebNivel"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Ej. Nivel 1"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="Nivel"></span>

                        </div>

                        <!-- Fecha constitución -->
                        <div class="col-12 col-md-6 col-lg-4">

                            <label for="ebFechaConstitucion"
                                   class="form-label">
                                Fecha de constitución
                            </label>

                            <input type="date"
                                   id="ebFechaConstitucion"
                                   class="form-control" />

                            <span class="text-danger"
                                  data-error-for="FechaConstitucion"></span>

                        </div>

                        <!-- Número de escritura y/o escrituras -->
                        <div class="col-12">

                            <label for="ebNumeroEscritura"
                                   class="form-label">
                                Número de escritura y/o escrituras
                            </label>

                            <input type="text"
                                   id="ebNumeroEscritura"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Ej. Escritura 1254, Escritura 2876"
                                   autocomplete="off" />

                            <small class="form-text text-muted">
                                Puedes registrar uno o varios números de escritura
                                separados por comas.
                            </small>

                            <span class="text-danger"
                                  data-error-for="NumeroEscritura"></span>

                        </div>

                        <!-- Actividad comercial -->
                        <div class="col-12">

                            <label for="ebActividadComercial"
                                   class="form-label">
                                Actividad comercial
                            </label>

                            <textarea id="ebActividadComercial"
                                      class="form-control"
                                      maxlength="500"
                                      rows="3"
                                      placeholder="Describe la actividad comercial principal de la empresa"></textarea>

                            <span class="text-danger"
                                  data-error-for="ActividadComercial"></span>

                        </div>

                        <!-- Teléfono -->
                        <div class="col-12 col-md-6">

                            <label for="ebTelefonoBancos"
                                   class="form-label">
                                Teléfono de bancos
                            </label>

                            <input type="text"
                                   id="ebTelefonoBancos"
                                   class="form-control"
                                   maxlength="30"
                                   placeholder="Ej. 55 1234 5678"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="TelefonoBancos"></span>

                        </div>

                        <!-- Correo -->
                        <div class="col-12 col-md-6">

                            <label for="ebCorreoBancos"
                                   class="form-label">
                                Correo de bancos
                            </label>

                            <input type="email"
                                   id="ebCorreoBancos"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Ej. bancos@empresa.com"
                                   autocomplete="off" />

                            <span class="text-danger"
                                  data-error-for="CorreoBancos"></span>

                        </div>

                        <!-- Domicilio fiscal -->
                        <div class="col-12">

                            <label for="ebDomicilioFiscal"
                                   class="form-label">
                                Domicilio fiscal
                            </label>

                            <textarea id="ebDomicilioFiscal"
                                      class="form-control"
                                      maxlength="500"
                                      rows="3"
                                      placeholder="Calle, número, colonia, municipio, estado y código postal"></textarea>

                            <span class="text-danger"
                                  data-error-for="DomicilioFiscal"></span>

                        </div>

                        <!-- Observaciones -->
                        <div class="col-12">

                            <label for="ebObservaciones"
                                   class="form-label">
                                Observaciones
                            </label>

                            <textarea id="ebObservaciones"
                                      class="form-control"
                                      maxlength="1000"
                                      rows="3"
                                      placeholder="Información complementaria de la empresa"></textarea>

                            <span class="text-danger"
                                  data-error-for="Observaciones"></span>

                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        id="btnGuardarEmpresa"
                        class="btn btn-primary">

                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Guardar empresa
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL DE ACCIONISTAS
     ========================================================= -->
<div class="modal fade"
     id="modalAccionistas"
     tabindex="-1"
     aria-labelledby="modalAccionistasTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h5 class="modal-title"
                        id="modalAccionistasTitulo">
                        Accionistas
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Empresa:
                        <strong id="nombreEmpresaAccionistas"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body">

                <!-- Resumen -->
                <div class="eb-shareholder-summary">

                    <div class="eb-shareholder-kpi">
                        <span>Total de accionistas</span>
                        <strong id="totalAccionistas">
                            0
                        </strong>
                    </div>

                    <div class="eb-shareholder-kpi">
                        <span>Participación registrada</span>
                        <strong id="porcentajeRegistrado">
                            0.0000 %
                        </strong>
                    </div>

                    <div class="eb-shareholder-kpi">
                        <span>Participación disponible</span>
                        <strong id="porcentajeDisponible">
                            100.0000 %
                        </strong>
                    </div>

                </div>

                <!-- Barra de acciones -->
                <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-2 mb-3">

                    <div>
                        <h6 class="mb-1 eb-section-title">
                            Accionistas registrados
                        </h6>

                        <p class="text-muted small mb-0">
                            La participación activa no puede superar el 100 %.
                        </p>
                    </div>

                    @if (Model.PermisosCompliance.PuedeCrearCargar)
                    {
                        <button type="button"
                                id="btnNuevoAccionista"
                                class="btn btn-primary">

                            <i class="fa-solid fa-plus me-1"></i>
                            Nuevo accionista

                        </button>
                    }

                </div>

                <!-- Cargando -->
                <div id="accionistasCargando"
                     class="eb-loading-state">

                    <div class="spinner-border"
                         role="status"
                         aria-hidden="true">
                    </div>

                    <span>
                        Consultando accionistas...
                    </span>
                </div>

                <!-- Error -->
                <div id="accionistasError"
                     class="alert alert-danger d-none"
                     role="alert">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    <span id="accionistasErrorMensaje">
                        No fue posible consultar los accionistas.
                    </span>
                </div>

                <!-- Estado vacío -->
                <div id="accionistasEstadoVacio"
                     class="eb-empty-state d-none">

                    <div class="eb-empty-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h3>
                        No hay accionistas registrados
                    </h3>

                    <p>
                        Registra el primer accionista de esta empresa.
                    </p>

                </div>

                <!-- Tabla -->
                <div id="contenedorTablaAccionistas"
                     class="table-responsive eb-shareholder-table-wrap d-none">

                    <table class="table eb-shareholder-table">

                        <thead>
                            <tr>
                                <th>Nombre completo</th>
                                <th>RFC</th>
                                <th class="text-end">Participación</th>
                                <th>Nacionalidad</th>
                                <th class="text-center">
                                    Representante legal
                                </th>
                                <th class="text-center">Estatus</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody id="tablaAccionistasBody">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL EXPEDIENTE DOCUMENTAL
     ========================================================= -->
<div class="modal fade"
     id="modalDocumentos"
     tabindex="-1"
     aria-labelledby="modalDocumentosTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content eb-documents-modal eb-documents-modal-redesign">

            <div class="modal-header eb-documents-header">

                <div>
                    <h5 class="modal-title"
                        id="modalDocumentosTitulo">
                        Expediente documental
                    </h5>

                    <p class="eb-modal-subtitle mb-0">
                        Empresa:
                        <strong id="nombreEmpresaDocumentos"></strong>
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body eb-documents-body">

                <!-- =============================================
                     INFORMACIÓN CORPORATIVA
                     ============================================= -->
