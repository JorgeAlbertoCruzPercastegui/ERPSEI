            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="btnConfirmarDescargaDocumento"
                        class="btn btn-primary">

                    <i class="fa-solid fa-download me-1"></i>
                    Descargar documento
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     MODAL DE RESULTADO
     ========================================================= -->
<div class="modal fade"
     id="modalResultado"
     tabindex="-1"
     aria-labelledby="resultadoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body text-center py-5">

                <div id="resultadoIcono"
                     class="eb-result-icon eb-result-success">

                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <h5 id="resultadoTitulo"
                    class="eb-result-title">
                    Operación exitosa
                </h5>

                <p id="resultadoMensaje"
                       class="eb-result-message">
                    La operación se completó correctamente.
                </p>

                <button type="button"
                        class="btn btn-primary mt-2"
                        data-bs-dismiss="modal">
                    Aceptar
                </button>

            </div>

        </div>

    </div>

</div>

<!-- =========================================================
     TOKEN ANTIFALSIFICACIÓN
     ========================================================= -->
<form method="post"
      id="formToken"
      class="d-none">
    @Html.AntiForgeryToken()
</form>

<script>
    window.permisosCompliance = {
        puedeVisualizar:
            @Model.PermisosCompliance.PuedeVisualizar.ToString().ToLowerInvariant(),

        puedeCrearCargar:
            @Model.PermisosCompliance.PuedeCrearCargar.ToString().ToLowerInvariant(),

        puedeModificar:
            @Model.PermisosCompliance.PuedeModificar.ToString().ToLowerInvariant(),

        puedeEliminar:
            @Model.PermisosCompliance.PuedeEliminar.ToString().ToLowerInvariant(),

        puedeDescargar:
            @Model.PermisosCompliance.PuedeDescargar.ToString().ToLowerInvariant(),

        esAdministrador:
            @Model.PermisosCompliance.EsAdministrador.ToString().ToLowerInvariant()
    };
</script>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>

    <script src="~/lib/bootstrap-table/locale/bootstrap-table-es-MX.min.js"></script>

    <script src="~/js/expedientes-bancarios.js"
            asp-append-version="true">
    </script>

    <script src="~/js/expedientes-bancarios-empresas.js"
            asp-append-version="true">
    </script>
}