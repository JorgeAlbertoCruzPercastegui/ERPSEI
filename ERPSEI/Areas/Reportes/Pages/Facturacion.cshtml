<canvas id="myChartD" style="width:100%;"></canvas> *@

@section Scripts
{
	<!-- Librería autocompletar y dependencias -->
	<link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css">
	<script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
	<script src="~/js/autocompletar.js"></script>

	<script src="~/lib/chartjs_4.4.6/Chart.js"></script>

	<!-- Scripts del módulo y dependencias -->
	<link rel="stylesheet" href="~/css/Facturacion.css" />
	<script src="~/../Areas/Reportes/Pages/Facturacion.cshtml.js"></script>
	<script type="text/javascript">
		var cultureName = "@cultureName";
		var title = '@localizer["Title"]';

		var emptyGraphicsURL = '@this.HttpContext.Request.Scheme://@this.HttpContext.Request.Host/img/empty_graphics.jpg';
		var emptyGrapicsInstructions = '@localizer["EmptyGraphicsInstructions"]';

		var puedeTodo = '@puedeTodo' == 'True';
		var puedeConsultar = '@puedeConsultar' == 'True';
		var puedeEditar = '@puedeEditar' == 'True';
		var puedeEliminar = '@puedeEliminar' == 'True';
		var puedeAutorizar = '@puedeAutorizar' == 'True';
	</script>

	<partial name="_ValidationScriptsPartial" />
}
