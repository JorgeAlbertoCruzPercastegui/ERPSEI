@page "{handler?}"
@using ERPSEI.Data.Managers;
@using Microsoft.AspNetCore.Localization;
@using ERPSEI.Requests;
@using Microsoft.AspNetCore.Mvc.Localization;
@using ERPSEI.Data.Managers.ActivosFijos;
@using ERPSEI.Data.Entities.ActivosFijos;
@using ERPSEI.Data.Managers.Empleados;
@using ERPSEI.Data.Entities.Empleados;
@using ERPSEI.Data.Entities.Usuarios;
@using ERPSEI.Data.Managers.Usuarios;
@using ERPSEI.Data.Entities.Empresas;
@using ERPSEI.Data.Managers.Empresas;
@using ERPSEI.Data.Entities.TipoContratos;
@using ERPSEI.Data.Managers.TipoContratos;
@model ERPSEI.Areas.Reportes.Pages.GeneradorContratoModel

@inject ICategoriaActivosFijosManager CategoriaManager;
@inject ITipoActivosFijosManager TipoManager;
@inject IEmpleadoManager EmpleadoManager;
@inject IEmpresaManager EmpresaManager;
@inject ITipoContratosManager TipoContratoManager;

@inject IViewLocalizer Localizer;
@inject AppRoleManager RolesManager;
@inject AppUserManager UsuariosManager;
@inject IConfiguration Configuration;

@{
    ViewData["Title"] = Localizer["Title"];

    // Cultura
    IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();
    System.Globalization.CultureInfo? culture = rqf != null ? rqf.RequestCulture.Culture : new System.Globalization.CultureInfo("es-MX");
    string cultureName = culture.Name;

    // Datos
    List<Empleado> empleados = await EmpleadoManager.GetAllAsync();
    List<Empresa> empresas = await EmpresaManager.GetAllAsync();
    List<TipoContrato> tipoContratos = await TipoContratoManager.GetAllAsync();

    // Permisos
    bool puedeTodo = User.Claims.Where(c => c.Type.Equals("PuedeTodo", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeConsultar = User.Claims.Where(c => c.Type.Equals("PuedeConsultar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEditar = User.Claims.Where(c => c.Type.Equals("PuedeEditar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEliminar = User.Claims.Where(c => c.Type.Equals("PuedeEliminar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeAutorizar = User.Claims.Where(c => c.Type.Equals("PuedeAutorizar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";

    // 🔐 Agregar permisos al ViewData
    var permisos = new Dictionary<string, bool>();
    permisos["generadorContrato"] = true; // puedes condicionar esto con lógica si lo deseas

    ViewData["permisos"] = permisos;
}

<h3 class="title mb-3">@ViewData["Title"]</h3>


<!-- --------------------------- -->
<!-- Sección de filtros -------- -->
<div class="accordion shadow mb-5" id="accordionFiltros">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button p-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <h6>@Localizer["FilterTitle"]</h6>
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFiltros">
            <div class="accordion-body">
                <form id="filtros" method="post">
                    <div class="row">
                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroTipoContrato" asp-for="InputFiltro.TipoContratoId" class="form-select" placeholder="@Localizer["TipoContratoField"]">
                                    <option value="0">Seleccione...</option>
                                    @{
                                        @foreach (TipoContrato tipoContrato in tipoContratos)
                                        {
                                            <option value='@tipoContrato.Id'>@tipoContrato.Nombre</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroMoneda" asp-for="InputFiltro.TipoContratoId" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroPrestador" asp-for="InputFiltro.PrestadorId" class="form-select" placeholder="@Localizer["TipoField"]">
                                    <option value="0">Seleccione...</option>
                                    @{
                                        @foreach (Empresa empresa in empresas)
                                        {
                                            <option value='@empresa.Id'>@empresa.RazonSocial</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroPrestador" asp-for="InputFiltro.PrestadorId" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroPrestatario" asp-for="InputFiltro.PrestatarioId" class="form-select" placeholder="@Localizer["TipoField"]">
                                    <option value="0">Seleccione...</option>
                                    @{
                                        @foreach (Empresa empresa in empresas)
                                        {
                                            <option value='@empresa.Id'>@empresa.RazonSocial</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroPrestatario" asp-for="InputFiltro.PrestatarioId" class="form-label"></label>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="row text-end">
                    <div class="col-12">
                        <button id="btnBuscar" name="refresh" class="btn btn-primary" onclick="onBuscarClick();">
                            <i class="bi bi-search"></i> @Localizer["SearchButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- --------------------------- -->
<!-- Sección tabla de resultados -->
<div id="toolbar" class="col-xl-12">
    <button id="btnAgregar" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dlgContrato" onclick="onAgregarClick();">
        <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">@Localizer["AddButton"]</span>
    </button>
    <button id="remove" class="btn btn-danger" disabled>
        <i class="bi bi-trash"></i> <span class="d-none d-sm-inline">@Localizer["DeactivateButton"]</span>
    </button>
</div>

<!-- --------------------------- -->
<!-- --------------------------- -->
<table id="table" class="table-sm"
       data-unique-id="id"
       data-toolbar="#toolbar"
       data-search="true"
       data-show-toggle="true"
       data-show-fullscreen="true"
       data-show-columns="true"
       data-show-columns-toggle-all="true"
       data-show-export="true"
       data-click-to-select="true"
       data-minimum-count-columns="2"
       data-show-pagination-switch="true"
       data-pagination="true"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]"
       data-show-footer="false"
       data-side-pagination="client"
       data-response-handler="responseHandler"
       data-buttons-class="primary"
       data-buttons="additionalButtons"
       data-url="/Reportes/GeneradorContrato/EmpresaContratosList">
    <thead>
        <tr align="center" valign="middle" class="bg-primary bg-opacity-10">
        </tr>
    </thead>
</table>

<!-- Modal dlgContrato -->
<div class="modal fade" id="dlgContrato" tabindex="-1" aria-labelledby="dlgContratoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dlgContratoLabel">Nuevo Contrato</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">

                <h6>Información del Prestador</h6>
                <div class="row">
                    <div class="col-md-4"><label>ID:</label> <input type="text" class="form-control" id="prestadorId" readonly /></div>
                    <div class="col-md-4">
                        <label>Tipo Contrato:</label>
                        <select class="form-select" id="tipoContratoSelectPrestador"></select>
                    </div>
                    <div class="col-md-4">
                        <label>Prestador:</label>
                        <select class="form-select" id="prestadorSelect"></select>
                    </div>
                    <div class="col-md-4"><label>RFC:</label> <input type="text" class="form-control" id="prestadorRFC" /></div>
                    <div class="col-md-4"><label>Domicilio Fiscal:</label> <input type="text" class="form-control" id="prestadorDomicilio" /></div>
                    <div class="col-md-4"><label># Notario:</label> <input type="text" class="form-control" id="prestadorNumeroNotario" /></div>
                    <div class="col-md-4"><label>Notario:</label> <input type="text" class="form-control" id="prestadorNotario" /></div>
                    <div class="col-md-4"><label>Representante Legal:</label> <input type="text" class="form-control" id="prestadorRepresentante" /></div>
                    <div class="col-md-4"><label>Fecha Constitución:</label> <input type="date" class="form-control" id="prestadorFecha" /></div>
                    <div class="col-md-4"><label>Email:</label> <input type="email" class="form-control" id="prestadorEmail" /></div>
                    <div class="col-md-4"><label>Página Web:</label> <input type="url" class="form-control" id="prestadorWeb" /></div>
                </div>

                <hr />

                <h6>Información del Prestatario</h6>
                <div class="row">
                    <div class="col-md-4"><label>ID:</label> <input type="text" class="form-control" id="prestatarioId" readonly /></div>
                    <div class="col-md-4">
                        <label>Tipo Contrato:</label>
                        <select class="form-select" id="tipoContratoSelectPrestatario"></select>
                    </div>
                    <div class="col-md-4">
                        <label>Prestatario:</label>
                        <select class="form-select" id="prestatarioSelect"></select>
                    </div>
                    <div class="col-md-4"><label>RFC:</label> <input type="text" class="form-control" id="prestatarioRFC" /></div>
                    <div class="col-md-4"><label>Domicilio Fiscal:</label> <input type="text" class="form-control" id="prestatarioDomicilio" /></div>
                    <div class="col-md-4"><label># Notario:</label> <input type="text" class="form-control" id="prestatarioNumeroNotario" /></div>
                    <div class="col-md-4"><label>Notario:</label> <input type="text" class="form-control" id="prestatarioNotario" /></div>
                    <div class="col-md-4"><label>Representante Legal:</label> <input type="text" class="form-control" id="prestatarioRepresentante" /></div>
                    <div class="col-md-4"><label>Fecha Constitución:</label> <input type="date" class="form-control" id="prestatarioFecha" /></div>
                    <div class="col-md-4"><label>Email:</label> <input type="email" class="form-control" id="prestatarioEmail" /></div>
                    <div class="col-md-4"><label>Página Web:</label> <input type="url" class="form-control" id="prestatarioWeb" /></div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-success" onclick="guardarContrato()">Guardar</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.min.css">
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css">
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/js/autocompletar.js"></script>

    <script src="~/lib/bootstrap-table/extensions/export/tableExport.min.js"></script>
    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>
    <script src="~/lib/bootstrap-table/locale/bootstrap-table-es-MX.min.js"></script>
    <script src="~/lib/bootstrap-table/locale/bootstrap-table-en-US.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/bootstrap-table-export.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/xlsx.full.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/exceljs.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/FileSaver.min.js"></script>

    <script src="~/../Areas/Reportes/Pages/GeneradorContrato.cshtml.js"></script>

    <script type="text/javascript">
        var cultureName = "@cultureName";
        var btnImportarText = '@Localizer["ImportButtonText"]';
        var btnImportarTitle = '@Localizer["ImportButtonTitle"]';
        var btnVerTitle = '@Localizer["SeeButtonTitle"]';
        var btnEditarTitle = '@Localizer["EditButtonTitle"]';
        var dlgEditarTitle = '@Localizer["EditDialogTitle"]';
        var dlgVerTitle = '@Localizer["SeeDialogTitle"]';
        var dlgNuevoTitle = '@Localizer["NewDialogTitle"]';
        var dlgDeleteTitle = '@Localizer["DeleteOfficeDialogTitle"]';
