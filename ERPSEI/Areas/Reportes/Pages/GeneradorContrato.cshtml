        var colRFCHeader = '@Localizer["ColRFCHeader"]';
        var colNotarioHeader = '@Localizer["ColNotarioHeader"]';
        var colRepresentanteLegalHeader = '@Localizer["ColRepresentanteLegalHeader"]';
        var colDomicilioFiscalHeader = '@Localizer["ColDomicilioFiscalHeader"]';
        var colEmailHeader = '@Localizer["ColEmailHeader"]';
        var colFechaConstitucionHeader = '@Localizer["ColFechaConstitucionHeader"]';
        var colNoEscrituraHeader = '@Localizer["ColNoEscrituraHeader"]';

        var colAccionesHeader = '@Localizer["ColActionsHeader"]';

        /*Permisos*/
        var puedeTodo = '@puedeTodo' == 'True';
        var puedeConsultar = '@puedeConsultar' == 'True';
        var puedeEditar = '@puedeEditar' == 'True';
        var puedeEliminar = '@puedeEliminar' == 'True';
        var puedeAutorizar = '@puedeAutorizar' == 'True';
    </script>

    <partial name="_ValidationScriptsPartial" />
}