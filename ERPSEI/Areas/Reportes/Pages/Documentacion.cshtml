@page "{handler?}"
@model ERPSEI.Areas.Reportes.Pages.DocumentacionModel

@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Documentación Interna";

    IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();
    System.Globalization.CultureInfo culture = rqf != null
        ? rqf.RequestCulture.Culture
        : new System.Globalization.CultureInfo("es-MX");
}

<h3 class="title mb-4">Documentación Interna</h3>

<!-- =================================== -->
<!-- PANEL DE FILTROS -->
<!-- =================================== -->
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Filtros de Búsqueda</strong>
    </div>

    <div class="card-body">
        <form method="get">
            <div class="row">

                <!-- FILTRO AREA -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Área</label>
                    <select class="form-select" name="AreaId">
                        <option value="">-- Seleccione --</option>
                        <!-- POR AHORA VACÍO - SE LLENARÁ DESDE EL MODELO -->
                    </select>
                </div>

                <!-- FILTRO TIPO DOCUMENTO -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Tipo Documento</label>
                    <select class="form-select" name="TipoDocumentoId">
                        <option value="">-- Seleccione --</option>
                        <!-- POR AHORA VACÍO -->
                    </select>
                </div>

                <!-- FILTRO TITULO -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Título / Palabra clave</label>
                    <input type="text" class="form-control" name="Nombre" placeholder="Buscar por texto..." />
                </div>

                <!-- FECHAS -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha Desde</label>
                    <input type="date" class="form-control" name="FechaInicio" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha Hasta</label>
                    <input type="date" class="form-control" name="FechaFin" />
                </div>

                <!-- ESTATUS -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Estatus</label>
                    <select class="form-select" name="Estatus">
                        <option value="">-- Todos --</option>
                        <option value="Vigente">Vigente</option>
                        <option value="Obsoleto">Obsoleto</option>
                        <option value="ProximaRevision">Próxima Revisión</option>
                    </select>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="mt-3">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-search"></i> Buscar
                </button>

                <a href="/Reportes/Documentacion" class="btn btn-secondary">
                    <i class="bi bi-x"></i> Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- =================================== -->
<!-- BOTÓN NUEVO DOCUMENTO -->
<!-- =================================== -->
<div class="mb-3">
    <a href="/Reportes/Documentacion?handler=Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Documento
    </a>
</div>

<!-- =================================== -->
<!-- TABLA RESULTADOS -->
<!-- =================================== -->
<div class="card shadow-sm">
    <div class="card-header">
        <strong>Resultados</strong>
    </div>

    <div class="card-body table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Área</th>
                    <th>Tipo</th>
                    <th>Título</th>
                    <th>Versión</th>
                    <th>Fecha Publicación</th>
                    <th>Estatus</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                <!-- POR AHORA VACÍO, SE LLENARÁ CUANDO EL MODELO TENGA DATOS -->
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay resultados.
                        Agrega lógica en tu PageModel para cargar datos.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
