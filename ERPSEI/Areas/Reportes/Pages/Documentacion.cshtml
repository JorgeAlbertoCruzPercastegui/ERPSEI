@page "{handler?}"
@model ERPSEI.Areas.Reportes.Pages.DocumentacionModel

@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using ERPSEI.Data.Entities.Empleados;
@using ERPSEI.Data.Entities.Documentos;
@using ERPSEI.Data.Managers.Empleados;
@using ERPSEI.Data.Managers.Documentos;
@using ERPSEI.Data.Managers;

@inject IViewLocalizer Localizer

@inject IRWCatalogoManager<Area> AreasManager;
@inject IDocumentoManager DocumentoManager
@inject ITipoDocumentoManager TipoDocumentoManager
@inject IEstatusDocumentoManager EstatusDocumentoManager


@{
    ViewData["Title"] = Localizer["Title"];

    IRequestCultureFeature? rqf = Request.HttpContext.Features.Get<IRequestCultureFeature>();
    System.Globalization.CultureInfo culture = rqf != null
        ? rqf.RequestCulture.Culture
        : new System.Globalization.CultureInfo("es-MX");

    string cultureName = culture.Name;

    List<Area> areas = await AreasManager.GetAllAsync();
    List<Documento> documentos = await DocumentoManager.GetAllAsync();
    List<TipoDocumento> tipoDocumentos = await TipoDocumentoManager.GetAllAsync();
    List<EstatusDocumento> estatusDocumento = await EstatusDocumentoManager.GetAllAsync();

    bool puedeTodo = User.Claims.Where(c => c.Type.Equals("PuedeTodo", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeConsultar = User.Claims.Where(c => c.Type.Equals("PuedeConsultar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEditar = User.Claims.Where(c => c.Type.Equals("PuedeEditar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeEliminar = User.Claims.Where(c => c.Type.Equals("PuedeEliminar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
    bool puedeAutorizar = User.Claims.Where(c => c.Type.Equals("PuedeAutorizar", StringComparison.OrdinalIgnoreCase)).FirstOrDefault()?.Value == "1";
}

<h3 class="title mb-3">@ViewData["Title"]</h3>


<!-- --------------------------- -->
<!-- Sección de filtros -------- -->
<div class="accordion shadow mb-5" id="accordionFiltros">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button p-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                <h6>@Localizer["FilterTitle"]</h6>
            </button>
        </h2>

        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionFiltros">
            <div class="accordion-body">
                <form id="filtros" method="post">
                    <div class="row">
                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroTitulo" type="search" asp-for="InputFiltro.Titulo" class="form-control" placeholder="@Localizer["TitleField"]" />
                                <label for="inpFiltroTitulo" asp-for="InputFiltro.Titulo" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroArea" asp-for="InputFiltro.AreaId" class="form-select" placeholder="@Localizer["AreaField"]">
                                    <option value="0">Seleccione...</option>
                                    @{
                                        foreach (var a in areas)
                                        {
                                            <option value="@a.Id">@a.Nombre</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroArea" asp-for="InputFiltro.AreaId" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroTipoDocumento" asp-for="InputFiltro.TipoDocumentoId" class="form-select" placeholder="@Localizer["TipoDocumentoField"]">
                                    <option value="0">Seleccione...</option>
                                    @{
                                        foreach (var t in tipoDocumentos)
                                        {
                                            <option value="@t.Id">@t.Nombre</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroTipoDocumento" asp-for="InputFiltro.TipoDocumentoId" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <select id="selFiltroEstatusDocumento" asp-for="InputFiltro.EstatusDocumentoId" class="form-select" placeholder="@Localizer["EstatusField"]">
                                    <option value="0">Todos</option> 
                                    @{
                                        foreach (var s in estatusDocumento)
                                        {
                                            <option value="@s.Id">@s.Nombre</option>
                                        }
                                    }
                                </select>
                                <label for="selFiltroEstatusDocumento" asp-for="InputFiltro.EstatusDocumentoId" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroPalabraClave" type="search" asp-for="InputFiltro.PalabraClave" class="form-control" placeholder="@Localizer["KeywordField"]" />
                                <label for="inpFiltroPalabraClave" asp-for="InputFiltro.PalabraClave" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroFechaInicio" type="date" asp-for="InputFiltro.FechaCreacionInicio" class="form-control" placeholder="@Localizer["StartDateField"]" />
                                <label for="inpFiltroFechaInicio" asp-for="InputFiltro.FechaCreacionInicio" class="form-label"></label>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-6 col-lg-3">
                            <div class="form-floating mb-3">
                                <input id="inpFiltroFechaFin" type="date" asp-for="InputFiltro.FechaCreacionFin" class="form-control" placeholder="@Localizer["EndDateField"]" />
                                <label for="inpFiltroFechaFin" asp-for="InputFiltro.FechaCreacionFin" class="form-label"></label>
                            </div>
                        </div>

                    </div>
                </form>

                <div class="row text-end">
                    <div class="col-12">
                        <button id="btnBuscar" name="refresh" class="btn btn-primary" onclick="onBuscarClick();">
                            <i class="bi bi-search"></i> @Localizer["SearchButton"]
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- --------------------------- -->
<!-- Sección tabla de resultados -->
<div id="toolbar" class="col-xl-12">
    <button id="btnAgregar" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#dlgDocumentacion"
            onclick="onAgregarClick();">
        <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">@Localizer["AddButton"]</span>
    </button>

    <button id="remove" class="btn btn-danger" disabled>
        <i class="bi bi-trash"></i> <span class="d-none d-sm-inline">@Localizer["DeactivateButton"]</span>
    </button>
</div>

    <!-- --------------------------- -->
    <!-- --------------------------- -->
    <table id="table" class="table-sm"
           data-unique-id="id"
           data-toolbar="#toolbar"
           data-search="true"
           data-show-toggle="true"
           data-show-fullscreen="true"
           data-show-columns="true"
           data-show-columns-toggle-all="true"
           data-show-export="true"
           data-click-to-select="true"
           data-minimum-count-columns="2"
           data-show-pagination-switch="true"
           data-pagination="true"
           data-id-field="id"
           data-page-list="[10, 25, 50, 100, all]"
           data-show-footer="false"
           data-side-pagination="client"
           data-response-handler="responseHandler"
           data-buttons-class="primary"
           data-buttons="additionalButtons"
           data-url="/Reportes/Documentacion/DocumentosList">
        <thead>
            <tr align="center" valign="middle" class="bg-primary bg-opacity-10">
            </tr>
        </thead>
    </table>


<!-- --------------------------- -->
<!-- --------------------------- -->
<!-- --------------------------- -->
<!-- Sección Nuevo/Editar/Ver Registro --- -->

<form id="theForm" method="post" enctype="multipart/form-data">
    <div id="dlgDocumentacion" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        @Html.AntiForgeryToken()
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="dlgDocumentacionTitle" class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body align-items-center">
                    <div class="container-fluid">
                        <div id="saveValidationSummary" class="text-danger mb-3" role="alert"></div>

                        <!-- ID (solo) -->
                        <div class="row">
                            <div class="col-3">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionId" asp-for="InputDocumentos.Id" type="text" class="form-control" />
                                    <label asp-for="InputDocumentos.Id" class="form-label"></label>
                                    <span asp-validation-for="InputDocumentos.Id" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 1 -->
                        <div class="row">

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpDocumentacionArea"
                                            asp-for="InputDocumentos.AreaId"
                                            class="form-select">
                                        <option value="">Seleccione...</option>
                                        @foreach (var area in areas)
                                        {
                                            <option value="@area.Id">@area.Nombre</option>
                                        }
                                    </select>
                                    <label for="inpDocumentacionArea">Área</label>
                                </div>
                                <span asp-validation-for="InputDocumentos.AreaId" class="text-danger"></span>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpDocumentacionTipoDocumento"
                                            asp-for="InputDocumentos.TipoDocumentoId"
                                            class="form-select">
                                        <option value="">Seleccione...</option>
                                        @foreach (var tipoDocumento in tipoDocumentos)
                                        {
                                            <option value="@tipoDocumento.Id">@tipoDocumento.Nombre</option>
                                        }
                                    </select>
                                    <label for="inpDocumentacionTipoDocumento">Tipo Documento</label>
                                </div>
                                <span asp-validation-for="InputDocumentos.TipoDocumentoId" class="text-danger"></span>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionTitulo" asp-for="InputDocumentos.Titulo" type="text" class="form-control" />
                                    <label asp-for="InputDocumentos.Titulo" class="form-label"></label>
                                    <span asp-validation-for="InputDocumentos.Titulo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grupo 2 -->
                        <div class="row">

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionDescripcion" asp-for="InputDocumentos.Descripcion" type="text" class="form-control" placeholder="@Localizer["DescripcionPlaceholder"]" />
                                    <label asp-for="InputDocumentos.Descripcion" class="form-label required"></label>
                                    <span asp-validation-for="InputDocumentos.Descripcion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionCreadoPor" asp-for="InputDocumentos.CreadoPorId" type="text" class="form-control" placeholder="@Localizer["CreadoPorPlaceholder"]" />
                                    <label asp-for="InputDocumentos.CreadoPorId" class="form-label required"></label>
                                    <span asp-validation-for="InputDocumentos.CreadoPorId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionModificadoPor" asp-for="InputDocumentos.ModificadoPorId" type="text" class="form-control" placeholder="@Localizer["ModificadoPorPlaceholder"]" />
                                    <label asp-for="InputDocumentos.ModificadoPorId" class="form-label required"></label>
                                    <span asp-validation-for="InputDocumentos.ModificadoPorId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <select id="inpDocumentacionEstatusDocumento"
                                            asp-for="InputDocumentos.EstatusDocumentoId"
                                            class="form-select">
                                        <option value="">Seleccione...</option>
                                        @foreach (var estatusDoc in estatusDocumento)
                                        {
                                            <option value="@estatusDoc.Id">@estatusDoc.Nombre</option>
                                        }
                                    </select>
                                    <label for="inpDocumentacionEstatusDocumento">Estatus Documento</label>
                                </div>
                                <span asp-validation-for="InputDocumentos.EstatusDocumentoId" class="text-danger"></span>
                            </div>

                            <!--<div class="col-4">
                                <div class="mb-3">
                                    <label for="inpDocumentacionArchivo" class="form-label required"> Archivo del documento</label>
                                    <input id="inpDocumentacionArchivo" asp-for="InputDocumentos.Archivo" type="file" class="form-control" accept=".pdf" />
                                    <span asp-validation-for="InputDocumentos.Archivo" class="text-danger"></span>
                                </div>
                            </div>-->

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionNombreArchivo" asp-for="InputDocumentos.NombreArchivo" type="text" class="form-control" placeholder="@Localizer["NombreArchivoPlaceholder"]" />
                                    <label asp-for="InputDocumentos.NombreArchivo" class="form-label required"></label>
                                    <span asp-validation-for="InputDocumentos.NombreArchivo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionRespoonsable" asp-for="InputDocumentos.Responsable" type="text" class="form-control" placeholder="@Localizer["ResponsablePlaceholder"]" />
                                    <label asp-for="InputDocumentos.Responsable" class="form-label required"></label>
                                    <span asp-validation-for="InputDocumentos.Responsable" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">

                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <input id="inpDocumentacionRutaArchivo" asp-for="InputDocumentos.RutaArchivo" type="text" class="form-control" placeholder="@Localizer["RutaArchivoPlaceholder"]" />
                                <label asp-for="InputDocumentos.RutaArchivo" class="form-label required"></label>
                                <span asp-validation-for="InputDocumentos.RutaArchivo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <input id="inpDocumentacionUbicacion" asp-for="InputDocumentos.Ubicacion" type="text" class="form-control" placeholder="@Localizer["UbicacionPlaceholder"]" />
                                <label asp-for="InputDocumentos.Ubicacion" class="form-label required"></label>
                                <span asp-validation-for="InputDocumentos.Ubicacion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionFechaCreacion"
                                           asp-for="InputDocumentos.FechaCreacion"
                                           type="date"
                                           class="form-control" readonly />
                                    <label asp-for="InputDocumentos.FechaCreacion" class="form-label"></label>
                                    <span asp-validation-for="InputDocumentos.FechaCreacion" class="text-danger"></span>
                                </div>
                            </div>

                         </div>
                        

                        <!-- Grupo 3 -->
                        <div class="row">
                            <div class="col-4">
                                <div class="form-floating mb-3">
                                    <input id="inpDocumentacionFechaModificacion"
                                           asp-for="InputDocumentos.FechaModificacion"
                                           type="date"
                                           class="form-control" readonly />
                                    <label asp-for="InputDocumentos.FechaModificacion" class="form-label"></label>
                                    <span asp-validation-for="InputDocumentos.FechaModificacion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <textarea id="inpDocumentacionObservaciones"
                                          asp-for="InputDocumentos.Observaciones"
                                          class="form-control"
                                          placeholder="Observaciones"
                                          style="height: 160px"></textarea>

                                <label for="inpDocumentacionObservaciones"> Observaciones </label>

                                <span asp-validation-for="InputDocumentos.Observaciones" class="text-danger"></span>
                            </div>
                        </div>

                        </div>
                    </div>
                <div class="modal-footer">
                    <button id="dlgDocumentoBtnCancelar" type="button" class="btn btn-secondary" onclick="onCerrarClick();" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i> @Localizer["CancelButton"]
                    </button>
                    <button id="dlgDocumentoBtnGuardar" type="button" class="btn btn-primary" onclick="onGuardarClick();">
                        <i class="bi bi-floppy"></i> @Localizer["SaveButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.min.css">
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css">
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/js/autocompletar.js"></script>

    <script src="~/lib/bootstrap-table/extensions/export/tableExport.min.js"></script>
    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>
    <script src="~/lib/bootstrap-table/locale/bootstrap-table-es-MX.min.js"></script>
    <script src="~/lib/bootstrap-table/locale/bootstrap-table-en-US.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/bootstrap-table-export.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/xlsx.full.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/exceljs.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/export/FileSaver.min.js"></script>

    <script src="~/../Areas/Reportes/Pages/Documentacion.cshtml.js"></script>

    <script type="text/javascript">
        var cultureName = "@cultureName";
        var btnImportarText = '@Localizer["ImportButtonText"]';
        var btnImportarTitle = '@Localizer["ImportButtonTitle"]';
        var btnVerTitle = '@Localizer["SeeButtonTitle"]';
        var btnEditarTitle = '@Localizer["EditButtonTitle"]';
        var dlgEditarTitle = '@Localizer["EditDialogTitle"]';
        var dlgVerTitle = '@Localizer["SeeDialogTitle"]';
        var dlgNuevoTitle = '@Localizer["NewDialogTitle"]';
        var dlgDeleteTitle = '@Localizer["DeleteOfficeDialogTitle"]';
        var dlgDeleteQuestion = '@Localizer["DeleteOfficeDialogQuestion"]';

        var colIdHeader = '@Localizer["ColIdHeader"]';
        var colTtituloHeader = '@Localizer["ColTituloHeader"]';
        var colAreaHeader = '@Localizer["ColAreaHeader"]';
        var colTipoHeader = '@Localizer["ColTipoHeader"]';
        var colFechaCreacionHeader = '@Localizer["ColFechaCreacionHeader"]';
        var colEstatusHeader = '@Localizer["ColEstatusHeader"]';

        var colAccionesHeader = '@Localizer["ColActionsHeader"]';

        /*Permisos*/
        var puedeTodo = '@puedeTodo' == 'True';
        var puedeConsultar = '@puedeConsultar' == 'True';
        var puedeEditar = '@puedeEditar' == 'True';
        var puedeEliminar = '@puedeEliminar' == 'True';
        var puedeAutorizar = '@puedeAutorizar' == 'True';
    </script>

    <partial name="_ValidationScriptsPartial" />
}
