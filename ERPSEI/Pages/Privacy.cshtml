@page
@using ERPSEI.Pages.Shared;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model PrivacyModel
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["ActivePage"] = _LayoutPages.AvisoPrivacidad;
    ViewData["BodyClass"] = "privacy-page-body";

}

@section Styles {
    <link rel="stylesheet" href="~/css/Privacy.css" />
}

<div class="privacy-page">
    <div class="privacy-card">
        <div class="privacy-header">
            <h1>@Localizer["SecondaryTitle"]</h1>
            <h4>@Localizer["TertiaryTitle"]</h4>
            <hr />
        </div>

        <div class="privacy-image-wrapper">
            <img class="privacyimage" src="@HttpContext.Request.Scheme://@HttpContext.Request.Host/img/policy.jpg" />
        </div>

        <div class="privacy-content">
            <p>
                @Localizer["PrivacyMessage"]
            </p>
        </div>
    </div>
</div>