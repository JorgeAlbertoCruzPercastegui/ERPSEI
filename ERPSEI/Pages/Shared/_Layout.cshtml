@using ERPSEI.Data.Entities.Usuarios
@using Microsoft.AspNetCore.Mvc.Localization
@using ERPSEI.Data.Managers.Usuarios;
@using ERPSEI.Data
@using ERPSEI.Data.Entities.Intranet
@using Microsoft.EntityFrameworkCore

@inject IViewLocalizer Localizer
@inject SignInManager<AppUser> SignInManager
@inject IAccesoModuloManager AccesosModulosManager;
@inject AppRoleManager RolesManager;
@inject AppUserManager UsuariosManager;
@inject IModuloManager ModulosManager;
@inject ApplicationDbContext Db

@{
    AppUser? usr = await UsuariosManager.FindByNameAsync(User.Identity?.Name ?? string.Empty);
    IList<string> rolesUsuario = usr != null ? await UsuariosManager.GetRolesAsync(usr) : new List<string>();
    List<AccesoModulo> accesos = new List<AccesoModulo>();

    foreach (string rol in rolesUsuario)
    {
        AppRole? foundRole = await RolesManager.GetByNameAsync(rol);
        accesos.AddRange(await AccesosModulosManager.GetByRolIdAsync(foundRole?.Id ?? string.Empty));
    }

    bool accedeCatalogos = false,
    accedeERP = false,
    accedeReportes = false,
    tieneCatalogosRH = false,
    tieneERPRH = false,
    tieneReportesRH = false,
    tieneCatalogosEmpresas = false,
    tieneERPEmpresas = false,
    tieneReportesEmpresas = false;

    // =========================================
    // HEADER DINÁMICO
    // =========================================

    var now = DateTime.Now;

    var headerImg = await Db.HeaderImagenes
        .AsNoTracking()
        .Where(x => x.Activo &&
            (
                x.EsPermanente ||
                (
                    (!x.VigenciaInicio.HasValue || x.VigenciaInicio.Value <= now) &&
                    (!x.VigenciaFin.HasValue || x.VigenciaFin.Value >= now)
                )
            )
        )
        .OrderBy(x => x.Orden)
        .ThenByDescending(x => x.FechaCreacion)
        .FirstOrDefaultAsync();

    string headerBg = headerImg?.RutaArchivo ?? "";

    // =========================================
    // CUMPLEAÑOS DEL MES
    // =========================================

    var hoyCumple = DateTime.Today;
    int mesActualCumple = hoyCumple.Month;
    int diaActualCumple = hoyCumple.Day;

    var cumpleaniosMes = await Db.Empleados
     .AsNoTracking()
     .Where(e => e.FechaNacimiento.Month == mesActualCumple)
     .Select(e => new
     {
         NombreCompleto = (e.Nombre ?? "") + " " + (e.ApellidoPaterno ?? "") + " " + (e.ApellidoMaterno ?? ""),
         Dia = e.FechaNacimiento.Day,
         Puesto = e.Puesto != null ? e.Puesto.Nombre : ""
     })
     .OrderBy(e => e.Dia)
     .ToListAsync();

    string nombreMesActual = hoyCumple.ToString("MMMM", new System.Globalization.CultureInfo("es-MX"));

    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool esPaginaInicio = paginaActual.Equals("/Index", StringComparison.OrdinalIgnoreCase);

    if (accesos.Count >= 0)
    {
        tieneCatalogosRH = accesos.FindAll(m =>
            (m.Modulo?.NombreNormalizado == "gestiondetalento" ||
            m.Modulo?.NombreNormalizado == "usuarios" ||
            m.Modulo?.NombreNormalizado == "puestos" ||
            m.Modulo?.NombreNormalizado == "areas" ||
            m.Modulo?.NombreNormalizado == "subareas" ||
            m.Modulo?.NombreNormalizado == "oficinas" ||
            m.Modulo?.NombreNormalizado == "roles") &&
            (m.PuedeTodo == 1 ||
            m.PuedeConsultar == 1 ||
            m.PuedeEditar == 1 ||
            m.PuedeEliminar == 1 ||
            m.PuedeAutorizar == 1)
        ).Count >= 1;

        tieneERPRH = accesos.FindAll(m =>
            (m.Modulo?.NombreNormalizado == "vacaciones" ||
            m.Modulo?.NombreNormalizado == "incapacidades" ||
            m.Modulo?.NombreNormalizado == "permisos" ||
            m.Modulo?.NombreNormalizado == "activosfijos" ||
            m.Modulo?.NombreNormalizado == "generadorContrato") &&
            (m.PuedeTodo == 1 ||
            m.PuedeConsultar == 1 ||
            m.PuedeEditar == 1 ||
            m.PuedeEliminar == 1 ||
            m.PuedeAutorizar == 1)
        ).Count >= 1;

        tieneReportesRH = accesos.FindAll(m =>
            (m.Modulo?.NombreNormalizado == "organigrama" ||
            m.Modulo?.NombreNormalizado == "asistencia" || m.Modulo?.NombreNormalizado == "sistemadocumentalcorporativo") &&
            (m.PuedeTodo == 1 ||
            m.PuedeConsultar == 1 ||
            m.PuedeEditar == 1 ||
            m.PuedeEliminar == 1 ||
            m.PuedeAutorizar == 1)
        ).Count >= 1;

        tieneCatalogosEmpresas = accesos.FindAll(m =>
            (m.Modulo?.NombreNormalizado == "empresas" ||
            m.Modulo?.NombreNormalizado == "origenes" ||
            m.Modulo?.NombreNormalizado == "niveles" ||
            m.Modulo?.NombreNormalizado == "perfiles" ||
            m.Modulo?.NombreNormalizado == "cuentasContables" ||
            m.Modulo?.NombreNormalizado == "bancos") &&
            (m.PuedeTodo == 1 ||
            m.PuedeConsultar == 1 ||
            m.PuedeEditar == 1 ||
            m.PuedeEliminar == 1 ||
            m.PuedeAutorizar == 1)
        ).Count >= 1;

        tieneERPEmpresas = accesos.FindAll(m =>
            (m.Modulo?.NombreNormalizado == "prefacturas" ||
            m.Modulo?.NombreNormalizado == "administradordecomprobantes" ||
            m.Modulo?.NombreNormalizado == "conciliaciones") &&
            (m.PuedeTodo == 1 ||
            m.PuedeConsultar == 1 ||
            m.PuedeEditar == 1 ||
            m.PuedeEliminar == 1 ||
            m.PuedeAutorizar == 1)
        ).Count >= 1;

        tieneReportesEmpresas = accesos.FindAll(m =>
            (
                m.Modulo?.NombreNormalizado == "facturacion" ||
                m.Modulo?.NombreNormalizado == "convertidorBancario" ||
                m.Modulo?.NombreNormalizado == "generadorContrato"
            )
        ).Count >= 1;

        accedeCatalogos = tieneCatalogosRH || tieneCatalogosEmpresas;
        accedeERP = tieneERPRH || tieneERPEmpresas;
        accedeReportes = tieneReportesRH || tieneReportesEmpresas;
    }

    string classDropdownCatalogos = string.Empty, classDivCatalogos = string.Empty;
    string classDropdownERP = string.Empty, classDivERP = string.Empty;
    string classDropdownReportes = string.Empty, classDivReportes = string.Empty;

    if (tieneCatalogosRH && tieneCatalogosEmpresas)
    {
        classDropdownCatalogos = "dropdown-dynamic-width-two-columns";
        classDivCatalogos = "col-sm-12 col-md-12 col-lg-6 mb-3 mb-lg-0";
    }
    else if (tieneCatalogosRH || tieneCatalogosEmpresas)
    {
        classDropdownCatalogos = "dropdown-dynamic-width-one-column";
        classDivCatalogos = "col-12 mb-3 mb-lg-0";
    }

    if (tieneERPRH && tieneERPEmpresas)
    {
        classDropdownERP = "dropdown-dynamic-width-two-columns";
        classDivERP = "col-sm-12 col-md-12 col-lg-6 mb-3 mb-lg-0";
    }
    else if (tieneERPRH || tieneERPEmpresas)
    {
        classDropdownERP = "dropdown-dynamic-width-one-column";
        classDivERP = "col-12 mb-3 mb-lg-0";
    }

    if (tieneReportesRH && tieneReportesEmpresas)
    {
        classDropdownReportes = "dropdown-dynamic-width-two-columns";
        classDivReportes = "col-sm-12 col-md-12 col-lg-6 mb-3 mb-lg-0";
    }
    else if (tieneReportesRH || tieneReportesEmpresas)
    {
        classDropdownReportes = "dropdown-dynamic-width-one-column";
        classDivReportes = "col-12 mb-3 mb-lg-0";
    }

    Dictionary<string, bool> permisos = new Dictionary<string, bool>();

    foreach (Modulo m in await ModulosManager.GetAllAsync())
    {
        List<AccesoModulo> accesosEncontrados = accesos.Where(a => a.Modulo?.NombreNormalizado == m.NombreNormalizado).ToList();

        bool puedeTodo = accesosEncontrados.Where(a => a.PuedeTodo == 1).FirstOrDefault()?.PuedeTodo == 1;
        bool puedeConsultar = accesosEncontrados.Where(a => a.PuedeConsultar == 1).FirstOrDefault()?.PuedeConsultar == 1;
        bool puedeEditar = accesosEncontrados.Where(a => a.PuedeEditar == 1).FirstOrDefault()?.PuedeEditar == 1;
        bool puedeEliminar = accesosEncontrados.Where(a => a.PuedeEliminar == 1).FirstOrDefault()?.PuedeEliminar == 1;
        bool puedeAutorizar = accesosEncontrados.Where(a => a.PuedeAutorizar == 1).FirstOrDefault()?.PuedeAutorizar == 1;

        permisos.Add(m.NombreNormalizado, puedeTodo || puedeConsultar || puedeEditar || puedeEliminar || puedeAutorizar);
    }

    if (!permisos.ContainsKey("generadorContrato"))
    {
        permisos["generadorContrato"] = false;
    }

    if (!permisos.ContainsKey("banners"))
    {
        permisos["banners"] = false;
    }

}

<!DOCTYPE html>
<html lang="es-mx">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERPSEI</title>

    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Password-rules.css" />
    <link rel="stylesheet" href="~/css/SpaceMain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SpaceMain.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Cumpleanios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERPSEI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light header-bg shadow-none border-0"
             style="@(string.IsNullOrWhiteSpace(headerBg) ? "" : $"background-image:url('{headerBg}')")">

            <div class="container header-bg-inner">
                <a class="navbar-brand d-flex flex-column align-items-start" asp-area="" asp-page="/Index">
                    <img class="brandimage" src="@Context.Request.Scheme://@Context.Request.Host/img/brand_dark.png" />
                </a>

                <button class="navbar-toggler px-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarExample3"
                        aria-controls="navbarExample3" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="navbarExample3">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link @_LayoutPages.InicioNavClass(ViewContext)" asp-area="" asp-page="/Index">
                                    <i class="bi bi-house-door-fill"></i> @Localizer["HomeMenu"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @_LayoutPages.AvisoPrivacidadNavClass(ViewContext)" asp-area="" asp-page="/Privacy">
                                    <i class="bi bi-shield-fill-check"></i> @Localizer["PrivacyMenu"]
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="topbar-links d-flex align-items-center justify-content-between py-1">
                <div class="small text-muted d-flex align-items-center gap-2">
                    Hola, <b>@(usr?.UserName ?? User.Identity?.Name)</b>
                </div>

                <div class="quick-nav-wrap position-relative">
                    <button class="quick-nav-toggle d-lg-none" type="button" aria-expanded="false" aria-controls="quickNavMenu">
                        ☰
                    </button>

                    <nav id="quickNavMenu" class="quick-nav align-items-center gap-3">

                        <a class="quick-link" asp-area="" asp-page="">Mi Espacio</a>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Biblioteca Corporativa</a>
                            <div class="quick-dd-menu">
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Manuales</a>
                                <a class="quick-dd-item" asp-area="Reportes" asp-page="/Documentacion">Políticas</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Reglamentos</a>
                            </div>
                        </div>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Incidencias</a>
                            <div class="quick-dd-menu">
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Permisos por enfermedad</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Incapacidades</a>
                                <a class="quick-dd-item" asp-area="ERP" asp-page="/Vacaciones">Vacaciones</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Retardos</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Home Office</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Ausencias justificadas</a>
                            </div>
                        </div>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Workspace Corporativo</a>
                            <div class="quick-dd-menu">
                                <a class="quick-dd-item" href="https://time.cybertradeinternational.mx/" target="_blank" rel="noopener">Time</a>
                                <a class="quick-dd-item" href="https://seiconsulting.iqualabi.com/" target="_blank" rel="noopener">Kyndom Space</a>
                                <a class="quick-dd-item" href="https://projectseiconsulting.iqualabi.com/" target="_blank" rel="noopener">Kyndom Project</a>
                                <a class="quick-dd-item" href="" target="_blank" rel="noopener">Friday</a>
                            </div>
                        </div>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Gestión Corporativa</a>
                            <div class="quick-dd-menu">
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Empresas">Empresas</a>
                                <a class="quick-dd-item" asp-area="ERP" asp-page="/ActivosFijos">Activos fijos</a>
                            </div>
                        </div>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Comunidad</a>
                            <div class="quick-dd-menu">
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Encuestas</a>
                                <a class="quick-dd-item" asp-area="" asp-page="/Building">Eventos</a>
                            </div>
                        </div>

                        <div class="quick-dd">
                            <a class="quick-link quick-dd-toggle" href="#" onclick="return false;">Recursos Humanos</a>
                            <div class="quick-dd-menu quick-dd-menu-wide">
                                @if (permisos["banners"])
                                {
                                    <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Banners">Banners</a>
                                    <a class="quick-dd-item" asp-area="Catalogos" asp-page="/HeaderImagenes">Imágenes Header</a>
                                }
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/GestionDeTalento">Gestión De Talento</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Usuarios">Usuarios</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Roles">Roles</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Puestos">Puestos</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Areas">Áreas</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Subareas">Subáreas</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Oficinas">Oficinas</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Origenes">Orígenes</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Niveles">Niveles</a>
                                <a class="quick-dd-item" asp-area="Catalogos" asp-page="/Perfiles">Perfiles</a>
                            </div>
                        </div>

                    </nav>
                </div>
            </div>
        }

        <br>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (SignInManager.IsSignedIn(User) && esPaginaInicio && cumpleaniosMes.Any())
    {
        <div class="birthday-wrapper">
            <div class="birthday-card shadow-sm">
                <div class="birthday-header">
                    <div class="birthday-title-wrap">
                        <span class="birthday-icon">🎉</span>
                        <div>
                            <div class="birthday-title">Cumpleaños del mes</div>
                            <div class="birthday-subtitle">@nombreMesActual</div>
                        </div>
                    </div>
                </div>

                <div class="birthday-body">
                    @{
                        int tamGrupo = 4;
                        int total = cumpleaniosMes.Count;
                        int totalColumnas = (int)Math.Ceiling(total / (double)tamGrupo);
                    }

                    <div class="birthday-columns columns-@totalColumnas">
                        @for (int c = 0; c < totalColumnas; c++)
                        {
                            var grupo = cumpleaniosMes.Skip(c * tamGrupo).Take(tamGrupo).ToList();

                            <div class="birthday-column">
                                @foreach (var item in grupo)
                                {
                                    string estadoClase = item.Dia == diaActualCumple
                                    ? "birthday-hoy"
                                    : item.Dia < diaActualCumple
                                    ? "birthday-pasado"
                                    : "birthday-proximo";

                                    <div class="birthday-item @estadoClase">
                                        <div class="birthday-day">@item.Dia</div>

                                        <div class="birthday-info">
                                            <div class="birthday-name">@item.NombreCompleto</div>

                                            @if (!string.IsNullOrWhiteSpace(item.Puesto))
                                            {
                                                <div class="birthday-role">@item.Puesto</div>
                                            }
                                        </div>

                                        <div class="birthday-badge">
                                            @if (item.Dia == diaActualCumple)
                                            {
                                                <span>Hoy 🎂</span>
                                            }
                                            else if (item.Dia < diaActualCumple)
                                            {
                                                <span>Pasó</span>
                                            }
                                            else
                                            {
                                                <span>Próximo</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="float-start">
                &copy; @DateTime.Now.Year - ERPSEI - <a asp-area="" asp-page="/Privacy">@Localizer["PrivacyMenu"]</a>
            </div>
            <div class="float-end d-none d-sm-inline-block d-md-inline-block d-lg-inline-block">
                @Localizer["RightFooter"]
            </div>
        </div>
    </footer>

    <script src="@Context.Request.Scheme://@Context.Request.Host/lib/jquery/dist/jquery.min.js"></script>
    <script src="@Context.Request.Scheme://@Context.Request.Host/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Context.Request.Scheme://@Context.Request.Host/js/Loading.js"></script>
    <script src="@Context.Request.Scheme://@Context.Request.Host/js/MessageDialog.js"></script>
    <script src="@Context.Request.Scheme://@Context.Request.Host/js/Utilities.js"></script>
    <script src="@Context.Request.Scheme://@Context.Request.Host/js/site.js" asp-append-version="true"></script>

    <script type="text/javascript">
        function OnSubmenuClick() {
            this.event.stopPropagation();
            this.event.preventDefault();
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.querySelector(".quick-nav-toggle");
            const menu = document.getElementById("quickNavMenu");

            if (!btn || !menu) return;

            const isMobile = () => window.matchMedia("(max-width: 991.98px)").matches;

            function closeMenu() {
                menu.classList.remove("is-open");
                btn.setAttribute("aria-expanded", "false");
                if (isMobile()) menu.style.display = "none";
                document.querySelectorAll(".quick-dd.open").forEach(x => x.classList.remove("open"));
            }

            function openMenu() {
                menu.classList.add("is-open");
                btn.setAttribute("aria-expanded", "true");
                if (isMobile()) menu.style.display = "flex";
            }

            function toggleMenu(e) {
                e.preventDefault();
                e.stopPropagation();
                if (!isMobile()) return;
                menu.classList.contains("is-open") ? closeMenu() : openMenu();
            }

            if (isMobile()) closeMenu();

            btn.addEventListener("click", toggleMenu);

            document.addEventListener("click", function (e) {
                if (!isMobile()) return;
                if (!menu.contains(e.target) && !btn.contains(e.target)) closeMenu();
            });

            document.querySelectorAll(".quick-dd-toggle").forEach(t => {
                t.addEventListener("click", function (e) {
                    if (!isMobile()) return;

                    e.preventDefault();
                    e.stopPropagation();

                    const parent = this.closest(".quick-dd");
                    if (!parent) return;

                    document.querySelectorAll(".quick-dd.open").forEach(x => {
                        if (x !== parent) x.classList.remove("open");
                    });

                    parent.classList.toggle("open");
                });
            });

            window.addEventListener("resize", function () {
                if (!isMobile()) {
                    menu.style.display = "";
                    menu.classList.remove("is-open");
                    btn.setAttribute("aria-expanded", "false");
                    document.querySelectorAll(".quick-dd.open").forEach(x => x.classList.remove("open"));
                } else {
                    closeMenu();
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>