@page
@using ERPSEI.Pages.Shared;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IndexModel
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["ActivePage"] = _LayoutPages.Inicio;

    var banners = Model.BannersHome ?? new List<ERPSEI.Data.Entities.Intranet.Banner>();
}

<div class="text-center container-fluid">

    @if (banners.Any())
    {
        <div id="bannerERP" class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5000">

            <div class="carousel-inner rounded shadow">

                @for (int i = 0; i < banners.Count; i++)
                {
                    var b = banners[i];
                    var ext = System.IO.Path.GetExtension(b.RutaArchivo)?.ToLowerInvariant();
                    var esVideo = ext == ".mp4" || ext == ".webm" || ext == ".mov";

                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        @if (esVideo)
                        {
                            <video class="d-block w-100 banner-img banner-video"
                                   muted
                                   playsinline
                                   preload="auto">
                                <source src="@b.RutaArchivo"
                                        type="video/@(ext == ".mov" ? "quicktime" : ext.Replace(".", ""))" />
                            </video>
                        }
                        else
                        {
                            <img src="@b.RutaArchivo"
                                 class="d-block w-100 banner-img"
                                 alt="banner">
                        }
                    </div>
                }

            </div>
        </div>
    }
    else
    {
        <!-- fallback si no hay banners -->
        <div class="carousel-inner rounded shadow">
            <div class="carousel-item active">
                <img src="/img/portada1.jpg" class="d-block w-100 banner-img">
            </div>
        </div>
    }

   
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselElement = document.getElementById("bannerERP");

            if (!carouselElement) return;

            const carousel = bootstrap.Carousel.getOrCreateInstance(carouselElement, {
                interval: 5000,
                ride: false
            });

            function detenerVideos() {
                carouselElement.querySelectorAll("video").forEach(video => {
                    video.pause();
                    video.currentTime = 0;
                });
            }

            function reproducirSiEsVideoActivo() {
                const activeItem = carouselElement.querySelector(".carousel-item.active");
                if (!activeItem) return;

                const video = activeItem.querySelector("video");

                if (video) {
                    carousel.pause();
                    video.currentTime = 0;

                    video.play().catch(() => {
                        carousel.next();
                    });

                        video.onended = function () {
                        const totalItems = carouselElement.querySelectorAll(".carousel-item").length;

                        // Si solo existe un banner/video
                        if (totalItems === 1) {

                            video.currentTime = 0;
                            video.play();

                        } else {

                            carousel.next();

                        }
                    };
                } else {
                    carousel.cycle();
                }
            }

            carouselElement.addEventListener("slide.bs.carousel", function () {
                detenerVideos();
            });

            carouselElement.addEventListener("slid.bs.carousel", function () {
                reproducirSiEsVideoActivo();
            });

            reproducirSiEsVideoActivo();
        });
    </script>
}